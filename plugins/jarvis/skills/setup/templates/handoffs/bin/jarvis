#!/usr/bin/env bash
# jarvis — the routine steps of the Jarvis workflow, one command each, so the
# coordinator spends its turns on judgement instead of bookkeeping.
#
#   jarvis start                       claim this terminal as Jarvis in OPEN.md, then status
#   jarvis status                      band, workers, new handoffs, git — one short screen
#   jarvis spawn <brief.md> [--after <partial-handoff>] [--force]
#                                      lint, enforce the band and the Claude cap, spawn, record
#   jarvis merge <handoff.md> --check  file list vs git status, diff stat; changes nothing
#   jarvis merge <handoff.md> [-m <msg>] [--outcome <o>] [--no-push] [--keep-open] [--force]
#                                      commit exactly the listed files + the handoff move,
#                                      push, close the worker, update OPEN.md, stop what the
#                                      worker left running
#   jarvis leftovers [<brief.md>] [--stop [--force]]
#                                      processes workers started that outlived them (their
#                                      scratch folder on the command line); --stop ends them
#   jarvis leftovers --mine [--stop]   (a worker) what this session started that's still running
#   jarvis watch [--once]             run in its own terminal (no model): wakes Jarvis when a
#                                      handoff lands or a worker is limited, waiting at a prompt
#                                      or frozen; /clears it first after a long idle
#   jarvis band                        the usage band from the latest statusline reading
#   jarvis usage [--days N | --since DATE]
#                                      coordinating vs building, from local transcripts
#   jarvis hook prompt                 UserPromptSubmit guard (from .claude/settings.json)
#   jarvis statusline                  statusline tap: saves the 5-hour reading, then runs yours
#
# Settings live in handoffs/jarvis.conf. Works on the stock macOS bash (3.2).
# jq is needed for spawn, the hooks and the band; everything fails open without it.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$ROOT" || exit 0
H=handoffs
OPEN="$H/OPEN.md"
STATE="$H/.jarvis"
BIN="$H/bin"

JARVIS_MAX_CLAUDE=3      # Claude sessions at once, Jarvis included; Codex/OpenCode don't count
JARVIS_AMBER=50          # 5-hour % that turns the band amber
JARVIS_RED=75            # 5-hour % that turns it red
JARVIS_IDLE_MIN=55       # minutes idle after which a big context is cheaper to clear than reload
JARVIS_GUARD_TOKENS=100000
JARVIS_WATCH_SEC=60
JARVIS_STALL_MIN=15      # a worker screen unchanged this long, with no handoff, wakes Jarvis
JARVIS_PUSH=1
JARVIS_REAP=1            # merge stops what the closed worker left running (0 = only list it)
# shellcheck disable=SC1090
[ -f "$H/jarvis.conf" ] && . "$H/jarvis.conf"
WS="${SUPERSET_WORKSPACE_ID:-}"
PROJ=$(printf '%s' "$ROOT" | sed 's#[^A-Za-z0-9]#-#g')   # Claude Code's name for this checkout
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

LIMIT_RE="(usage|rate|session|weekly|daily|hourly|5-hour) limit (was |has been )?(reached|exceeded|hit)|(hit|reached|exceeded) (your|the) [a-z0-9 -]*limit|limit reached|quota (was |has been )?(exceeded|exhausted)|out of credits|too many requests"
# A worker sitting at a trust or approval prompt does nothing until someone answers it.
PROMPT_RE="trust (this|the files in this) folder|do you trust|allow codex to work in this folder|press enter to confirm|would you like to (run|make|apply)|do you want to (proceed|make this edit|create|run|allow)|allow (this|once)|\\(y/n\\)|\\[y/n\\]"

die() { echo "jarvis: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now() { date +%s; }
short() { printf '%s' "$1" | cut -c1-8; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# ---------------------------------------------------------------- OPEN.md

jarvis_terminal() {
  sed -n 's/^Jarvis session:[[:space:]]*//p' "$OPEN" 2>/dev/null | head -n 1 | awk '{print $1}' | grep -v '^<' || true
}

# "- <when> · <agent>/<model> <effort> · term <id> · <brief> · <slug>"
running_lines() {
  awk '/^## /{on = ($0 ~ /^## Running workers/); next} on && /^- /' "$OPEN" 2>/dev/null
}

claude_sessions() { # Jarvis plus every running Claude worker
  echo $(( $(running_lines | grep -c '· claude/') + 1 ))
}

open_add_running() { # $1 = line
  local tmp; tmp=$(mktemp) || return 1
  awk -v line="$1" '{print} /^## Running workers/ && !done {print line; done=1}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_drop() { # drop list items that mention $1
  local tmp; tmp=$(mktemp) || return 1
  awk -v k="$1" '!(/^- / && index($0, k))' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_set() { # $1 = "Jarvis session" | "Usage band", $2 = value
  local tmp; tmp=$(mktemp) || return 1
  awk -v k="$1" -v v="$2" 'index($0, k ":") == 1 {print k ": " v; next} {print}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

field() { # $1 = key, $2 = file: "key: value" from a brief header or handoff
  sed -n "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1
}

# ---------------------------------------------------------------- band

# Prints "<band>\t<one-line explanation>". The reading comes from `jarvis statusline`,
# which Claude Code feeds its own 5-hour and 7-day rate-limit numbers.
band() {
  local f="$STATE/usage.json"
  have jq || { printf 'unknown\tjq not installed\n'; return; }
  [ -s "$f" ] || { printf 'unknown\tno statusline reading yet — check `/usage` and write the band by hand\n'; return; }
  jq -r --argjson now "$(now)" --argjson amber "$JARVIS_AMBER" --argjson red "$JARVIS_RED" '
    def hm: (. / 60 | floor) as $m | "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m";
    (.five_hour.used_percentage // null) as $u
    | (.five_hour.resets_at // null) as $r
    | (.seven_day.used_percentage // null) as $w
    | (($now - .ts) / 60 | floor) as $age
    | if $u == null or $r == null then "unknown\tthe reading has no 5-hour window"
      elif $now >= $r then "green\tthe 5-hour window has reset since the last reading (\($age) min ago)"
      else
        (18000 - ($r - $now)) as $el
        | (if $el >= 1800 then ($u * 18000 / $el) else null end) as $pace
        | (if $u >= $red or ($w // 0) >= 95 then "red"
           elif $u >= $amber or ($pace // 0) >= 100 or ($w // 0) >= 80 then "amber"
           else "green" end) as $b
        | "\($b)\t5h \($u | round)% used, \($el | hm) into the window"
          + (if $pace then ", on pace for \($pace | round)%" else "" end)
          + (if $w then " · 7d \($w | round)%" else "" end)
          + (if $age > 20 then " · reading \($age) min old" else "" end)
      end' "$f" 2>/dev/null || printf 'unknown\tunreadable %s\n' "$f"
}

cmd_band() { band | tr '\t' ' '; }

# ---------------------------------------------------------------- start / status

cmd_start() {
  local me old
  me="${SUPERSET_TERMINAL_ID:-}"
  [ -f "$OPEN" ] || die "no $OPEN — run jarvis:setup first"
  [ -n "$me" ] || die "SUPERSET_TERMINAL_ID not set — run Jarvis in a Superset terminal"
  old=$(jarvis_terminal)
  if [ -n "$old" ] && [ "$old" != "$me" ] && [ "${1:-}" != --force ] && [ -n "$WS" ] \
     && superset terminals list --workspace "$WS" --json 2>/dev/null | grep -q "$old"; then
    die "another Jarvis ($old) is still open — ask the user, then: jarvis start --force"
  fi
  open_set "Jarvis session" "$me"
  mkdir -p "$STATE"
  cmd_status
}

cmd_status() {
  local b line id brief ho ids="" n=0 changed claimed unclaimed
  [ -f "$OPEN" ] || die "no $OPEN — run jarvis:setup first"

  b=$(band)
  printf 'band: %s\n' "$(printf '%s' "$b" | tr '\t' ' ' | sed 's/ /: /')"
  case "$(printf '%s' "$b" | cut -f1)" in
    green|amber|red) open_set "Usage band" "$(printf '%s' "$b" | cut -f1) ($(printf '%s' "$b" | cut -f2 | cut -d, -f1), $(date +%H:%M))" ;;
  esac

  printf 'claude sessions: %s of %s (Jarvis included)\n' "$(claude_sessions)" "$JARVIS_MAX_CLAUDE"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    n=$((n + 1))
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    ho=""
    [ -n "$brief" ] && ho=$(grep -l "^brief:[[:space:]]*$brief" "$H"/*.md 2>/dev/null | head -n 1)
    printf '  %s %s %s' "$(short "$id")" "$(printf '%s' "$line" | awk -F' · ' '{print $2}')" "$(basename "${brief:-?}" .md)"
    if [ -n "$ho" ]; then printf '  → %s (%s)\n' "$ho" "$(field status "$ho")"; else echo; fi
    [ -n "$id" ] && [ -z "$ho" ] && ids="$ids $id"
  done <<EOF
$(running_lines)
EOF
  [ $n = 0 ] && echo "  no workers running"

  if [ -n "$ids" ]; then
    echo "workers still at it:"
    if [ -x "$BIN/jev.sh" ]; then
      # shellcheck disable=SC2086
      "$BIN/jev.sh" triage $ids 2>/dev/null | sed 's/^/  /'
    else
      for id in $ids; do
        printf '  %s\n' "$(short "$id")"
        superset terminals read --workspace "$WS" --terminal "$id" --max-lines 40 --json 2>/dev/null \
          | { have jq && jq -r '.text // empty' || cat; } | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -n 4 | sed 's/^/      /'
      done
    fi
  fi

  # handoffs on disk that no running worker accounts for
  for ho in "$H"/*.md; do
    [ -f "$ho" ] || continue
    case "$(basename "$ho")" in OPEN.md|TEMPLATE.md|JARVIS.md) continue ;; esac
    brief=$(field brief "$ho")
    running_lines | grep -q "${brief:-@@none@@}" && continue
    echo "handoff not tied to a running worker: $ho ($(field status "$ho"))"
  done

  changed=$(git status --porcelain -uall 2>/dev/null | grep -v " $H/" | wc -l | tr -d ' ')
  claimed=0
  for ho in "$H"/*.md; do [ -f "$ho" ] && claimed=$((claimed + $(listed_files "$ho" | wc -l))); done
  unclaimed=$((changed - claimed)); [ $unclaimed -lt 0 ] && unclaimed=0
  printf 'git: %s changed outside handoffs/ · about %s not in any handoff yet · %s\n' \
    "$changed" "$unclaimed" "$(git log -1 --format='last commit %h %ar' 2>/dev/null)"
  n=$(awk '/^## /{on = ($0 ~ /^## To-do/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  q=$(awk '/^## /{on = ($0 ~ /^## Questions for the user/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  printf 'OPEN.md: %s question(s) for the user · %s to-do\n' "$q" "$n"
  cmd_leftovers --quiet
}

# ---------------------------------------------------------------- spawn

# Codex trusts folders one path at a time and asks "Trust this folder?" on its first
# run in each one; a worker spawned into that prompt sits there until someone answers.
# Record the answer up front, as pressing Yes would. An existing entry is left alone.
codex_trust() {
  local cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"
  case "$ROOT" in *\"*|*\\*) return 0 ;; esac
  grep -qF "[projects.\"$ROOT\"]" "$cfg" 2>/dev/null && return 0
  mkdir -p "$(dirname "$cfg")" \
    && printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$ROOT" >> "$cfg" \
    && echo "trusted $ROOT in $cfg, so Codex starts without its folder prompt"
}

cmd_spawn() {
  local brief="" after="" force=0 worker model effort tier prompt out id b cap_now
  while [ $# -gt 0 ]; do
    case "$1" in
      --after) after="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      *) brief="$1"; shift ;;
    esac
  done
  [ -f "$brief" ] || die "usage: jarvis spawn <handoffs/briefs/file.md> [--after <partial handoff>] [--force]"
  have jq || die "jq is needed to read the spawn result"
  [ -n "$WS" ] || die "SUPERSET_WORKSPACE_ID not set"

  worker=$(field worker "$brief" | awk '{print $1}')
  model=$(field model "$brief" | awk '{print $1}')
  effort=$(field effort "$brief" | awk '{print $1}')
  case "$worker" in claude|codex|opencode) ;; *) die "brief header needs worker: claude | codex | opencode" ;; esac
  case "$model" in \<*|"") [ "$worker" = opencode ] || die "brief header needs a model" ;; esac
  case "$model" in fable) tier=top ;; claude-opus-5-5|opus) tier=workhorse ;; *) tier=other ;; esac

  if [ -x "$BIN/jev.sh" ]; then
    "$BIN/jev.sh" brief "$brief" || [ $force = 1 ] || die "sharpen the brief (or --force if the lint is wrong)"
  fi

  b=$(band | cut -f1)
  if [ "$worker" = claude ] && [ $force = 0 ]; then
    [ "$b" = red ] && [ "$tier" != other ] && die "band is red: new $tier-tier work goes to Codex (gpt-6-astra / gpt-5.6-sol). Edit the header, or --force"
    [ "$b" = amber ] && [ "$model" = fable ] && die "band is amber: fable is off for workers. Use model: claude-opus-5-5 (amber band; fable-tier task), or --force"
    cap_now=$(claude_sessions)
    if [ "$cap_now" -ge "$JARVIS_MAX_CLAUDE" ]; then
      die "Claude cap reached ($cap_now of $JARVIS_MAX_CLAUDE, Jarvis included). Queue it under To-do in OPEN.md, route it to OpenCode/Codex, or --force"
    fi
  fi

  [ "$worker" = codex ] && codex_trust

  prompt="You are a Jarvis worker. Read AGENTS.md, then do the task in $brief."
  [ -n "$after" ] && prompt="$prompt $after records what is already done — start from there."
  [ "$worker" = opencode ] && prompt="$prompt Touch only the files it lists. Never run git commands that change state."
  prompt="$prompt Put every question in one first handoff (status: blocked); once answered, finish this brief and hand off."

  set -- --workspace "$WS" --agent "$worker" --prompt "$prompt" --json
  case "$worker" in
    opencode) [ -n "$model" ] && case "$model" in \<*) ;; *) set -- "$@" --model "$model" ;; esac ;;
    *) set -- "$@" --model "$model"; [ -n "$effort" ] && set -- "$@" --effort "$effort" ;;
  esac
  out=$(superset agents create "$@" 2>&1) || die "spawn failed (a failed Claude spawn means the red band): $out"
  id=$(printf '%s' "$out" | jq -r '.sessionId // empty' 2>/dev/null)
  [ -n "$id" ] || die "no sessionId in: $out"

  sed -i.bak -E "s/^started:.*/started: $(date '+%Y-%m-%d %H:%M') · terminal: $id/" "$brief" && rm -f "$brief.bak"
  open_add_running "- $(date '+%Y-%m-%d %H:%M') · $worker/${model:-default}${effort:+ $effort} · term $id · $brief"
  echo "spawned $(short "$id") $worker/${model:-default}${effort:+ $effort} ← $brief (Claude sessions $(claude_sessions) of $JARVIS_MAX_CLAUDE)"
}

# ---------------------------------------------------------------- leftovers

# A worker's Bash commands run in process groups of their own, away from its
# terminal's, so closing the terminal doesn't stop what they started; and a
# browser whose script crashed is adopted by launchd and runs until someone
# kills it (two did, for ten days). Claude Code gives each session a scratch
# folder, /tmp/claude-<uid>/<project>/<session id>/, and what a worker runs from
# there (a scratch browser profile, a script, a background task's log) carries
# that path on its command line. The path is the ownership mark. A leftover is
# a process of this user that carries the session id of a worker spawned from
# one of this repo's briefs, or that shares a process group with one when the
# group has no terminal (a Bash-tool group, never an interactive shell's).
# Nothing else is listed or stopped: no matching by name, no other session's.

SPAWN_RE="You are a Jarvis worker\\. Read AGENTS\\.md, then do the task in "

brief_terminal() {
  sed -n 's/.*terminal:[[:space:]]*\([^ ]*\).*/\1/p' "$1" 2>/dev/null | head -n 1 | grep -v '^<' || true
}

handoff_of() { # the latest handoff written for a brief, merged or not
  grep -l "^brief:[[:space:]]*$1" "$H"/*.md "$H"/merged/*.md 2>/dev/null | tail -n 1
}

live_sids() { # this checkout's session ids that a process of this user names on its command line
  ps -axww -o uid=,command= 2>/dev/null | J_UID=$(id -u) J_PROJ="$PROJ" awk '
    $1 == ENVIRON["J_UID"] {
      s = $0; key = "/claude-" ENVIRON["J_UID"] "/" ENVIRON["J_PROJ"] "/"
      while ((i = index(s, key)) > 0) {
        s = substr(s, i + length(key)); id = substr(s, 1, 36)
        if (length(id) == 36 && id ~ /^[0-9a-f-]+$/ && substr(s, 37, 1) == "/") print id
      }
    }' | sort -u
}

brief_of_session() { # the brief a session of this checkout worked from, if it was a worker
  local f="$CLAUDE_DIR/projects/$PROJ/$1.jsonl" b t
  # the spawn prompt names the brief, and it opens the worker's transcript
  [ -f "$f" ] && b=$(head -n 30 "$f" | grep -o "${SPAWN_RE}$H/briefs/[^ \"\\\\]*\\.md" | head -n 1 | sed 's/.* do the task in //')
  # a worker that ran /clear has a new transcript; the prompt hook saw it in the worker's terminal
  if [ -z "${b:-}" ] && t=$(grep -lxF "$1" "$STATE"/sessions/* 2>/dev/null | head -n 1) && [ -n "$t" ]; then
    b=$(grep -l "^started:.*terminal:[[:space:]]*$(basename "$t")" "$H"/briefs/*.md 2>/dev/null | head -n 1)
  fi
  [ -n "${b:-}" ] && [ -f "$b" ] && echo "$b"
}

worker_sessions() { # "<brief> <session id>" for each worker session something still names; $1 = only this brief
  local s b
  for s in $(live_sids); do
    b=$(brief_of_session "$s") || continue
    [ -z "${1:-}" ] || [ "$b" = "$1" ] || continue
    echo "$b $s"
  done
}

# What the given sessions left running, one process per line:
# "<session id> <pid> <pgid> <ppid> <elapsed> <%cpu> <command>". The session
# ids go to awk through the environment, so no command line here carries them;
# this command's own process group is never listed.
owned_procs() { # $@ = session ids
  [ $# -gt 0 ] || return 0
  ps -axww -o pid=,ppid=,pgid=,uid=,tty=,stat=,etime=,%cpu=,command= 2>/dev/null \
    | J_SIDS="$*" J_UID=$(id -u) J_SELF=$$ J_PGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ') awk '
    BEGIN { n = split(ENVIRON["J_SIDS"], sid, " "); u = ENVIRON["J_UID"] }
    {
      c = $0; for (k = 0; k < 8; k++) sub(/^[ \t]*[^ \t]+[ \t]+/, "", c); sub(/[ \t]+$/, "", c)
      pid[NR] = $1; ppid[NR] = $2; pg[NR] = $3; et[NR] = $7; cpu[NR] = $8; cmd[NR] = c
      if ($5 != "??" && $5 != "?") tty[$3] = 1
      # a zombie has already exited: nothing to stop
      mine[NR] = ($4 == u && $6 !~ /^Z/ && $1 != ENVIRON["J_SELF"] && $3 != ENVIRON["J_PGID"])
      if (!mine[NR]) next
      for (i = 1; i <= n; i++)
        if (c ~ ("/claude-" u "/[^/ ]+/" sid[i] "/")) { hit[NR] = sid[i]; if (!($3 in grp)) grp[$3] = sid[i]; break }
    }
    END {
      for (r = 1; r <= NR; r++) {
        if (!mine[r]) continue
        s = hit[r]
        if (s == "" && (pg[r] in grp) && !(pg[r] in tty)) s = grp[pg[r]]
        if (s != "") print s, pid[r], pg[r], ppid[r], et[r], cpu[r], cmd[r]
      }
    }'
}

show_procs() { # stdin: owned_procs lines; one line per process tree, its children counted
  awk -v u="$(id -u)" '
    { p[NR] = $2; pp[NR] = $4; e[NR] = $5; c[NR] = $6; x = $0
      for (k = 0; k < 6; k++) sub(/^[^ ]+ /, "", x); cmd[NR] = x; at[$2] = NR }
    END {
      for (r = 1; r <= NR; r++) {
        q = r; while ((pp[q] in at) && at[pp[q]] != q) q = at[pp[q]]
        top[r] = q; tc[q] += c[r]; if (q != r) kids[q]++
      }
      for (r = 1; r <= NR; r++) if (top[r] == r) {
        x = cmd[r]; gsub("[^ =]*/claude-" u "/[^/ ]+/[0-9a-f-]+/", "<scratch>/", x)
        # a long command line keeps its start and the argument that names the scratch folder
        if (length(x) > 100 && (i = index(x, "<scratch>/")) > 60) {
          while (i > 1 && substr(x, i - 1, 1) != " ") i--
          t = substr(x, i); sub(/ .*/, "", t); x = substr(x, 1, 50) " ... " t
        }
        if (length(x) > 140) x = substr(x, 1, 140) "..."
        printf "    pid %s · up %s · cpu %.0f%%%s%s · %s\n", p[r], e[r], tc[r], (pp[r] == 1 ? " · orphaned" : ""),
          (kids[r] ? " · +" kids[r] " child" (kids[r] > 1 ? "ren" : "") : ""), x
      }
    }'
}

declared_pids() { # the PIDs a handoff lists under "## Processes left running"
  [ -f "$1" ] || return 0
  awk '/^## /{on = ($0 ~ /^## Processes left running/); next} on && /^[[:space:]]*[-*] /' "$1" \
    | sed -E 's/^[[:space:]]*[-*][[:space:]]+`?([Pp][Ii][Dd][[:space:]]*)?//' | grep -oE '^[0-9]+' || true
}

drop_declared() { # $1 = owned_procs lines, $2 = declared PIDs: the lines outside their process groups
  local pid keep=""
  for pid in $2; do keep="$keep $(printf '%s\n' "$1" | awk -v p="$pid" '$2 == p {print $3}')"; done
  printf '%s\n' "$1" | awk -v k=" $(echo $keep) " 'NF && index(k, " " $3 " ") == 0'
}

still() { # $1 pid, $2 pgid, $3 command: is that PID still the process that was listed?
  [ "$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')" = "$2" ] || return 1
  [ "$(ps -ww -o command= -p "$1" 2>/dev/null | sed 's/[[:space:]]*$//')" = "$3" ]
}

# Stop the processes in $1 (owned_procs lines), except every process group
# holding a PID in $2. Each one is checked again right before it's signalled, so
# a PID reused since the listing is left alone. TERM, then KILL after 10 s.
# Prints "<stopped> <needed KILL>", counting a browser's helpers that exit with it.
stop_procs() {
  local list pid pgid cmd n=0 hard=0 i=0 alive
  list=$(drop_declared "$1" "$2")
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && n=$((n + 1))
  done <<EOF
$list
EOF
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && kill -TERM "$pid" 2>/dev/null
  done <<EOF
$list
EOF
  while [ $n -gt 0 ] && [ $i -lt 10 ]; do
    alive=0
    while read -r _ pid pgid _ _ _ cmd; do
      [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && alive=1
    done <<EOF
$list
EOF
    [ $alive = 0 ] && break
    sleep 1; i=$((i + 1))
  done
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && kill -KILL "$pid" 2>/dev/null && hard=$((hard + 1))
  done <<EOF
$list
EOF
  echo "$n $hard"
}

stopped_line() { # $1 = stop_procs output, $2 = the declared PIDs that were kept
  set -- $1 "${2:-}"
  printf 'stopped %s process(es)%s%s' "$1" "$([ "$2" -gt 0 ] && echo ", $2 only by SIGKILL")" \
    "${3:+ · kept $3 (with its process group), declared under Processes left running; --force ends it}"
}

kept_of() { # $1 = owned_procs lines, $2 = declared PIDs: those among the processes
  printf '%s\n' "$1" | awk -v k=" $(echo $2) " 'index(k, " " $2 " ") {print $2}' | tr '\n' ' ' | sed 's/ $//'
}

# merge, after the commit: what the worker left running. $1 brief, $2 its
# handoff, $3 1 = its terminal was just closed
merge_leftovers() {
  local sids procs keep
  sids=$(worker_sessions "$1" | awk '{print $2}')
  [ -n "$sids" ] || return 0
  # shellcheck disable=SC2086
  procs=$(owned_procs $sids)
  [ -n "$procs" ] || return 0
  if [ "$3" = 1 ] && [ "$JARVIS_REAP" = 1 ]; then
    keep=$(declared_pids "$2")
    echo "the worker left these running:"
    printf '%s\n' "$procs" | show_procs
    echo "  $(stopped_line "$(stop_procs "$procs" "$keep")" "$(kept_of "$procs" "$keep")")"
  else
    echo "the worker has these running$([ "$3" = 1 ] || echo ' (its terminal is still open)'):"
    printf '%s\n' "$procs" | show_procs
    echo "  to stop them: handoffs/bin/jarvis leftovers $1 --stop"
  fi
}

cmd_leftovers() {
  local brief="" stop=0 force=0 mine=0 quiet=0 map b sids procs open="" any=0 state term keep
  while [ $# -gt 0 ]; do
    case "$1" in
      --stop) stop=1; shift ;;
      --force) force=1; shift ;;
      --mine) mine=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) brief="$1"; shift ;;
    esac
  done

  if [ $mine = 1 ]; then
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || die "no CLAUDE_CODE_SESSION_ID here: --mine lists a Claude Code session's own processes"
    procs=$(owned_procs "$CLAUDE_CODE_SESSION_ID")
    [ -n "$procs" ] || { echo "nothing this session started is still running (this command aside)"; return 0; }
    echo "still running from this session's scratch folder:"
    printf '%s\n' "$procs" | show_procs
    [ $stop = 1 ] && echo "  $(stopped_line "$(stop_procs "$procs" "")")"
    return 0
  fi

  [ $force = 1 ] && [ -z "$brief" ] && die "--force needs a brief: jarvis leftovers <brief> --stop --force"
  [ -z "$brief" ] || [ -f "$brief" ] || die "usage: jarvis leftovers [<handoffs/briefs/file.md>] [--stop [--force]] | --mine [--stop]"
  map=$(worker_sessions "$brief")
  [ -n "$map" ] || { [ $quiet = 1 ] || echo "nothing left running by ${brief:-any worker}"; return 0; }

  [ -n "$WS" ] && open=$(superset terminals list --workspace "$WS" --json 2>/dev/null)
  for b in $(printf '%s\n' "$map" | awk '{print $1}' | sort -u); do
    sids=$(printf '%s\n' "$map" | awk -v b="$b" '$1 == b {print $2}')
    # shellcheck disable=SC2086
    procs=$(owned_procs $sids)
    [ -n "$procs" ] || continue
    term=$(brief_terminal "$b")
    if [ -z "$open" ]; then state=unknown
    elif [ -n "$term" ] && printf '%s' "$open" | grep -qF "$term"; then state=open
    else state=closed; fi
    [ $quiet = 1 ] && [ "$state" != closed ] && continue
    # status leaves out what the worker declared it left running on purpose
    [ $quiet = 1 ] && [ -z "$(drop_declared "$procs" "$(declared_pids "$(handoff_of "$b")")")" ] && continue
    [ $quiet = 1 ] && [ $any = 0 ] && echo "left running by closed workers (stop: handoffs/bin/jarvis leftovers <brief> --stop):"
    any=1
    echo "  $b (worker terminal $state):"
    printf '%s\n' "$procs" | show_procs
    [ $stop = 1 ] || continue
    if [ "$state" != closed ] && [ $force = 0 ]; then
      echo "    not stopped: the worker's terminal is $state and it may still be using them. Close it first, or --force"
      continue
    fi
    keep=""; [ $force = 1 ] || keep=$(declared_pids "$(handoff_of "$b")")
    echo "    $(stopped_line "$(stop_procs "$procs" "$keep")" "$(kept_of "$procs" "$keep")")"
  done
  [ $any = 1 ] || [ $quiet = 1 ] || echo "nothing left running by ${brief:-any worker}"
}

# ---------------------------------------------------------------- merge

listed_files() { # the paths under "## Files" in a handoff
  awk '/^## /{on = ($0 ~ /^## Files/); next} on && /^[[:space:]]*[-*] /' "$1" \
    | sed -E -e 's/^[[:space:]]*[-*][[:space:]]+//' -e 's/`//g' \
             -e 's/[[:space:]]+(—|–|--|-|\().*$//' -e 's/[[:space:]]+$//' \
    | grep -v '^path/relative' | grep -v '^$'
}

changed_paths() { # every changed/untracked path, renames as their new path
  git status --porcelain -uall 2>/dev/null | cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//'
}

cmd_merge() {
  local ho="" check=0 msg="" outcome="" push="$JARVIS_PUSH" keep=0 force=0
  local status brief agent files f bad=0 other title dest trailer sha term old_tracked=0 closed line
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      -m) msg="${2:-}"; shift 2 ;;
      --outcome) outcome="${2:-}"; shift 2 ;;
      --no-push) push=0; shift ;;
      --keep-open) keep=1; shift ;;
      --force) force=1; shift ;;
      *) ho="$1"; shift ;;
    esac
  done
  [ -f "$ho" ] || die "usage: jarvis merge <handoffs/file.md> [--check] [-m msg] [--outcome clean|corrected|escalated|respawned] [--no-push] [--keep-open]"
  status=$(field status "$ho" | awk '{print $1}')
  brief=$(field brief "$ho" | awk '{print $1}')
  agent=$(field agent "$ho")
  files=$(listed_files "$ho")
  [ -n "$files" ] || die "$ho lists no files under ## Files"

  echo "$ho · status: $status · brief: ${brief:-none}"
  for f in $files; do
    if changed_paths | grep -qxF "$f"; then :; else
      echo "  ✗ listed but not changed: $f"; bad=1
    fi
  done
  other=$(changed_paths | grep -v "^$H/" | grep -vxF "$files")
  if [ -n "$other" ]; then
    echo "  other changes in the checkout (another worker's, or missing from this list):"
    printf '%s\n' "$other" | head -n 12 | sed 's/^/    /'
  fi
  git diff --stat -- $files 2>/dev/null | sed 's/^/  /'
  for f in $files; do
    git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || [ ! -f "$f" ] || echo "   new: $f ($(wc -l < "$f" | tr -d ' ') lines)"
  done
  [ $check = 1 ] && exit $bad

  [ "$status" = blocked ] && die "status is blocked — answer its questions first"
  [ $bad = 1 ] && [ $force = 0 ] && die "file list doesn't match git status — send it back, or --force"

  mkdir -p "$H/merged"
  dest="$H/merged/$(basename "$ho")"
  term=$(brief_terminal "$brief")
  [ -n "$brief" ] && open_drop "$brief"
  open_drop "$(basename "$ho")"
  git ls-files --error-unmatch -- "$ho" >/dev/null 2>&1 && old_tracked=1
  mv "$ho" "$dest"
  # a handoff that lists itself would be staged at the path it just left
  set -- $(printf '%s\n' $files | grep -vxF "$ho") "$dest"
  [ $old_tracked = 1 ] && set -- "$@" "$ho"
  [ -n "$brief" ] && [ -f "$brief" ] && set -- "$@" "$brief"
  [ -f "$OPEN" ] && set -- "$@" "$OPEN"
  git add -A -- "$@" || die "git add failed"

  title=$(sed -n '1s/^#[[:space:]]*//p' "$dest")
  [ -n "$msg" ] || msg="$title"
  trailer=""
  case "$agent" in
    claude*) trailer="Co-Authored-By: Claude Code <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    codex*) trailer="Co-Authored-By: Codex <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    opencode*) trailer="Co-Authored-By: OpenCode <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
  esac
  if [ -n "$trailer" ]; then
    git commit -q -m "$msg" -m "$trailer" -- "$@" || die "commit failed"
  else
    git commit -q -m "$msg" -- "$@" || die "commit failed"
  fi
  sha=$(git rev-parse --short HEAD)
  line="merged $sha · $(printf '%s\n' $files | wc -l | tr -d ' ') files"

  if [ "$push" = 1 ]; then
    if git push -q 2>/dev/null; then line="$line · pushed"; else line="$line · push FAILED (run git push)"; fi
  fi
  closed=0
  if [ $keep = 0 ] && [ -n "$term" ] && [ -n "$WS" ]; then
    superset terminals close --workspace "$WS" --terminal "$term" >/dev/null 2>&1 && line="$line · closed $(short "$term")" && closed=1
  fi
  if [ -n "$outcome" ] && [ -x "$BIN/jev.sh" ] && [ -n "$brief" ]; then
    "$BIN/jev.sh" outcome "$brief" "$outcome" >/dev/null 2>&1
  fi
  echo "$line · OPEN.md updated in the same commit"
  [ -n "$brief" ] && [ -f "$brief" ] && merge_leftovers "$brief" "$dest" "$closed"
  return 0
}

# ---------------------------------------------------------------- watch

jarvis_idle_min() { # minutes since the Jarvis transcript last changed; empty if unknown
  local tp
  have jq || return
  tp=$(jq -r '.transcript_path // empty' "$STATE/session.json" 2>/dev/null)
  [ -n "$tp" ] && [ -f "$tp" ] || return
  echo $(( ($(now) - $(mtime "$tp")) / 60 ))
}

send_jarvis() { # $1 = text
  superset terminals send --workspace "$WS" --terminal "$(jarvis_terminal)" --text "$1" >/dev/null 2>&1
}

watch_tick() {
  local seen="$STATE/watch.seen" events="" ho key id tail_ idle term line brief sum scr stale
  touch "$seen"
  for ho in "$H"/*.md; do
    [ -f "$ho" ] || continue
    case "$(basename "$ho")" in OPEN.md|TEMPLATE.md|JARVIS.md) continue ;; esac
    key="$ho $(mtime "$ho") $(field status "$ho")"
    grep -qxF "$key" "$seen" && continue
    echo "$key" >> "$seen"
    events="$events handoff $ho ($(field status "$ho"));"
  done
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    [ -n "$id" ] || continue
    tail_=$(superset terminals read --workspace "$WS" --terminal "$id" --max-lines 15 --json 2>/dev/null \
      | { have jq && jq -r '.text // empty' || cat; } | sed -e 's/[[:space:]]*$//')
    [ -n "$tail_" ] || continue
    sum=$(printf '%s' "$tail_" | cksum | cut -d' ' -f1)
    if printf '%s' "$tail_" | grep -Eiq "$LIMIT_RE"; then
      key="limit $id $(date +%Y%m%d%H)"
      grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events usage limit in worker $(short "$id");"; }
    elif printf '%s' "$tail_" | grep -Eiq "$PROMPT_RE"; then
      key="prompt $id $sum"
      grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events worker $(short "$id") is waiting at a prompt — read its terminal;"; }
    else
      # a working agent's screen keeps changing (spinner, timer, output); a frozen one
      # with no handoff is stuck at something the patterns above don't know
      scr="$STATE/screen-$id"
      if [ "$(cat "$scr" 2>/dev/null)" != "$sum" ]; then
        echo "$sum" > "$scr"
      else
        stale=$(( ($(now) - $(mtime "$scr")) / 60 ))
        brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
        if [ "$stale" -ge "$JARVIS_STALL_MIN" ] && ! grep -lq "^brief:[[:space:]]*${brief:-@@none@@}" "$H"/*.md 2>/dev/null; then
          key="stall $id $sum"
          grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events worker $(short "$id")'s screen hasn't changed in ${stale} min and it has no handoff — read its terminal;"; }
        fi
      fi
    fi
  done <<EOF
$(running_lines)
EOF
  [ -n "$events" ] || return 0

  term=$(jarvis_terminal)
  [ -n "$term" ] || { echo "$(date +%H:%M) events but no Jarvis session in $OPEN:$events"; return 0; }
  idle=$(jarvis_idle_min)
  if [ -n "$idle" ] && [ "$idle" -ge "$JARVIS_IDLE_MIN" ]; then
    send_jarvis "/clear"
    sleep 3
    send_jarvis "[jarvis watch] Fresh session: Jarvis was idle ${idle} min, so its cache had expired. You are Jarvis — use the jarvis:run skill, read handoffs/JARVIS.md and handoffs/OPEN.md, run handoffs/bin/jarvis status, then handle:$events"
    echo "$(date +%H:%M) cleared Jarvis (idle ${idle} min) and woke it:$events"
  else
    send_jarvis "[jarvis watch]$events"
    echo "$(date +%H:%M) woke Jarvis:$events"
  fi
}

cmd_watch() {
  [ -n "$WS" ] || die "SUPERSET_WORKSPACE_ID not set"
  mkdir -p "$STATE"
  if [ "${1:-}" = --once ]; then watch_tick; return; fi
  # first pass only learns what's already there
  for ho in "$H"/*.md; do
    [ -f "$ho" ] && echo "$ho $(mtime "$ho") $(field status "$ho")" >> "$STATE/watch.seen"
  done
  echo "jarvis watch: every ${JARVIS_WATCH_SEC}s (handoffs, limits, prompts, workers frozen ${JARVIS_STALL_MIN}+ min); clears Jarvis first after ${JARVIS_IDLE_MIN} min idle. Ctrl-C to stop."
  while :; do sleep "$JARVIS_WATCH_SEC"; watch_tick; done
}

# ---------------------------------------------------------------- hooks

# UserPromptSubmit, Jarvis's terminal only: after a long idle the prompt cache has
# expired, and the next turn would write the whole context again. Stop the prompt
# once and suggest /clear; sending it again goes through.
hook_prompt() {
  local in sid tp prompt me last gap ctx model price usd marker
  have jq || exit 0
  in=$(cat)
  me="${SUPERSET_TERMINAL_ID:-}"
  sid=$(printf '%s' "$in" | jq -r '.session_id // empty')
  # every terminal: which Claude sessions ran in it, so `jarvis leftovers` can
  # tell what a worker started even after it ran /clear
  case "$me$sid" in
    *[!A-Za-z0-9_-]*) ;;
    *) if [ -n "$me" ] && [ -n "$sid" ] && ! grep -qxF "$sid" "$STATE/sessions/$me" 2>/dev/null; then
         mkdir -p "$STATE/sessions" && echo "$sid" >> "$STATE/sessions/$me"
       fi ;;
  esac
  [ -n "$me" ] && [ "$me" = "$(jarvis_terminal)" ] || exit 0
  tp=$(printf '%s' "$in" | jq -r '.transcript_path // empty')
  prompt=$(printf '%s' "$in" | jq -r '.prompt // empty')
  [ -n "$sid" ] && [ -f "$tp" ] || exit 0
  mkdir -p "$STATE"
  # the watcher reads this to tell how long Jarvis has been idle
  jq -n --arg t "$me" --arg s "$sid" --arg p "$tp" --argjson ts "$(now)" \
    '{terminal: $t, session_id: $s, transcript_path: $p, ts: $ts}' > "$STATE/session.json"
  case "$prompt" in /*) exit 0 ;; esac

  last=$(tail -n 400 "$tp" | jq -c 'select(.type == "assistant" and .message.usage) |
      {t: .timestamp, m: .message.model, u: .message.usage}' 2>/dev/null | tail -n 1)
  [ -n "$last" ] || exit 0
  gap=$(printf '%s' "$last" | jq -r --argjson now "$(now)" \
    '(.t | sub("\\.[0-9]+"; "") | fromdateiso8601) as $t | (($now - $t) / 60 | floor)' 2>/dev/null) || exit 0
  ctx=$(printf '%s' "$last" | jq -r '.u | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)')
  model=$(printf '%s' "$last" | jq -r '.m // ""')
  [ "$gap" -ge "$JARVIS_IDLE_MIN" ] && [ "$ctx" -ge "$JARVIS_GUARD_TOKENS" ] || exit 0

  marker="$STATE/guard-$sid"
  if [ -f "$marker" ] && [ $(( $(now) - $(mtime "$marker") )) -lt 900 ]; then rm -f "$marker"; exit 0; fi
  touch "$marker"
  case "$model" in
    *fable*) price=20 ;; *opus-5-5*) price=8 ;; *opus*) price=10 ;; *sonnet*) price=4 ;; *haiku*) price=2 ;; *) price=10 ;;
  esac
  usd=$(awk -v t="$ctx" -v p="$price" 'BEGIN{printf "%.2f", t * p / 1000000}')
  jq -n --arg r "Jarvis has been idle ${gap} min, so its prompt cache has expired: this message would write all $((ctx / 1000))k tokens of context again (about \$${usd} at API prices). Cheaper: /clear, then \"resume\" — Jarvis reloads from handoffs/OPEN.md. To go ahead anyway, send your message again." \
    '{decision: "block", reason: $r}'
}

# Statusline tap: Claude Code hands the statusline its rate-limit numbers. Save
# them for `jarvis band`, then run the user's own statusline unchanged.
cmd_statusline() {
  local in cmd tmp
  in=$(cat)
  if have jq; then
    mkdir -p "$STATE" 2>/dev/null
    tmp="$STATE/usage.json.$$"
    printf '%s' "$in" | jq -c --argjson ts "$(now)" 'select(.rate_limits.five_hour) | .rate_limits + {ts: $ts}' \
      > "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv "$tmp" "$STATE/usage.json"
    rm -f "$tmp"
    cmd="${JARVIS_STATUSLINE_CMD:-$(jq -r '.statusLine.command // empty' "$HOME/.claude/settings.json" 2>/dev/null)}"
  else
    cmd="${JARVIS_STATUSLINE_CMD:-}"
  fi
  case "$cmd" in *"jarvis statusline"*) cmd="" ;; esac
  if [ -n "$cmd" ]; then printf '%s' "$in" | sh -c "$cmd"
  elif have jq; then printf '%s' "$in" | jq -r '"\(.model.display_name // "") · 5h \(.rate_limits.five_hour.used_percentage // "?" | tostring | .[0:4])%"'
  fi
}

# ---------------------------------------------------------------- usage

cmd_usage() {
  local audit since_arg json merged
  have python3 || die "python3 is needed for jarvis usage"
  have jq || die "jq is needed for jarvis usage"
  audit="$(cd "$(dirname "$0")" && pwd)/cc_usage_audit.py"
  [ -f "$audit" ] || die "no $audit — re-run jarvis:setup"
  set -- --project="$PROJ" \
    --role worker='^You are a Jarvis worker' \
    --role-tool orchestrator='superset agents create|handoffs/bin/jarvis (start|status|spawn|merge)' \
    --bash-category coordination='terminals (read|send|list|close)|handoffs/|OPEN\.md|jev\.sh|bin/jarvis' \
    "$@"
  json=$(python3 "$audit" "$@" --json) || exit 1
  since_arg=$(printf '%s' "$json" | jq -r '.period[0]')
  merged=$(git log --since="$since_arg" --diff-filter=A --name-only --format= -- "$H/merged/*.md" 2>/dev/null | grep -c '\.md$')
  printf '%s' "$json" | jq -r --argjson merged "$merged" '
    def usd: "$" + ((. * 100 | round) / 100 | tostring);
    def role(r): [.by_role | to_entries[] | select(.key == r or .key == (r + " > subagents")) | .value.usd] | add // 0;
    (role("orchestrator")) as $coord | (role("worker")) as $build
    | "jarvis usage · \(.period[0][0:16]) → \(.period[1][0:16]) · \(.total_usd | usd) in this repo at API prices",
      "  coordinating (Jarvis + its subagents): \($coord | usd)",
      "  building (workers + their subagents):  \($build | usd)",
      "  coordinating ÷ building: \(if $build > 0 then ($coord / $build * 100 | round) / 100 else "n/a" end)   (target ≤ 0.3)",
      "  merged handoffs: \($merged) · cost per merged handoff: \(if $merged > 0 then (($coord + $build) / $merged) | usd else "n/a" end)",
      "  worst 5-hour window: \(.peak_window_usd | usd) · most sessions in one 10-min slot: \(.peak_concurrent_sessions_10min)",
      "  cache reloads after idle (Jarvis): \([.reloads[] | select(.role == "orchestrator" and .cause == "after idle")] | "\(map(.turns) | add // 0) turns, \(map(.usd) | add // 0 | usd)")",
      "",
      "  Jarvis by model (for comparing coordinator configs):",
      ([.by_role_model[]? | select(.role == "orchestrator")] | sort_by(-.usd)[]
        | "    \(.model): \(.turns) turns · \(.usd | usd) · $\((.usd / .turns * 1000 | round) / 1000)/turn · avg ctx \((.ctx / .turns / 1000) | round)k")'
}

# ---------------------------------------------------------------- main

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start) cmd_start "$@" ;;
  status) cmd_status ;;
  band) cmd_band ;;
  spawn) cmd_spawn "$@" ;;
  merge) cmd_merge "$@" ;;
  leftovers) cmd_leftovers "$@" ;;
  watch) cmd_watch "$@" ;;
  usage) cmd_usage "$@" ;;
  statusline) cmd_statusline ;;
  hook)
    case "${1:-}" in
      prompt) hook_prompt ;;
      *) exit 0 ;;
    esac ;;
  *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
