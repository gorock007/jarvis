#!/usr/bin/env bash
# jarvis — the routine steps of the Jarvis workflow, one command each, so the
# coordinator spends its turns on judgement instead of bookkeeping.
#
#   jarvis start                       claim this terminal as Jarvis in OPEN.md, then status
#   jarvis status                      band, workers, new handoffs, git — one short screen
#   jarvis spawn <brief.md> [--after <partial-handoff>] [--attach <file>]... [--force]
#                                      lint, enforce the band and the Claude caps (machine-wide,
#                                      this checkout, Opus; --force passes them, never Fable),
#                                      a respawn gate (a brief that blew its budget or used its
#                                      attempts needs --after its handoff), spawn, record
#   jarvis sessions                    the Claude sessions counting toward the caps, machine-wide,
#                                      and the ones idle for hours you may want to close
#   jarvis read <terminal> [<lines>]   the bottom of a worker's screen
#   jarvis send <terminal> <text>      type into a worker's terminal and press Enter
#   jarvis send <terminal> --keys <k,k> press keys: enter, esc, tab, shift+tab, up, 1, y, ctrl+c…
#   jarvis close <terminal>            close a worker's terminal and drop it from OPEN.md
#   jarvis budget <terminal> [min=N] [usd=N] [ctx=N[k]] [tests=N]
#                                      a worker's budget use; with values, set that run's limits
#                                      and re-arm its ask and pause (logged)
#   jarvis merge <handoff.md> --check  file list vs git status, diff stat; changes nothing
#   jarvis merge <handoff.md> [-m <msg>] [--outcome <o>] [--no-push] [--keep-open] [--force]
#                                      commit exactly the listed files + the handoff move,
#                                      push, close the worker, update OPEN.md, stop what the
#                                      worker left running
#   jarvis leftovers [<brief.md>] [--stop [--force]]
#                                      processes workers started that outlived them (their
#                                      scratch folder on the command line); --stop ends them
#   jarvis leftovers --mine [--stop]   (a worker) what this session started that's still running
#   jarvis watch [--once | --start]   run in its own terminal (no model): wakes Jarvis when a
#                                      handoff lands or a worker is limited, waiting at a prompt
#                                      or frozen; asks a worker past its budget for a partial
#                                      handoff, then presses Escape if it keeps going; /clears
#                                      Jarvis first after a long idle. --start opens that
#                                      terminal, unless a watcher is already running
#   jarvis band                        the usage band from the machine-wide statusline reading
#                                      and its burn rate; no reading or a stale one is amber
#   jarvis usage [--days N | --since DATE] [--all-projects]
#                                      coordinating vs building, from local transcripts
#   jarvis hook prompt                 UserPromptSubmit guard (from .claude/settings.json)
#   jarvis hook pretool                PreToolUse guard: no Fable subagent, no Fable in a settings allowlist
#   jarvis fable allow <brief.md>      (the user, in their own terminal) let that brief's next spawn run on Fable
#   jarvis fable list | revoke <brief.md>
#                                      authorizations pending, used and expired, and the log tail
#   jarvis fable backstop [--apply]    whether the user-level availableModels keeps Fable out; --apply writes it
#   jarvis statusline                 statusline tap: saves the 5-hour reading machine-wide (and
#                                      its history), then runs yours
#   jarvis lock <class> [--wait <sec>] [--reuse] -- <command…>
#                                      run a heavy command only while holding its class's lease,
#                                      machine-wide or per checkout; waiters queue in order
#   jarvis resources [--json]          who holds each lease, who's queued, stored passes
#   jarvis doctor [--apply | --quiet]  which agent processes, terminals and runs of this checkout
#                                      are alive and why; --apply ends only the finished and lost
#                                      ones Jarvis owns, each audited; --quiet: one line or nothing
#
# Workers run on a host: Superset, Ultron, tmux, or one added in handoffs/bin/hosts/ (see
# "hosts" below). The agent in each terminal is any CLI: claude, codex, opencode, or
# one added as JARVIS_AGENT_<name> in jarvis.conf.
# Settings live in handoffs/jarvis.conf. Works on the stock macOS bash (3.2).
# jq is needed for spawn, the hooks and the band. Without it spawn refuses and the band
# reads amber (the Fable checks fail closed too); only the hooks and the guard let things through.
set -u

# PreToolUse runs this on every Agent, Task, Edit and Write call: leave before anything
# else runs unless the input names fable or a settings*.json file. A settings file goes
# on to be rebuilt and parsed every time, since its JSON can spell fable in \u escapes
# or across several edits.
if [ "${1:-} ${2:-}" = "hook pretool" ]; then
  JARVIS_HOOK_IN=$(cat)
  case "$JARVIS_HOOK_IN" in
    *[Ff][Aa][Bb][Ll][Ee]*|*[Ss][Ee][Tt][Tt][Ii][Nn][Gg][Ss]*.[Jj][Ss][Oo][Nn]*) ;;
    *) exit 0 ;;
  esac
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
JARVIS_CALLER_PWD=$PWD   # `lock` runs its command where it was called from
cd "$ROOT" || exit 0
H=handoffs
OPEN="$H/OPEN.md"
STATE="$H/.jarvis"
BIN="$H/bin"

JARVIS_MAX_CLAUDE=3      # Claude sessions at once in this checkout, Jarvis included; Codex/OpenCode don't count
JARVIS_MAX_CLAUDE_GLOBAL=4  # active Claude sessions on the whole machine, any repo, the user's own included; Jarvis sessions don't count
JARVIS_MAX_OPUS=2        # of those, Opus workers (or Fable, or a model that can't be told); Jarvis doesn't count
JARVIS_AMBER_GLOBAL=3    # the machine-wide cap in the amber band (Jarvis sessions don't count)
JARVIS_AMBER_OPUS=2      # the Opus cap in amber (Jarvis doesn't count)
JARVIS_RED_GLOBAL=2      # the machine-wide cap in red
JARVIS_RED_OPUS=0        # the Opus cap in red: no new Opus work
JARVIS_ACTIVE_MIN=10     # a session busy, or updated this many minutes ago, is active; idle ones don't count
JARVIS_PENDING_SEC=180   # a spawn counts this long, or until its session record appears
JARVIS_AMBER=50          # 5-hour % that turns the band amber
JARVIS_RED=75            # 5-hour % that turns it red
JARVIS_STALE_MIN=30      # a reading older than this, its window not reset, is treated as amber
JARVIS_BURN_MIN=20       # the burn rate is the 5-hour % used over this many minutes
JARVIS_BURN_AMBER=15     # points per JARVIS_BURN_MIN that turn the band amber whatever the projection
JARVIS_IDLE_MIN=55       # minutes idle after which a big context is cheaper to clear than reload
JARVIS_GUARD_TOKENS=100000
JARVIS_WATCH_SEC=60
JARVIS_STALL_MIN=15      # a worker screen unchanged this long, with no handoff, wakes Jarvis
JARVIS_BUDGET_MIN=90     # a worker's working minutes (watcher ticks its screen changed in)
JARVIS_BUDGET_USD=15     # its API-equivalent estimate, subagents included
JARVIS_BUDGET_CTX=300000 # its last turn's context
JARVIS_BUDGET_TESTS=6    # its failed test runs
JARVIS_BUDGET_ATTEMPTS=2 # runs per brief before a respawn needs --after
JARVIS_BUDGET_SEC=300    # the watcher reads a worker's transcript at most this often
JARVIS_BUDGET_GRACE_MIN=10  # after the ask, minutes without a handoff before Escape
JARVIS_PUSH=1
JARVIS_REAP=1            # merge stops what the closed worker left running (0 = only list it)
JARVIS_STOP_GRACE=10     # seconds merge/close wait for a closed worker's terminal and agent to go
JARVIS_HOST=""           # superset | ultron | tmux | <name> with handoffs/bin/hosts/<name>.sh; empty = detect
JARVIS_FABLE_TTL_MIN=120 # minutes a `jarvis fable allow` stays usable
JARVIS_FABLE_SUPERSET_AGENT=""  # a Superset agent config id that lifts the backstop; empty = no Fable on Superset
# How a terminal host that isn't an agent launcher itself (tmux) starts each worker:
# a sh command line reading $JARVIS_MODEL, $JARVIS_EFFORT and $JARVIS_PROMPT from its
# environment. The flags are the ones Superset's agent presets launch with, so a
# worker behaves the same on either host. Any other agent CLI is one more line.
# shellcheck disable=SC2016,SC2034
JARVIS_AGENT_claude='claude --dangerously-skip-permissions ${JARVIS_MODEL:+--model "$JARVIS_MODEL"} ${JARVIS_EFFORT:+--effort "$JARVIS_EFFORT"} "$JARVIS_PROMPT"'
# shellcheck disable=SC2016,SC2034
JARVIS_AGENT_codex='codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust ${JARVIS_MODEL:+-m "$JARVIS_MODEL"} ${JARVIS_EFFORT:+-c model_reasoning_effort="$JARVIS_EFFORT"} -- "$JARVIS_PROMPT"'
# shellcheck disable=SC2016,SC2034
JARVIS_AGENT_opencode='opencode ${JARVIS_MODEL:+-m "$JARVIS_MODEL"} --prompt "$JARVIS_PROMPT"'
# shellcheck disable=SC1090
[ -f "$H/jarvis.conf" ] && . "$H/jarvis.conf"
WS="${SUPERSET_WORKSPACE_ID:-}"
PROJ=$(printf '%s' "$ROOT" | sed 's#[^A-Za-z0-9]#-#g')   # Claude Code's name for this checkout
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
JHOME="${JARVIS_HOME:-$HOME/.jarvis}"   # machine-wide: the usage reading and its history, the spawn lease, pending spawns
ROOTP=$(pwd -P)                         # this checkout as session records name it
TAB=$(printf '\t')

LIMIT_RE="(usage|rate|session|weekly|daily|hourly|5-hour) limit (was |has been )?(reached|exceeded|hit)|(hit|reached|exceeded) (your|the) [a-z0-9 -]*limit|limit reached|quota (was |has been )?(exceeded|exhausted)|out of credits|too many requests"
# A worker sitting at a trust or approval prompt does nothing until someone answers it.
PROMPT_RE="trust (this|the files in this) folder|do you trust|allow codex to work in this folder|press enter to confirm|would you like to (run|make|apply)|do you want to (proceed|make this edit|create|run|allow)|allow (this|once)|\\(y/n\\)|\\[y/n\\]"

die() { echo "jarvis: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now() { date +%s; }
short() { printf '%s' "$1" | cut -c1-8; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# ---------------------------------------------------------------- hosts

# A host runs agents in terminals that Jarvis can read and type into. It is seven
# functions named <host>_<op>; everything else in this script is the same on any host.
#   self                                 this terminal's id
#   spawn <agent> <model> <effort> <prompt> <name> [<attachment>...]
#                                        start a worker in a new terminal in this checkout,
#                                        print its terminal id; errors go to stderr
#   run <name> <command>                 a plain command in a terminal of its own
#   list                                 the ids of the open terminals, one per line;
#                                        fails when the host can't be asked (none open is not a failure)
#   read <id> <lines>                    the bottom of a terminal's screen, as text
#   send <id> <text>                     type text and press Enter
#   send <id> --keys <k,k>               press keys, in Superset's names (enter, esc,
#                                        tab, shift+tab, up, ctrl+c, a single character)
#   close <id>                           close a terminal
#   titles                               optional: "<id>\t<title>" per open terminal, so
#                                        `jarvis doctor` can name the ones it doesn't know
#   clear <id>                           optional: restart Jarvis's agent on a fresh
#                                        context in the same terminal; without it the
#                                        watcher types /clear
# Built in: superset, ultron and tmux. Another (an IDE, a remote box) defines the same
# functions in handoffs/bin/hosts/<name>.sh and is picked with JARVIS_HOST=<name> in
# jarvis.conf.
# Every spawn passes the Fable final check in host() first. For an authorized Fable run
# it sets FABLE_LIFT=1, and the spawn adds --settings "$FABLE_SETTINGS" to that one
# claude launch, so the user-level allowlist without Fable (the backstop) lets it through.
# A host that can't pass it leaves the backstop in force: the worker runs on Opus.

superset_self() { printf '%s' "${SUPERSET_TERMINAL_ID:-}"; }

superset_spawn() {
  local agent=$1 model=$2 effort=$3 prompt=$4 a out
  shift 5
  # each attachment becomes "--attachment <path>" at the end of the list, the original dropped
  for a in "$@"; do set -- "$@" --attachment "$a"; shift; done
  # a launch can't carry --settings here; an agent config can (JARVIS_FABLE_SUPERSET_AGENT).
  # Another agent naming fable keeps its own config, and the backstop stays in force.
  if [ "${FABLE_LIFT:-0}" = 1 ] && [ "$agent" = claude ]; then
    [ -n "$JARVIS_FABLE_SUPERSET_AGENT" ] || { echo "$FABLE_SUPERSET_MSG" >&2; return 1; }
    agent=$JARVIS_FABLE_SUPERSET_AGENT
  fi
  set -- "$@" --workspace "$WS" --agent "$agent" --prompt "$prompt" --json
  case "$model" in ""|\<*) ;; *) set -- "$@" --model "$model" ;; esac
  [ -n "$effort" ] && set -- "$@" --effort "$effort"
  out=$(superset agents create "$@" 2>&1) || { echo "$out" >&2; return 1; }
  printf '%s' "$out" | jq -r '.sessionId // empty' 2>/dev/null | grep . || { echo "no sessionId in: $out" >&2; return 1; }
}

superset_run() { superset terminals create --workspace "$WS" --command "$2" --json >/dev/null; }

superset_list() {
  local out
  out=$(superset terminals list --workspace "$WS" --json 2>/dev/null) || return 1
  printf '%s' "$out" | jq -r '.sessions[]? | select(.exited | not) | .terminalId'
}

superset_titles() {
  superset terminals list --workspace "$WS" --json 2>/dev/null \
    | jq -r '.sessions[]? | select(.exited | not) | [.terminalId, (.customTitle // .title // "")] | @tsv'
}

superset_read() {
  superset terminals read --workspace "$WS" --terminal "$1" --max-lines "$2" --json 2>/dev/null \
    | { have jq && jq -r '.text // empty' || cat; }
}

superset_send() {
  if [ "${2:-}" = --keys ]; then
    superset terminals send --workspace "$WS" --terminal "$1" --keys "${3:-}" >/dev/null
  else
    superset terminals send --workspace "$WS" --terminal "$1" --text "$2" >/dev/null
  fi
}

superset_close() { superset terminals close --workspace "$WS" --terminal "$1" >/dev/null; }

# Ultron: its daemon runs each agent in a session (s_…) in this checkout's project and
# launches the agent itself, as Superset does. A Claude Jarvis there is usually a chat
# session (stream transport): it has no screen, so read and send go through `chat`.
ult() { if have ultron; then ultron "$@"; else "$HOME/.ultron/bin/ultron" "$@"; fi; }

ultron_self() { printf '%s' "${ULTRON_SESSION_ID:-}"; }

ultron_chat() { # whether session $1 is a chat session
  [ "$(ult term get "$1" --json 2>/dev/null | jq -r '.transport // empty' 2>/dev/null)" = stream ]
}

ultron_spawn() {
  local agent=$1 model=$2 effort=$3 prompt=$4 name=$5 a out
  shift 5
  for a in "$@"; do set -- "$@" --attachment "$a"; shift; done
  set -- "$@" --agent "$agent" --role worker --title "$name" --cwd "$ROOT" --prompt "$prompt" --json
  case "$model" in ""|\<*) ;; *) set -- "$@" --model "$model" ;; esac
  [ -n "$effort" ] && set -- "$@" --effort "$effort"
  # extra args for claude itself; another agent's CLI wouldn't take them
  [ "${FABLE_LIFT:-0}" = 1 ] && [ "$agent" = claude ] && set -- "$@" -- --settings "$FABLE_SETTINGS"
  out=$(ult agent spawn "$@" 2>&1) || { echo "$out (is this checkout an Ultron project? ultron project add .)" >&2; return 1; }
  printf '%s' "$out" | jq -r '.id // empty' 2>/dev/null | grep . || { echo "no id in: $out" >&2; return 1; }
}

ultron_run() { ult term create --title "$1" --command "$2" --cwd "$ROOT" --json >/dev/null; }

ultron_list() {
  local out
  out=$(ult term list --json 2>/dev/null) || return 1
  printf '%s' "$out" | jq -r '.[]? | select(.state | IN("exited", "failed") | not) | .id'
}

ultron_read() { # a chat session's conversation stands in for its screen
  if ultron_chat "$1"; then
    ult chat history "$1" --limit 200 --json 2>/dev/null | jq -r '.events[]? | .data as $d
      | if .kind == "user_message" then ($d.text // "" | split("\n")[] | "> " + .)
        elif .kind == "assistant_message" then ($d.text // "")
        elif .kind == "tool_use" then "[tool \($d.name // "?")]"
        elif .kind == "turn_finished" then "[turn done]"
        else empty end' 2>/dev/null | tail -n "$2"
    return
  fi
  ult term read "$1" --max-lines "$2" --json 2>/dev/null | { have jq && jq -r '.screen // empty' || cat; }
}

ultron_send() {
  local id=$1 k b
  if [ "${2:-}" = --keys ]; then
    ultron_chat "$id" && { echo "$id is a chat session: it takes text, not keys" >&2; return 1; }
    # term send types its text as is, so a key is the bytes a terminal sends for it
    for k in $(printf '%s' "${3:-}" | tr ',' ' '); do
      case "$k" in
        enter) ult term send "$id" --text "" --json >/dev/null || return 1; continue ;;
        esc|escape) b=$'\e' ;; tab) b=$'\t' ;; shift+tab) b=$'\e[Z' ;; space) b=" " ;; backspace) b=$'\x7f' ;;
        up) b=$'\e[A' ;; down) b=$'\e[B' ;; right) b=$'\e[C' ;; left) b=$'\e[D' ;;
        ctrl+[a-z]) b=$(printf "\\$(printf '%03o' $(( $(printf '%d' "'${k#ctrl+}") - 96 )))") ;;
        alt+?) b=$'\e'"${k#alt+}" ;;
        ?) b=$k ;;
        *) echo "ultron: no key '$k'" >&2; return 1 ;;
      esac
      ult term send "$id" --text "$b" --no-submit --json >/dev/null || return 1
    done
    return 0
  fi
  if ultron_chat "$id"; then
    ult chat send "$id" --text "$2" --json >/dev/null
  else
    ult term send "$id" --text "$(printf '%s' "$2" | tr '\n' ' ')" --json >/dev/null
  fi
}

ultron_close() { ult term close "$1" --json >/dev/null; }

ultron_clear() { ult term clear "$1" --json >/dev/null; } # same session id, fresh agent

# tmux: each worker gets a window in Jarvis's tmux session, named after its brief and
# tagged @jarvis, so close never touches a pane Jarvis didn't open. When the agent
# exits, the window stays up with its last screen until merge closes it.
tmux_self() { printf '%s' "${TMUX_PANE:-}"; }

tmux_session() { # the session Jarvis runs in, where workers go
  tmux display-message -p -t "${TMUX_PANE:-$(jarvis_terminal)}" '#{session_id}' 2>/dev/null
}

tmux_spawn() {
  local agent=$1 model=$2 effort=$3 prompt=$4 name=$5 cmd a sess launch id
  shift 5
  cmd=$(agent_cmd "$agent") || { echo "no launch command for agent '$agent': add JARVIS_AGENT_$agent to $H/jarvis.conf" >&2; return 1; }
  sess=$(tmux_session) || { echo "can't find Jarvis's tmux session" >&2; return 1; }
  for a in "$@"; do prompt="$prompt Read this attached file first: $a"; done
  # a script file, not a tmux command string: tmux runs those in the user's shell, and
  # the launch line is written for sh
  mkdir -p "$STATE/launch"
  launch="$STATE/launch/$name.sh"
  {
    echo "# written by jarvis spawn; tmux runs it in the worker's window"
    echo "unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_ENTRYPOINT"
    tmux_fable_lines "$model"
    echo "$cmd"
    # shellcheck disable=SC2016
    echo 's=$?; printf "\n[jarvis] %s exited (%s). Its window stays open until jarvis merge or close.\n" "$JARVIS_AGENT" "$s"'
    echo "exec tail -f /dev/null"
  } > "$launch"
  id=$(tmux new-window -d -P -F '#{pane_id}' -t "$sess:" -n "$name" -c "$ROOT" \
    -e "JARVIS_AGENT=$agent" -e "JARVIS_MODEL=$model" -e "JARVIS_EFFORT=$effort" -e "JARVIS_PROMPT=$prompt" \
    "sh $launch") || return 1
  tmux set-option -p -t "$id" @jarvis "$name" 2>/dev/null
  echo "$id"
}

# The final check once more, inside the launch script, for any agent (one may wrap
# claude): the window's environment comes from the tmux server too, and the script can
# be edited before it runs. So: no alias variable may point at Fable, JARVIS_MODEL must
# be the model spawn checked, and only an authorized run gets the allowlist that lifts
# the backstop. $1 = that model.
tmux_fable_lines() {
  local v q
  q=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")   # quoted for sh: ' becomes '\''
  for v in ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL \
           ANTHROPIC_SMALL_FAST_MODEL CLAUDE_CODE_SUBAGENT_MODEL; do
    echo "case \"\$(printf '%s' \"\${$v:-}\" | tr '[:upper:]' '[:lower:]')\" in *fable*) unset $v ;; esac"
  done
  echo "if [ \"\$JARVIS_MODEL\" != '$q' ]; then printf '[jarvis] refused: JARVIS_MODEL is not the model spawn checked (%s)\\n' '$q'; exec tail -f /dev/null; fi"
  if [ "${FABLE_LIFT:-0}" = 1 ]; then
    echo "claude() { command claude --settings '$FABLE_SETTINGS' \"\$@\"; }"
  else
    echo "case \"\$(printf '%s' \"\${JARVIS_MODEL%%\\[*}\" | tr '[:upper:]' '[:lower:]')\" in *fable*) printf '[jarvis] refused: fable without authorization\\n'; exec tail -f /dev/null ;; esac"
  fi
}

tmux_run() { tmux new-window -d -t "$(tmux_session):" -n "$1" -c "$ROOT" "$2"; }

tmux_list() { tmux list-panes -a -F '#{pane_id}' 2>/dev/null; }

tmux_read() { # the screen plus scrollback, trailing blank lines dropped, then the last $2
  tmux capture-pane -p -J -t "$1" -S "-$2" 2>/dev/null | sed -e 's/[[:space:]]*$//' \
    | awk '{l[NR] = $0} NF {last = NR} END {for (i = 1; i <= last; i++) print l[i]}' | tail -n "$2"
}

tmux_send() {
  local id=$1 k
  if [ "${2:-}" = --keys ]; then
    for k in $(printf '%s' "${3:-}" | tr ',' ' '); do
      case "$k" in
        enter) k=Enter ;; esc|escape) k=Escape ;; tab) k=Tab ;; shift+tab) k=BTab ;; space) k=Space ;;
        up) k=Up ;; down) k=Down ;; left) k=Left ;; right) k=Right ;; backspace) k=BSpace ;;
        ctrl+?) k="C-${k#ctrl+}" ;; alt+*) k="M-${k#alt+}" ;; f[0-9]|f1[0-2]) k=$(printf '%s' "$k" | tr f F) ;;
        ?) tmux send-keys -t "$id" -l -- "$k" || return 1; continue ;;
      esac
      tmux send-keys -t "$id" "$k" || return 1
    done
    return 0
  fi
  # one line: a newline would press Enter mid-message. The pause lets a TUI take the
  # text as typed before Enter arrives.
  tmux send-keys -t "$id" -l -- "$(printf '%s' "$2" | tr '\n' ' ')" && sleep 0.5 && tmux send-keys -t "$id" Enter
}

tmux_close() {
  [ -n "$(tmux display-message -p -t "$1" '#{@jarvis}' 2>/dev/null)" ] || { echo "$1 is not a window jarvis spawn opened" >&2; return 1; }
  tmux kill-pane -t "$1"
}

agent_cmd() { # $1 = agent: the sh command line a terminal host runs for it
  local v
  case "$1" in ""|*[!a-z0-9_]*) return 1 ;; esac
  eval "v=\${JARVIS_AGENT_$1:-}"
  [ -n "$v" ] && printf '%s\n' "$v"
}

host_pick() {
  if [ -n "$JARVIS_HOST" ]; then echo "$JARVIS_HOST"
  elif [ -n "${SUPERSET_WORKSPACE_ID:-}" ]; then echo superset
  elif [ -n "${ULTRON_SESSION_ID:-}" ]; then echo ultron
  elif [ -n "${TMUX:-}" ]; then echo tmux
  fi
}
HOST=$(host_pick)
# shellcheck disable=SC1090
[ -n "$HOST" ] && [ -f "$BIN/hosts/$HOST.sh" ] && . "$BIN/hosts/$HOST.sh"

need_host() {
  [ -n "$HOST" ] || die "no host: run Jarvis in a Superset terminal, an Ultron session or inside tmux, or set JARVIS_HOST in $H/jarvis.conf"
}

host() { # $1 = op, then its arguments
  local op=$1
  shift
  need_host
  type "${HOST}_$op" >/dev/null 2>&1 || die "host $HOST has no $op: define ${HOST}_$op in $BIN/hosts/$HOST.sh"
  [ "$op" = spawn ] && fable_final "$@"   # whoever called, the last word before a launch
  "${HOST}_$op" "$@"
}

# ---------------------------------------------------------------- OPEN.md

jarvis_terminal() {
  sed -n 's/^Jarvis session:[[:space:]]*//p' "$OPEN" 2>/dev/null | head -n 1 | awk '{print $1}' | grep -v '^<' || true
}

# "- <when> · <agent>/<model> <effort> · term <id> · <brief> · <slug>"
running_lines() {
  awk '/^## /{on = ($0 ~ /^## Running workers/); next} on && /^- /' "$OPEN" 2>/dev/null
}

claude_sessions() { # Jarvis plus every running Claude worker
  echo $(( $(running_lines | grep -c '· claude/') + 1 ))
}

open_add_running() { # $1 = line
  local tmp; tmp=$(mktemp) || return 1
  awk -v line="$1" '{print} /^## Running workers/ && !done {print line; done=1}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_drop() { # drop list items that mention $1
  local tmp; tmp=$(mktemp) || return 1
  awk -v k="$1" '!(/^- / && index($0, k))' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

open_set() { # $1 = "Jarvis session" | "Usage band", $2 = value
  local tmp; tmp=$(mktemp) || return 1
  awk -v k="$1" -v v="$2" 'index($0, k ":") == 1 {print k ": " v; next} {print}' "$OPEN" > "$tmp" && mv "$tmp" "$OPEN"
}

field() { # $1 = key, $2 = file: "key: value" from a brief header or handoff
  sed -n "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1
}

# ---------------------------------------------------------------- band

# Prints "<band>\t<one-line explanation>", band green | amber | red. The reading comes
# from `jarvis statusline`, which Claude Code feeds its own 5-hour and 7-day numbers;
# rate limits are per account, so one machine-wide reading serves every repo (the
# repo's own copy only when there is none yet). It fails closed: no reading, no jq or
# an unreadable one is amber, and so is a reading older than JARVIS_STALE_MIN whose
# window hasn't reset. A window that has reset since is green only while the reading
# is under 5 h old. Besides the window average (pace) it watches the burn rate from
# the history: amber when that rate would use up the window before it resets, or is
# JARVIS_BURN_AMBER or more; red when it reaches 100% within 30 minutes.
band() {
  local f burn
  have jq || { printf 'amber\tunknown band, treated as amber: jq not installed\n'; return; }
  f="$JHOME/usage.json"
  [ -s "$f" ] || f="$STATE/usage.json"
  [ -s "$f" ] || { printf 'amber\tunknown band, treated as amber: no statusline reading yet — check `/usage`\n'; return; }
  burn=$(usage_burn "$f")
  jq -r --argjson now "$(now)" --argjson amber "$JARVIS_AMBER" --argjson red "$JARVIS_RED" \
    --argjson stale "$JARVIS_STALE_MIN" --argjson bmin "$JARVIS_BURN_MIN" --argjson bamber "$JARVIS_BURN_AMBER" \
    --argjson burn "${burn:-null}" '
    def hm: (. / 60 | floor) as $m | "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m";
    def worse($a; $b): if $a == "red" or $b == "red" then "red" elif $a == "amber" or $b == "amber" then "amber" else "green" end;
    (.five_hour.used_percentage // null) as $u
    | (.five_hour.resets_at // null) as $r
    | (if (.seven_day.used_percentage | type) == "number" and $now < (.seven_day.resets_at // $now + 1)
       then .seven_day.used_percentage else null end) as $w
    | (if (.ts | type) == "number" then (($now - .ts) / 60 | floor) else null end) as $age
    | (if $w == null then "green" elif $w >= 95 then "red" elif $w >= 80 then "amber" else "green" end) as $wb
    | (if $w then " · 7d \($w | round)%" else "" end) as $wt
    | if ($u | type) != "number" or ($r | type) != "number" or $age == null then
        "amber\tunknown band, treated as amber: the reading has no 5-hour window"
      elif $now >= $r then
        if $age < 300 then "\($wb)\tthe 5-hour window has reset since the last reading (\($age) min ago)\($wt)"
        else "amber\tunknown band, treated as amber: the last reading is \($age * 60 | hm) old and its window has reset since" end
      else
        (18000 - ($r - $now)) as $el
        | (($r - $now) / 60) as $left
        | (if $el >= 1800 then ($u * 18000 / $el) else null end) as $pace
        | (if $burn != null and $burn > 0 then $u + $burn * $left / $bmin else null end) as $proj
        | (if $burn != null and $burn > 0 then $u + $burn * ([30, $left] | min) / $bmin else null end) as $soon
        | (if $u >= $red or ($soon // 0) >= 100 then "red"
           elif $u >= $amber or ($pace // 0) >= 100 or ($proj // 0) >= 100 or ($burn // 0) >= $bamber then "amber"
           else "green" end) as $b5
        | ($age > $stale) as $old
        | worse(worse($b5; $wb); if $old then "amber" else "green" end) as $b
        | "\($b)\t" + (if $old then "stale reading (\($age) min old), treated as amber: " else "" end)
          + "5h \($u | round)% used, \($el | hm) into the window"
          + (if $pace then ", on pace for \($pace | round)%" else "" end)
          + (if $burn != null then ", burning \($burn | round) pts/\($bmin) min"
               + (if ($proj // 0) >= 100 then " (100% in \((100 - $u) * $bmin / $burn | floor) min)" else "" end)
             else "" end)
          + $wt
          + (if $age > 20 and ($old | not) then " · reading \($age) min old" else "" end)
      end' "$f" 2>/dev/null || printf 'amber\tunknown band, treated as amber: unreadable %s\n' "$f"
}

# $1 = the reading: 5-hour points used per JARVIS_BURN_MIN minutes, from the history
# lines of the same window; empty when the history spans under 5 minutes of it. The
# baseline is the last line at least JARVIS_BURN_MIN before the reading, else (or when
# that one is far older, after a gap) the first line since.
usage_burn() {
  local h="$JHOME/usage.hist" cur
  [ -s "$h" ] || return 0
  cur=$(jq -r '"\(.ts) \(.five_hour.used_percentage) \(.five_hour.resets_at)"' "$1" 2>/dev/null) || return 0
  tail -n 500 "$h" | awk -v cur="$cur" -v w=$((JARVIS_BURN_MIN * 60)) '
    BEGIN { split(cur, c, " "); ts = c[1] + 0; u = c[2] + 0; r = c[3] + 0 }
    NF >= 4 && $1 + 0 <= ts && $4 - r < 600 && r - $4 < 600 {
      if ($1 + 0 <= ts - w) { bt = $1; bu = $2; hb = 1 } else if (!fo) { ft = $1; fu = $2; fo = 1 }
    }
    END {
      if (hb && (!fo || ts - bt <= 2 * w || ts - ft < 300)) { t = bt; v = bu }
      else if (fo) { t = ft; v = fu }
      else exit
      if (ts - t < 300) exit
      d = u - v; if (d < 0) d = 0
      printf "%.1f\n", d * w / (ts - t)
    }'
}

cmd_band() { band | tr '\t' ' '; }

# ---------------------------------------------------------------- claude sessions, machine-wide

# The caps count every Claude session on this machine, Jarvis's or not, from Claude
# Code's session records ($CLAUDE_DIR/sessions/<pid>.json, and ~/.claude's when they
# differ). Each is verified against ps as claude_here does: a dead PID, or one reused
# since (procStart differs), doesn't count, so a stale record needs no cleaning and
# nothing is ever deleted. Hooks and headless runs (entrypoint sdk-*) don't count.
# Read only: nothing here signals a session.

proj_root() { # $1 = a physical path: the nearest directory above it (or it) with a .git, else itself
  local d=$1
  while [ -n "$d" ] && [ "$d" != / ]; do
    [ -e "$d/.git" ] && { printf '%s\n' "$d"; return; }
    d=${d%/*}
  done
  printf '%s\n' "$1"
}

sess_model() { # $1 = cwd, $2 = session id: the last assistant model in its transcript (tail only)
  local p t
  p=$(printf '%s' "$1" | sed 's#[^A-Za-z0-9]#-#g')
  for t in "$CLAUDE_DIR/projects/$p/$2.jsonl" "$HOME/.claude/projects/$p/$2.jsonl"; do
    [ -f "$t" ] || continue
    tail -n 200 "$t" | grep '"type":"assistant"' \
      | jq -r '.message.model // empty | select(. != "<synthetic>")' 2>/dev/null | tail -n 1
    return
  done
}

# "<pid>\t<session>\t<project root or cwd>\t<model>\t<why>\t<started ms>\t<updated ms>",
# one line per session that counts toward the caps. why: busy (its status), recent
# (updated in the last JARVIS_ACTIVE_MIN minutes), jarvis (this checkout's Jarvis or
# one of its running workers, whatever its status), pending (a spawn whose session
# record hasn't appeared yet: pid -, its entry's name as the session). Idle sessions
# burn nothing and don't count; $1 = --all lists them too, why idle. model is
# fable | opus | sonnet | haiku | unknown: a worker of this checkout's from the run
# registry, else its transcript's; unknown counts as Opus.
claude_active() {
  local all=${1:-} a b d f r recs="" q jar="" regm="" sid pid cwd why st up proj m used="" ep pr pm pn tmp
  have jq || return 0
  q='select(type == "object" and .pid != null and .sessionId != null)
     | [(.pid | tostring), .sessionId, (.cwd // ""), (.procStart // ""), (.status // ""),
        ([.updatedAt, .statusUpdatedAt, 0] | map(numbers) | max | floor | tostring),
        ([.startedAt, 0] | map(numbers) | max | floor | tostring), (.entrypoint // "")] | @tsv'
  a=$(cd "$CLAUDE_DIR/sessions" 2>/dev/null && pwd -P)
  b=$(cd "$HOME/.claude/sessions" 2>/dev/null && pwd -P)
  [ "$a" = "$b" ] && b=""
  for d in "$a" "$b"; do
    [ -n "$d" ] || continue
    set -- "$d"/*.json
    [ -f "$1" ] || continue
    recs="$recs$(jq -r "$q" "$@" 2>/dev/null || for f; do jq -r "$q" "$f" 2>/dev/null; done)
"
  done
  # Jarvis's sessions and its running workers', with the model each worker was spawned on
  jar=$(cat "$STATE/sessions/$(jarvis_terminal)" 2>/dev/null; jq -r '.session_id // empty' "$STATE/session.json" 2>/dev/null)
  for f in "$RUNS"/*; do
    [ -f "$f" ] && grep -qx 'state: running' "$f" || continue
    r=${f##*/}
    m=$(run_get "$r" model)
    for sid in $(cat "$STATE/sessions/$r" 2>/dev/null); do jar="$jar
$sid"; regm="$regm$sid $m
"; done
  done
  tmp=$(mktemp "${TMPDIR:-/tmp}/jarvis-active.XXXXXX") || return 0
  [ -n "$recs" ] && TZ=UTC LC_ALL=C ps -axww -o pid=,uid=,stat=,lstart=,command= 2>/dev/null \
    | J_RECS="$recs" J_UID=$(id -u) J_JAR="$jar" J_NOW="$(now)000" J_WIN=$((JARVIS_ACTIVE_MIN * 60000)) J_ALL="$all" awk '
      BEGIN {
        n = split(ENVIRON["J_JAR"], j, "\n"); for (i = 1; i <= n; i++) if (j[i] != "") jar[j[i]] = 1
        n = split(ENVIRON["J_RECS"], r, "\n")
        for (i = 1; i <= n; i++) {
          if (split(r[i], f, "\t") < 7 || f[8] ~ /^sdk-/) continue
          ps = f[4]; gsub(/[ \t]+/, " ", ps); sub(/^ /, "", ps); sub(/ $/, "", ps)
          sid[f[1]] = f[2]; cwd[f[1]] = f[3]; start[f[1]] = ps; st[f[1]] = f[5]; up[f[1]] = f[6] + 0; born[f[1]] = f[7] + 0
        }
      }
      $2 == ENVIRON["J_UID"] && ($1 in sid) && $3 !~ /^Z/ {
        p = $1; ls = $4 " " $5 " " $6 " " $7 " " $8
        if (start[p] != "") { if (start[p] != ls) next }
        else { c = $0; for (k = 0; k < 8; k++) sub(/^[ \t]*[^ \t]+[ \t]+/, "", c); if (c !~ /(^|\/)claude( |$)/) next }
        why = st[p] == "busy" ? "busy" : up[p] >= ENVIRON["J_NOW"] - ENVIRON["J_WIN"] ? "recent" : (sid[p] in jar) ? "jarvis" : "idle"
        if (why == "idle" && ENVIRON["J_ALL"] == "") next
        print p "\t" sid[p] "\t" cwd[p] "\t" why "\t" born[p] "\t" up[p]
      }' > "$tmp"
  # per session: its project and model
  while IFS=$TAB read -r pid sid cwd why st up; do
    [ -n "$pid" ] || continue
    proj=$(cd "$cwd" 2>/dev/null && proj_root "$(pwd -P)")
    [ -n "$proj" ] || proj=$cwd
    m=-
    if [ "$why" != idle ]; then
      m=$(printf '%s' "$regm" | awk -v s="$sid" '$1 == s {print $2; exit}')
      [ -n "$m" ] || m=$(sess_model "$cwd" "$sid")
      if [ -z "$m" ]; then m=unknown; else m=$(model_canon claude "$m") || m=unknown; fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$sid" "$proj" "$m" "$why" "$st" "$up"
  done < "$tmp" > "$tmp.l"
  cat "$tmp.l"
  # a spawn counts until a session that started after it shows up in its project, its
  # run has ended, or JARVIS_PENDING_SEC has passed
  for f in "$JHOME"/spawning/*; do
    [ -f "$f" ] || continue
    ep=$(rec_get "$f" epoch); pr=$(rec_get "$f" project); pm=$(rec_get "$f" model); pn=$(rec_get "$f" run)
    case "$ep" in ""|*[!0-9]*) continue ;; esac
    [ $(( $(now) - ep )) -lt "$JARVIS_PENDING_SEC" ] || continue
    if [ -n "$pn" ] && run_ok "$pn" && [ -f "$pr/$STATE/runs/$pn" ] && ! grep -qx 'state: running' "$pr/$STATE/runs/$pn"; then continue; fi
    sid=$(awk -F'\t' -v p="$pr" -v t=$(( (ep - 5) * 1000 )) -v used="$used" '
      $5 != "idle" && $3 == p && $6 + 0 >= t && index(used, " " $2 " ") == 0 {print $2; exit}' "$tmp.l")
    if [ -n "$sid" ]; then used="$used $sid "; continue; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' - "${f##*/}" "$pr" "${pm:-unknown}" pending "${ep}000" "${ep}000"
  done
  rm -f "$tmp" "$tmp.l"
}

heavy() { case "$1" in opus|fable|unknown) return 0 ;; esac; return 1; } # counts toward the Opus cap

jarvis_sids() { # $1 = a project root: the session ids of its Jarvis coordinator, one a line (none without one)
  local t
  t=$(sed -n 's/^Jarvis session:[[:space:]]*//p' "$1/$OPEN" 2>/dev/null | head -n 1 | awk '{print $1}' | grep -v '^<')
  case "$t" in ""|*/*|.*) return 0 ;; esac
  cat "$1/$STATE/sessions/$t" 2>/dev/null
  have jq && jq -r '.session_id // empty' "$1/$STATE/session.json" 2>/dev/null
  return 0
}

# Sets CAP_BAND, the effective caps CAP_G (machine) CAP_P (this checkout) CAP_O (Opus),
# the counts N_ALL N_HERE N_OPUS, N_OPEN (OPEN.md's, Jarvis included), CAP_LINES (the
# sessions that count), CAP_IDLE (the idle ones) and CAP_JARVIS (" <sid> " for each
# Jarvis coordinator session, any repo's). This checkout counts as whichever is higher:
# OPEN.md's Jarvis + running Claude workers, or its active sessions; so Jarvis and its
# workers always count, whatever their status, and none counts twice. The machine-wide
# and Opus caps leave out every repo's Jarvis: they count workers and the user's own
# sessions (a pending spawn always counts).
cap_counts() {
  local all pid sid proj m why rest here=0 here_w=0 hh=0 oth=0 oh=0 open_h=0 roots=$TAB s j
  CAP_BAND=$(band | cut -f1)
  case "$CAP_BAND" in
    red) CAP_G=$JARVIS_RED_GLOBAL; CAP_O=$JARVIS_RED_OPUS ;;
    amber) CAP_G=$JARVIS_AMBER_GLOBAL; CAP_O=$JARVIS_AMBER_OPUS ;;
    *) CAP_G=$JARVIS_MAX_CLAUDE_GLOBAL; CAP_O=$JARVIS_MAX_OPUS ;;
  esac
  # a band never raises a cap set lower for green
  [ "$CAP_G" -gt "$JARVIS_MAX_CLAUDE_GLOBAL" ] && CAP_G=$JARVIS_MAX_CLAUDE_GLOBAL
  [ "$CAP_O" -gt "$JARVIS_MAX_OPUS" ] && CAP_O=$JARVIS_MAX_OPUS
  CAP_P=$JARVIS_MAX_CLAUDE
  all=$(claude_active --all)
  CAP_LINES=$(printf '%s\n' "$all" | awk -F'\t' 'NF >= 5 && $5 != "idle"')
  CAP_IDLE=$(printf '%s\n' "$all" | awk -F'\t' 'NF >= 5 && $5 == "idle"')
  CAP_JARVIS=" "
  while IFS=$TAB read -r pid sid proj m why rest; do
    [ -n "$pid" ] || continue
    j=0
    if [ "$pid" != - ]; then
      case "$roots" in *"$TAB$proj$TAB"*) ;; *) # each root's Jarvis read once
        roots="$roots$proj$TAB"
        for s in $(jarvis_sids "$proj"); do CAP_JARVIS="$CAP_JARVIS$s "; done ;;
      esac
      case "$CAP_JARVIS" in *" $sid "*) j=1 ;; esac
    fi
    if [ "$proj" = "$ROOTP" ]; then
      here=$((here + 1))
      [ "$j" = 1 ] || { here_w=$((here_w + 1)); heavy "$m" && hh=$((hh + 1)); }
    elif [ "$j" = 0 ]; then oth=$((oth + 1)); heavy "$m" && oh=$((oh + 1)); fi
  done <<LINES
$CAP_LINES
LINES
  N_OPEN=$(claude_sessions)
  for m in $(running_lines | sed -n 's/.*· claude\/\([^ ]*\).*/\1/p'); do
    heavy "$(model_canon claude "$m" || echo unknown)" && open_h=$((open_h + 1))
  done
  N_HERE=$here; [ "$N_OPEN" -gt "$N_HERE" ] && N_HERE=$N_OPEN
  [ "$open_h" -gt "$hh" ] && hh=$open_h
  [ $((N_OPEN - 1)) -gt "$here_w" ] && here_w=$((N_OPEN - 1)) # OPEN.md's workers, without Jarvis
  N_ALL=$((oth + here_w))
  N_OPUS=$((oh + hh))
}

cap_summary() { # after cap_counts
  printf '%s of %s machine-wide (%s of %s here · opus %s of %s)' "$N_ALL" "$CAP_G" "$N_HERE" "$CAP_P" "$N_OPUS" "$CAP_O"
  [ "$CAP_BAND" = green ] || printf ' — band %s caps' "$CAP_BAND"
  echo
}

# shellcheck disable=SC2088 # a path shown to the user, not expanded
tilde() { case "$1" in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }

cap_holders() { # stdin: claude_active lines → "  pid 123 · ~/repo · opus · busy"
  local pid sid proj m why rest
  while IFS=$TAB read -r pid sid proj m why rest; do
    [ -n "$pid" ] || continue
    if [ "$pid" = - ]; then printf '  pending spawn %s · %s · %s\n' "$sid" "$(tilde "$proj")" "$m"
    else printf '  pid %s · %s · %s · %s\n' "$pid" "$(tilde "$proj")" "$m" "$why"; fi
  done
}

# `jarvis spawn` runs this under the machine-wide spawn lease (jarvis-lock.pl, class
# spawn, host 1): count, check the caps, record the spawn as pending. So two Jarvis
# instances can't both take the last slot. The launch runs after the lease is let go
# (a host CLI that starts a daemon would otherwise keep it for good); until the new
# session's record appears, the pending entry holds its slot.
# $1 = canonical model, $2 = force (0|1), $3 = brief, $4 = the entry to write.
cap_claim() {
  local canon=$1 force=$2 brief=$3 entry=$4 cap="" n lim who f
  cap_counts
  if [ "$N_ALL" -ge "$CAP_G" ]; then
    cap="machine-wide"; n=$N_ALL; lim=$CAP_G
    who=$(printf '%s\n' "$CAP_LINES" | awk -F'\t' -v j="$CAP_JARVIS" 'index(j, " " $2 " ") == 0' | cap_holders)
  elif [ "$N_HERE" -ge "$CAP_P" ]; then
    cap="this checkout"; n=$N_HERE; lim=$CAP_P
    who="$(printf '%s\n' "$CAP_LINES" | awk -F'\t' -v p="$ROOTP" '$3 == p' | cap_holders)
  OPEN.md: Jarvis + $((N_OPEN - 1)) running Claude worker(s)"
  elif heavy "$canon" && [ "$N_OPUS" -ge "$CAP_O" ]; then
    cap="Opus"; n=$N_OPUS; lim=$CAP_O
    who=$(printf '%s\n' "$CAP_LINES" | awk -F'\t' -v j="$CAP_JARVIS" \
      '($4 == "opus" || $4 == "fable" || $4 == "unknown") && index(j, " " $2 " ") == 0' | cap_holders)
  fi
  if [ -n "$cap" ]; then
    if [ "$force" = 1 ]; then
      audit cap-force - "$brief" "cap=$cap n=$n limit=$lim band=$CAP_BAND" passed
      echo "jarvis: --force: past the $cap Claude cap ($n of $lim, band $CAP_BAND); logged in $STATE/audit.log" >&2
    else
      {
        printf 'jarvis: Claude cap reached: %s, %s of %s' "$cap" "$n" "$lim"
        if [ "$CAP_BAND" = green ]; then echo; else echo " (band $CAP_BAND: caps lowered)"; fi
        echo "held by:"
        printf '%s\n' "${who:-  the count in OPEN.md}" | grep -v '^$'
        printf 'Options: queue it under To-do in OPEN.md; route it to Codex or OpenCode; or close one of your own idle sessions (handoffs/bin/jarvis sessions lists them)'
        [ "$cap" = Opus ] && printf '; or give it model: sonnet'
        echo ". --force passes this cap (logged)."
      } >&2
      exit 1
    fi
  fi
  (umask 077; mkdir -p "$JHOME/spawning") || exit 1
  for f in "$JHOME"/spawning/*; do # expired entries go
    [ -f "$f" ] || continue
    n=$(rec_get "$f" epoch); case "$n" in ""|*[!0-9]*) n=0 ;; esac
    [ $(( $(now) - n )) -lt "$JARVIS_PENDING_SEC" ] || rm -f "$f"
  done
  printf 'epoch: %s\nproject: %s\nmodel: %s\nbrief: %s\n' "$(now)" "$ROOTP" "$canon" "$brief" > "$entry.tmp" \
    && mv "$entry.tmp" "$entry" || exit 1
}

dur() { # $1 = seconds: 2d03h, 5h10m, 7m
  local s=$1
  [ "$s" -ge 0 ] 2>/dev/null || s=0
  if [ "$s" -ge 86400 ]; then printf '%dd%02dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else printf '%dm' $((s / 60)); fi
}

cmd_sessions() {
  local pid sid proj m why st up t old
  have jq || die "jq is needed to read Claude Code's session records"
  cap_counts
  echo "claude sessions: $(cap_summary)"
  echo "counting toward the caps (busy, active in the last $JARVIS_ACTIVE_MIN min, Jarvis's, or being spawned):"
  [ -n "$CAP_LINES" ] || echo "  none"
  while IFS=$TAB read -r pid sid proj m why st up; do
    [ -n "$pid" ] || continue
    printf '  %-7s %-7s %-7s %s  %s\n' "$pid" "$why" "$m" "$(tilde "$proj")" "$(short "$sid")"
  done <<LINES
$CAP_LINES
LINES
  [ "$N_OPEN" -gt 1 ] && echo "  (OPEN.md here: Jarvis + $((N_OPEN - 1)) running Claude worker(s))"
  # open for hours and idle: they cost nothing, but they're the user's to close
  t=$(now)
  old=$(printf '%s\n' "$CAP_IDLE" | awk -F'\t' -v t="$t" 'NF >= 7 && $6 > 0 && t * 1000 - $6 > 8 * 3600000')
  [ -n "$old" ] || return 0
  echo "idle, open more than 8 h (they burn nothing; close the ones you're done with yourself — jarvis never stops them):"
  while IFS=$TAB read -r pid sid proj m why st up; do
    [ -n "$pid" ] || continue
    printf '  pid %s · %s · open %s · last active %s ago\n' "$pid" "$(tilde "$proj")" \
      "$(dur $(( t - st / 1000 )))" "$(dur $(( t - up / 1000 )))"
  done <<LINES
$old
LINES
}

# ---------------------------------------------------------------- start / status

cmd_start() {
  local me old
  [ -f "$OPEN" ] || die "no $OPEN — run jarvis:setup first"
  me=$(host self)
  [ -n "$me" ] || die "host $HOST gives no id for this terminal — run Jarvis in a Superset terminal, an Ultron session or a tmux pane"
  old=$(jarvis_terminal)
  if [ -n "$old" ] && [ "$old" != "$me" ] && [ "${1:-}" != --force ] \
     && host list | grep -qxF "$old"; then
    die "another Jarvis ($old) is still open — ask the user, then: jarvis start --force"
  fi
  open_set "Jarvis session" "$me"
  mkdir -p "$STATE"
  cmd_status
}

cmd_status() {
  local b line id brief ho ids="" n=0 changed claimed unclaimed
  [ -f "$OPEN" ] || die "no $OPEN — run jarvis:setup first"

  b=$(band)
  printf 'band: %s\n' "$(printf '%s' "$b" | tr '\t' ' ' | sed 's/ /: /')"
  case "$(printf '%s' "$b" | cut -f1)" in
    green|amber|red) open_set "Usage band" "$(printf '%s' "$b" | cut -f1) ($(printf '%s' "$b" | cut -f2 | cut -d, -f1), $(date +%H:%M))" ;;
  esac

  # every active Claude session on the machine, from Claude Code's session records
  cap_counts
  printf 'claude sessions: %s\n' "$(cap_summary)"
  fable_status
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    n=$((n + 1))
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    ho=""
    [ -n "$brief" ] && ho=$(grep -l "^brief:[[:space:]]*$brief" "$H"/*.md 2>/dev/null | head -n 1)
    printf '  %s %s %s' "$(short "$id")" "$(printf '%s' "$line" | awk -F' · ' '{print $2}')" "$(basename "${brief:-?}" .md)"
    if [ -n "$ho" ]; then printf '  → %s (%s)\n' "$ho" "$(field status "$ho")"; else echo; fi
    run_ok "$id" && [ -f "$RUNS/$id" ] && printf '      budget: %s\n' "$(budget_line "$id")"
    [ -n "$id" ] && [ -z "$ho" ] && ids="$ids $id"
  done <<EOF
$(running_lines)
EOF
  [ $n = 0 ] && echo "  no workers running"

  if [ -n "$ids" ]; then
    echo "workers still at it:"
    if [ -x "$BIN/jev.sh" ]; then
      # shellcheck disable=SC2086
      "$BIN/jev.sh" triage $ids 2>/dev/null | sed 's/^/  /'
    else
      for id in $ids; do
        printf '  %s\n' "$(short "$id")"
        host read "$id" 40 | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -n 4 | sed 's/^/      /'
      done
    fi
  fi

  # handoffs on disk that no running worker accounts for
  for ho in "$H"/*.md; do
    [ -f "$ho" ] || continue
    case "$(basename "$ho")" in OPEN.md|TEMPLATE.md|JARVIS.md) continue ;; esac
    brief=$(field brief "$ho")
    running_lines | grep -q "${brief:-@@none@@}" && continue
    echo "handoff not tied to a running worker: $ho ($(field status "$ho"))"
  done

  changed=$(git status --porcelain -uall 2>/dev/null | grep -v " $H/" | wc -l | tr -d ' ')
  claimed=0
  for ho in "$H"/*.md; do [ -f "$ho" ] && claimed=$((claimed + $(listed_files "$ho" | wc -l))); done
  unclaimed=$((changed - claimed)); [ $unclaimed -lt 0 ] && unclaimed=0
  printf 'git: %s changed outside handoffs/ · about %s not in any handoff yet · %s\n' \
    "$changed" "$unclaimed" "$(git log -1 --format='last commit %h %ar' 2>/dev/null)"
  n=$(awk '/^## /{on = ($0 ~ /^## To-do/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  q=$(awk '/^## /{on = ($0 ~ /^## Questions for the user/); next} on && /^- /' "$OPEN" | wc -l | tr -d ' ')
  printf 'OPEN.md: %s question(s) for the user · %s to-do\n' "$q" "$n"
  watch_running || echo "watcher: not running — start it: handoffs/bin/jarvis watch --start"
  cmd_leftovers --quiet
  cmd_doctor --quiet
}

# ---------------------------------------------------------------- spawn

# Codex trusts folders one path at a time and asks "Trust this folder?" on its first
# run in each one; a worker spawned into that prompt sits there until someone answers.
# Record the answer up front, as pressing Yes would. An existing entry is left alone.
codex_trust() {
  local cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"
  case "$ROOT" in *\"*|*\\*) return 0 ;; esac
  grep -qF "[projects.\"$ROOT\"]" "$cfg" 2>/dev/null && return 0
  mkdir -p "$(dirname "$cfg")" \
    && printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$ROOT" >> "$cfg" \
    && echo "trusted $ROOT in $cfg, so Codex starts without its folder prompt"
}

cmd_spawn() {
  local brief="" after="" force=0 atts="" worker model effort tier canon prompt name id b ifs old spawned
  while [ $# -gt 0 ]; do
    case "$1" in
      --after) after="${2:-}"; shift 2 ;;
      --attach) [ -f "${2:-}" ] || die "no file to attach: ${2:-}"; atts="$atts${atts:+
}$2"; shift 2 ;;
      --force) force=1; shift ;;
      *) brief="$1"; shift ;;
    esac
  done
  [ -f "$brief" ] || die "usage: jarvis spawn <handoffs/briefs/file.md> [--after <partial handoff>] [--attach <file>]... [--force]"
  have jq || die "jq is needed to read the spawn result"
  need_host

  worker=$(field worker "$brief" | awk '{print $1}')
  model=$(field model "$brief" | awk '{print $1}')
  effort=$(field effort "$brief" | awk '{print $1}')
  case "$worker" in
    ""|\<*|*[!a-z0-9_]*) die "brief header needs worker: claude | codex | opencode | another agent the host knows" ;;
  esac
  case "$model" in \<*) model="" ;; esac
  case "$effort" in \<*) effort="" ;; esac
  case "$worker" in claude|codex) [ -n "$model" ] || die "brief header needs a model" ;; esac
  [ "$worker" = opencode ] && effort=""
  # the tier goes by the model's canonical name, so no alias skips the band checks;
  # a Claude model that can't be named is refused (it might resolve to Fable), and any
  # worker whose model names fable goes through every Fable check
  canon=$(model_canon "$worker" "$model") || fable_refuse "$brief" - "spawn: model '$model' can't be resolved" "$(model_refusal "$model")"
  fable_preflight "$brief" -
  case "$canon" in fable) tier=top ;; opus) tier=workhorse ;; *) tier=other ;; esac

  b=$(band | cut -f1)
  # Fable: never without the user's authorization for this brief, --force or not; never
  # in the red band even with it; amber allows an authorized one
  if [ "$canon" = fable ]; then
    [ "$b" = red ] && fable_refuse "$brief" - "spawn: red band" "band is red: fable is off even when authorized. New top-tier work goes to Codex: worker: codex, model: gpt-6-astra"
    [ "$worker" = claude ] && [ "$HOST" = superset ] && [ -z "$JARVIS_FABLE_SUPERSET_AGENT" ] && fable_refuse "$brief" - "spawn: superset has no fable agent config" "$FABLE_SUPERSET_MSG"
    fable_find "$brief" || fable_refuse "$brief" - "spawn: $FABLE_WHY" "$(fable_needs "$brief") [$FABLE_WHY]"
  fi

  if [ -x "$BIN/jev.sh" ]; then
    "$BIN/jev.sh" brief "$brief" || [ $force = 1 ] || die "sharpen the brief (or --force if the lint is wrong)"
  fi

  if [ "$worker" = claude ] && [ $force = 0 ]; then
    [ "$b" = red ] && [ "$tier" != other ] && die "band is red: new $tier-tier work goes to Codex (gpt-6-astra / gpt-5.6-sol). Edit the header, or --force"
  fi

  # a brief that blew its budget or used its attempts waits until Jarvis has read why
  budget_gate "$brief" "$after" "$force"

  [ "$worker" = codex ] && codex_trust

  prompt="You are a Jarvis worker. Read AGENTS.md, then do the task in $brief."
  [ -n "$after" ] && prompt="$prompt $after records what is already done — start from there."
  [ "$worker" = opencode ] && prompt="$prompt Touch only the files it lists. Never run git commands that change state."
  prompt="$prompt Put every question in one first handoff (status: blocked); once answered, finish this brief and hand off."

  # the brief's slug names the terminal: 2026-10-20-1030-fix-login.md → fix-login
  name=$(basename "$brief" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-//; s/[^A-Za-z0-9._-]/-/g')
  # attachments as the trailing arguments, one per line of $atts
  ifs=$IFS
  IFS='
'
  set -f
  # shellcheck disable=SC2086
  set -- $atts
  set +f
  IFS=$ifs
  old=$(runs_of "$brief" running | tr '\n' ' ' | sed 's/ $//')
  # the caps: counted, checked and the slot taken under the machine-wide spawn lease;
  # a launch that fails gives the slot back
  if [ "$worker" = claude ]; then
    SPAWN_PENDING="$JHOME/spawning/$name.$(now).$$"
    spawn_claim "$canon" "$force" "$brief" "$SPAWN_PENDING" || exit $?
    trap 'rm -f "$SPAWN_PENDING"' EXIT
  fi
  # used up here, last thing before the launch: a failed launch needs a new `fable allow`
  [ "$canon" = fable ] && fable_consume "$brief" "$name"
  # taken before the host starts the agent, so the agent's own start time is never earlier
  spawned=$(now)
  id=$(host spawn "$worker" "$model" "$effort" "$prompt" "$name" "$@") \
    || die "spawn failed on $HOST (a failed Claude spawn can mean the red band)"
  [ -n "$id" ] || die "spawn on $HOST returned no terminal id"
  if [ -n "${SPAWN_PENDING:-}" ]; then # launched: the entry stays until its session shows up, or the run ends
    trap - EXIT
    run_ok "$id" && printf 'run: %s\n' "$id" >> "$SPAWN_PENDING"
  fi

  brief_set_started "$brief" "started: $(date '+%Y-%m-%d %H:%M') · terminal: $id"
  if run_ok "$id"; then
    rm -f "$RUNS/$id"
    run_set "$id" run "$id" brief "$brief" agent "$worker" model "${model:-default}" effort "${effort:--}" \
      host "$HOST" spawned "$spawned" state running
  else
    echo "warning: terminal id '$id' has characters the run registry doesn't take: not recorded in $RUNS, so merge closes it only through the brief's started: line"
  fi
  open_add_running "- $(date '+%Y-%m-%d %H:%M') · $worker/${model:-default}${effort:+ $effort} · term $id · $brief"
  cap_counts
  echo "spawned $(short "$id") $worker/${model:-default}${effort:+ $effort} ← $brief (claude sessions: $(cap_summary))"
  [ -n "$old" ] && echo "warning: $brief already had a running worker ($old); merge closes every worker of this brief. To close the old one now: handoffs/bin/jarvis close ${old%% *}"
  return 0
}

spawn_claim() { # $@ = cap_claim's arguments: run it under the spawn lease, one spawn at a time machine-wide
  local pl dir="${JARVIS_LOCK_DIR:-$JHOME/locks}" rc=0
  if have perl && pl=$(lock_pl 2>/dev/null); then
    JARVIS_CALLER_PWD="$JARVIS_CALLER_PWD" JARVIS_LOCK_DIR="$dir" JARVIS_LOCK_POLL="${JARVIS_LOCK_POLL:-0.2}" \
      perl "$pl" run spawn host 1 "$ROOT" "${JARVIS_SPAWN_WAIT:-120}" 0 "$0" _claim "$@" || rc=$?
    case $rc in
      0|1) return $rc ;; # 1: a cap, already explained
      75) die "another spawn has held the spawn lease for ${JARVIS_SPAWN_WAIT:-120}s: try again (jarvis resources shows who)" ;;
      *) die "can't take the spawn lease in $dir (exit $rc), so the caps can't be checked: spawn refused" ;;
    esac
  else
    echo "jarvis: no perl here, so the cap check can't be made atomic across repos; checking without the lease" >&2
    (cap_claim "$@")
  fi
}

# Record the terminal in the brief: rewrite its started: line, or add one after the
# header (worker/model/effort), else after the title.
brief_set_started() { # $1 = brief, $2 = the line
  local tmp
  if grep -q '^started:' "$1"; then
    tmp=$(mktemp) && awk -v s="$2" '/^started:/ {print s; next} {print}' "$1" > "$tmp" && cat "$tmp" > "$1"
  else
    tmp=$(mktemp) && awk -v s="$2" '
      NR == FNR { if (/^## /) stop = 1; if (!stop && /^(worker|model|effort):/) at = FNR; next }
      {print} FNR == (at ? at : 1) {print s}' "$1" "$1" > "$tmp" && cat "$tmp" > "$1"
  fi
  rm -f "${tmp:-}"
}

# ---------------------------------------------------------------- leftovers

# A worker's Bash commands run in process groups of their own, away from its
# terminal's, so closing the terminal doesn't stop what they started; and a
# browser whose script crashed is adopted by launchd and runs until someone
# kills it (two did, for ten days). Claude Code gives each session a scratch
# folder, /tmp/claude-<uid>/<project>/<session id>/, and what a worker runs from
# there (a scratch browser profile, a script, a background task's log) carries
# that path on its command line. The path is the ownership mark. A leftover is
# a process of this user that carries the session id of a worker spawned from
# one of this repo's briefs, or that shares a process group with one when the
# group has no terminal (a Bash-tool group, never an interactive shell's).
# Nothing else is listed or stopped: no matching by name, no other session's.

SPAWN_RE="You are a Jarvis worker\\. Read AGENTS\\.md, then do the task in "

brief_terminal() {
  sed -n 's/.*terminal:[[:space:]]*\([^ ]*\).*/\1/p' "$1" 2>/dev/null | head -n 1 | grep -v '^<' || true
}

handoff_of() { # the latest handoff written for a brief, merged or not
  grep -l "^brief:[[:space:]]*$1" "$H"/*.md "$H"/merged/*.md 2>/dev/null | tail -n 1
}

live_sids() { # this checkout's session ids that a process of this user names on its command line
  ps -axww -o uid=,command= 2>/dev/null | J_UID=$(id -u) J_PROJ="$PROJ" awk '
    $1 == ENVIRON["J_UID"] {
      s = $0; key = "/claude-" ENVIRON["J_UID"] "/" ENVIRON["J_PROJ"] "/"
      while ((i = index(s, key)) > 0) {
        s = substr(s, i + length(key)); id = substr(s, 1, 36)
        if (length(id) == 36 && id ~ /^[0-9a-f-]+$/ && substr(s, 37, 1) == "/") print id
      }
    }' | sort -u
}

brief_of_session() { # the brief a session of this checkout worked from, if it was a worker
  local f="$CLAUDE_DIR/projects/$PROJ/$1.jsonl" b t
  # the spawn prompt names the brief, and it opens the worker's transcript
  [ -f "$f" ] && b=$(head -n 30 "$f" | grep -o "${SPAWN_RE}$H/briefs/[^ \"\\\\]*\\.md" | head -n 1 | sed 's/.* do the task in //')
  # a worker that ran /clear has a new transcript; the prompt hook saw it in the worker's terminal
  if [ -z "${b:-}" ] && t=$(grep -lxF "$1" "$STATE"/sessions/* 2>/dev/null | head -n 1) && [ -n "$t" ]; then
    b=$(grep -l "^started:.*terminal:[[:space:]]*$(basename "$t")" "$H"/briefs/*.md 2>/dev/null | head -n 1)
  fi
  [ -n "${b:-}" ] && [ -f "$b" ] && echo "$b"
}

# A session resumed after its brief finished (claude --resume, after_end) is
# someone's live session again: what it runs is its own, never a leftover.
worker_sessions() { # "<brief> <session id>" for each worker session something still names; $1 = only this brief
  local s b here="" got=0
  for s in $(live_sids); do
    b=$(brief_of_session "$s") || continue
    [ -z "${1:-}" ] || [ "$b" = "$1" ] || continue
    [ $got = 1 ] || { here=$(claude_here); got=1; }
    resumed_sid "$b" "$s" "$here" && continue
    echo "$b $s"
  done
}

resumed_sid() { # $1 = brief, $2 = session id, $3 = claude_here lines: a live process of it started after the brief's run ended?
  local pid ps sid st r e
  while read -r pid ps sid st; do
    [ -n "$pid" ] && [ "$sid" = "$2" ] || continue
    r=$(run_by_start "$1" "$ps")
    if [ -n "$r" ]; then e=$(run_get "$r" ended); else e=$(merged_at "$(doc_merged "$1")"); fi
    after_end "$ps" "$e" && return 0
  done <<EOF
$3
EOF
  return 1
}

# What the given sessions left running, one process per line:
# "<session id> <pid> <pgid> <ppid> <elapsed> <%cpu> <command>". The session
# ids go to awk through the environment, so no command line here carries them;
# this command's own process group is never listed.
owned_procs() { # $@ = session ids
  [ $# -gt 0 ] || return 0
  ps -axww -o pid=,ppid=,pgid=,uid=,tty=,stat=,etime=,%cpu=,command= 2>/dev/null \
    | J_SIDS="$*" J_UID=$(id -u) J_SELF=$$ J_PGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ') awk '
    BEGIN { n = split(ENVIRON["J_SIDS"], sid, " "); u = ENVIRON["J_UID"] }
    {
      c = $0; for (k = 0; k < 8; k++) sub(/^[ \t]*[^ \t]+[ \t]+/, "", c); sub(/[ \t]+$/, "", c)
      pid[NR] = $1; ppid[NR] = $2; pg[NR] = $3; et[NR] = $7; cpu[NR] = $8; cmd[NR] = c
      if ($5 != "??" && $5 != "?") tty[$3] = 1
      # a zombie has already exited: nothing to stop
      mine[NR] = ($4 == u && $6 !~ /^Z/ && $1 != ENVIRON["J_SELF"] && $3 != ENVIRON["J_PGID"])
      if (!mine[NR]) next
      for (i = 1; i <= n; i++)
        if (c ~ ("/claude-" u "/[^/ ]+/" sid[i] "/")) { hit[NR] = sid[i]; if (!($3 in grp)) grp[$3] = sid[i]; break }
    }
    END {
      for (r = 1; r <= NR; r++) {
        if (!mine[r]) continue
        s = hit[r]
        if (s == "" && (pg[r] in grp) && !(pg[r] in tty)) s = grp[pg[r]]
        if (s != "") print s, pid[r], pg[r], ppid[r], et[r], cpu[r], cmd[r]
      }
    }'
}

show_procs() { # stdin: owned_procs lines; one line per process tree, its children counted
  awk -v u="$(id -u)" '
    { p[NR] = $2; pp[NR] = $4; e[NR] = $5; c[NR] = $6; x = $0
      for (k = 0; k < 6; k++) sub(/^[^ ]+ /, "", x); cmd[NR] = x; at[$2] = NR }
    END {
      for (r = 1; r <= NR; r++) {
        q = r; while ((pp[q] in at) && at[pp[q]] != q) q = at[pp[q]]
        top[r] = q; tc[q] += c[r]; if (q != r) kids[q]++
      }
      for (r = 1; r <= NR; r++) if (top[r] == r) {
        x = cmd[r]; gsub("[^ =]*/claude-" u "/[^/ ]+/[0-9a-f-]+/", "<scratch>/", x)
        # a long command line keeps its start and the argument that names the scratch folder
        if (length(x) > 100 && (i = index(x, "<scratch>/")) > 60) {
          while (i > 1 && substr(x, i - 1, 1) != " ") i--
          t = substr(x, i); sub(/ .*/, "", t); x = substr(x, 1, 50) " ... " t
        }
        if (length(x) > 140) x = substr(x, 1, 140) "..."
        printf "    pid %s · up %s · cpu %.0f%%%s%s · %s\n", p[r], e[r], tc[r], (pp[r] == 1 ? " · orphaned" : ""),
          (kids[r] ? " · +" kids[r] " child" (kids[r] > 1 ? "ren" : "") : ""), x
      }
    }'
}

declared_pids() { # the PIDs a handoff lists under "## Processes left running"
  [ -f "$1" ] || return 0
  awk '/^## /{on = ($0 ~ /^## Processes left running/); next} on && /^[[:space:]]*[-*] /' "$1" \
    | sed -E 's/^[[:space:]]*[-*][[:space:]]+`?([Pp][Ii][Dd][[:space:]]*)?//' | grep -oE '^[0-9]+' || true
}

drop_declared() { # $1 = owned_procs lines, $2 = declared PIDs: the lines outside their process groups
  local pid keep=""
  for pid in $2; do keep="$keep $(printf '%s\n' "$1" | awk -v p="$pid" '$2 == p {print $3}')"; done
  printf '%s\n' "$1" | awk -v k=" $(echo $keep) " 'NF && index(k, " " $3 " ") == 0'
}

still() { # $1 pid, $2 pgid, $3 command: is that PID still the process that was listed?
  [ "$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')" = "$2" ] || return 1
  [ "$(ps -ww -o command= -p "$1" 2>/dev/null | sed 's/[[:space:]]*$//')" = "$3" ]
}

# Stop the processes in $1 (owned_procs lines), except every process group
# holding a PID in $2. Each one is checked again right before it's signalled, so
# a PID reused since the listing is left alone. TERM, then KILL after 10 s.
# Prints "<stopped> <needed KILL>", counting a browser's helpers that exit with it.
stop_procs() {
  local list pid pgid cmd n=0 hard=0 i=0 alive
  list=$(drop_declared "$1" "$2")
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && n=$((n + 1))
  done <<EOF
$list
EOF
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && kill -TERM "$pid" 2>/dev/null
  done <<EOF
$list
EOF
  while [ $n -gt 0 ] && [ $i -lt 10 ]; do
    alive=0
    while read -r _ pid pgid _ _ _ cmd; do
      [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && alive=1
    done <<EOF
$list
EOF
    [ $alive = 0 ] && break
    sleep 1; i=$((i + 1))
  done
  while read -r _ pid pgid _ _ _ cmd; do
    [ -n "$pid" ] && still "$pid" "$pgid" "$cmd" && kill -KILL "$pid" 2>/dev/null && hard=$((hard + 1))
  done <<EOF
$list
EOF
  echo "$n $hard"
}

stopped_line() { # $1 = stop_procs output, $2 = the declared PIDs that were kept
  set -- $1 "${2:-}"
  printf 'stopped %s process(es)%s%s' "$1" "$([ "$2" -gt 0 ] && echo ", $2 only by SIGKILL")" \
    "${3:+ · kept $3 (with its process group), declared under Processes left running; --force ends it}"
}

kept_of() { # $1 = owned_procs lines, $2 = declared PIDs: those among the processes
  printf '%s\n' "$1" | awk -v k=" $(echo $2) " 'index(k, " " $2 " ") {print $2}' | tr '\n' ' ' | sed 's/ $//'
}

# merge, after the commit: what the worker left running. $1 brief, $2 its
# handoff, $3 1 = its terminal was just closed
merge_leftovers() {
  local sids procs keep
  sids=$(worker_sessions "$1" | awk '{print $2}')
  [ -n "$sids" ] || return 0
  # shellcheck disable=SC2086
  procs=$(owned_procs $sids)
  [ -n "$procs" ] || return 0
  if [ "$3" = 1 ] && [ "$JARVIS_REAP" = 1 ]; then
    keep=$(declared_pids "$2")
    echo "the worker left these running:"
    printf '%s\n' "$procs" | show_procs
    echo "  $(stopped_line "$(stop_procs "$procs" "$keep")" "$(kept_of "$procs" "$keep")")"
  else
    echo "the worker has these running$([ "$3" = 1 ] || echo ' (its terminal is still open)'):"
    printf '%s\n' "$procs" | show_procs
    echo "  to stop them: handoffs/bin/jarvis leftovers $1 --stop"
  fi
}

cmd_leftovers() {
  local brief="" stop=0 force=0 mine=0 quiet=0 map b sids procs open="" listed any=0 state term keep
  while [ $# -gt 0 ]; do
    case "$1" in
      --stop) stop=1; shift ;;
      --force) force=1; shift ;;
      --mine) mine=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) brief="$1"; shift ;;
    esac
  done

  if [ $mine = 1 ]; then
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || die "no CLAUDE_CODE_SESSION_ID here: --mine lists a Claude Code session's own processes"
    procs=$(owned_procs "$CLAUDE_CODE_SESSION_ID")
    [ -n "$procs" ] || { echo "nothing this session started is still running (this command aside)"; return 0; }
    echo "still running from this session's scratch folder:"
    printf '%s\n' "$procs" | show_procs
    [ $stop = 1 ] && echo "  $(stopped_line "$(stop_procs "$procs" "")")"
    return 0
  fi

  [ $force = 1 ] && [ -z "$brief" ] && die "--force needs a brief: jarvis leftovers <brief> --stop --force"
  [ -z "$brief" ] || [ -f "$brief" ] || die "usage: jarvis leftovers [<handoffs/briefs/file.md>] [--stop [--force]] | --mine [--stop]"
  map=$(worker_sessions "$brief")
  [ -n "$map" ] || { [ $quiet = 1 ] || echo "nothing left running by ${brief:-any worker}"; return 0; }

  listed=0
  [ -n "$HOST" ] && open=$(host list 2>/dev/null) && listed=1
  for b in $(printf '%s\n' "$map" | awk '{print $1}' | sort -u); do
    sids=$(printf '%s\n' "$map" | awk -v b="$b" '$1 == b {print $2}')
    # shellcheck disable=SC2086
    procs=$(owned_procs $sids)
    [ -n "$procs" ] || continue
    term=$(brief_terminal "$b")
    if [ $listed = 0 ]; then state=unknown
    elif [ -n "$term" ] && printf '%s\n' "$open" | grep -qxF "$term"; then state=open
    else state=closed; fi
    [ $quiet = 1 ] && [ "$state" != closed ] && continue
    # status leaves out what the worker declared it left running on purpose
    [ $quiet = 1 ] && [ -z "$(drop_declared "$procs" "$(declared_pids "$(handoff_of "$b")")")" ] && continue
    [ $quiet = 1 ] && [ $any = 0 ] && echo "left running by closed workers (stop: handoffs/bin/jarvis leftovers <brief> --stop):"
    any=1
    echo "  $b (worker terminal $state):"
    printf '%s\n' "$procs" | show_procs
    [ $stop = 1 ] || continue
    if [ "$state" != closed ] && [ $force = 0 ]; then
      echo "    not stopped: the worker's terminal is $state and it may still be using them. Close it first, or --force"
      continue
    fi
    keep=""; [ $force = 1 ] || keep=$(declared_pids "$(handoff_of "$b")")
    echo "    $(stopped_line "$(stop_procs "$procs" "$keep")" "$(kept_of "$procs" "$keep")")"
  done
  [ $any = 1 ] || [ $quiet = 1 ] || echo "nothing left running by ${brief:-any worker}"
}

# ---------------------------------------------------------------- runs

# One file per spawn, handoffs/.jarvis/runs/<run>, run = the terminal id the host
# returned: "key: value" lines (run, brief, agent, model, effort, host, spawned,
# state, ended, reason, outcome); state is running | merged | closed | lost. It
# holds what spawn and close decided. Whether a process is alive is asked of ps,
# Claude Code's session records and the host each time, never stored.
RUNS="$STATE/runs"

run_ok() { case "$1" in ""|.|..|*[!A-Za-z0-9_%.-]*) return 1 ;; esac; }

run_set() { # $1 = run, then <key> <value> pairs; written to a temp file beside it, then moved
  local run=$1 f tmp
  run_ok "$run" || return 1
  shift
  mkdir -p "$RUNS" && tmp=$(mktemp "$RUNS/.tmp.XXXXXX") || return 1
  f="$RUNS/$run"
  [ -f "$f" ] && cat "$f" > "$tmp"
  while [ $# -ge 2 ]; do
    J_V=$(printf '%s' "$2" | tr '\n' ' ') awk -v k="$1" '
      index($0, k ": ") == 1 || $0 == k ":" { if (!done) print k ": " ENVIRON["J_V"]; done = 1; next }
      {print} END { if (!done) print k ": " ENVIRON["J_V"] }' "$tmp" > "$tmp.n" && mv "$tmp.n" "$tmp"
    shift 2
  done
  mv "$tmp" "$f"
}

run_get() { # $1 = run, $2 = key
  run_ok "$1" && [ -f "$RUNS/$1" ] || return 0
  awk -v k="$2" 'index($0, k ": ") == 1 {print substr($0, length(k) + 3); exit}' "$RUNS/$1"
}

runs_of() { # $1 = brief, $2 = only runs in this state: the runs spawned from that brief, oldest first
  local b=$1 s=${2:-}
  set -- "$RUNS"/*
  [ -f "$1" ] || return 0
  awk -v b="$b" -v s="$s" '
    FNR == 1 { n++; f[n] = FILENAME; sub(/.*\//, "", f[n]) }
    index($0, "brief: ") == 1 { br[n] = substr($0, 8) }
    index($0, "state: ") == 1 { st[n] = substr($0, 8) }
    index($0, "spawned: ") == 1 { sp[n] = substr($0, 10) + 0 }
    END { for (i = 1; i <= n; i++) if (br[i] == b && (s == "" || st[i] == s)) print sp[i] + 0, f[i] }' "$@" \
    | sort -n | awk '{print $2}'
}

lstart_of() { # $1 = pid: its start time as ps tells it in UTC, spaces as _; empty if gone or a zombie
  TZ=UTC LC_ALL=C ps -o stat=,lstart= -p "$1" 2>/dev/null | awk '$1 !~ /^Z/ && NF >= 6 {print $2 "_" $3 "_" $4 "_" $5 "_" $6}'
}

same_proc() { [ -n "$2" ] && [ "$(lstart_of "$1")" = "$2" ]; } # $1 pid, $2 its start time: still that process?

start_epoch() { # $1 = a start time from lstart_of
  local t; t=$(printf '%s' "$1" | tr _ ' ')
  date -j -u -f '%a %b %d %T %Y' "$t" +%s 2>/dev/null || date -u -d "$t" +%s 2>/dev/null
}

ancestors() { # this command's PID and those of the processes above it
  local p=$$
  while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    printf '%s ' "$p"; p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
}

# "<pid> <procstart> <session> <status>" for each live Claude process whose cwd is
# this checkout, from Claude Code's session records (sessions/<pid>.json). They are
# undocumented: used when present. A record names its process's start time
# (procStart, UTC), so a PID reused since then doesn't match; a record without one
# matches only a process whose command line runs claude.
claude_here() {
  local a b d f recs="" q
  have jq || return 0
  q='select(type == "object" and .pid != null and .sessionId != null)
     | [(.pid | tostring), .sessionId, (.cwd // ""), (.procStart // ""), (.status // "")] | @tsv'
  a=$(cd "$CLAUDE_DIR/sessions" 2>/dev/null && pwd -P)
  b=$(cd "$HOME/.claude/sessions" 2>/dev/null && pwd -P)
  [ "$a" = "$b" ] && b=""
  for d in "$a" "$b"; do
    [ -n "$d" ] || continue
    set -- "$d"/*.json
    [ -f "$1" ] || continue
    # one jq for the lot; file by file only if one of them doesn't parse
    recs="$recs$(jq -r "$q" "$@" 2>/dev/null || for f; do jq -r "$q" "$f" 2>/dev/null; done)
"
  done
  [ -n "$recs" ] || return 0
  TZ=UTC LC_ALL=C ps -axww -o pid=,uid=,stat=,lstart=,command= 2>/dev/null \
    | J_RECS="$recs" J_UID=$(id -u) J_ROOT="$ROOT" J_PHYS=$(pwd -P) awk '
      BEGIN {
        n = split(ENVIRON["J_RECS"], r, "\n")
        for (i = 1; i <= n; i++) {
          if (split(r[i], f, "\t") < 3 || (f[3] != ENVIRON["J_ROOT"] && f[3] != ENVIRON["J_PHYS"])) continue
          ps = f[4]; gsub(/[ \t]+/, " ", ps); sub(/^ /, "", ps); sub(/ $/, "", ps)
          sid[f[1]] = f[2]; start[f[1]] = ps; st[f[1]] = (f[5] == "" ? "-" : f[5])
        }
      }
      $2 == ENVIRON["J_UID"] && ($1 in sid) && $3 !~ /^Z/ {
        ls = $4 " " $5 " " $6 " " $7 " " $8
        if (start[$1] != "") { if (start[$1] != ls) next }
        else { c = $0; for (k = 0; k < 8; k++) sub(/^[ \t]*[^ \t]+[ \t]+/, "", c); if (c !~ /(^|\/)claude( |$)/) next }
        gsub(/ /, "_", ls); print $1, ls, sid[$1], st[$1]
      }'
}

run_by_start() { # $1 = brief, $2 = a process's start time: the run of that brief spawned last before it
  local t r s best="" bs=-1
  t=$(start_epoch "$2")
  [ -n "$t" ] || return 0
  for r in $(runs_of "$1"); do
    s=$(run_get "$r" spawned); case "$s" in ""|*[!0-9]*) s=0 ;; esac
    if [ "$s" -le $((t + 1)) ] && [ "$s" -gt "$bs" ]; then best=$r; bs=$s; fi
  done
  echo "$best"
}

merged_at() { # $1 = a handoff in handoffs/merged/: when it was added there (its commit, else its mtime)
  local t
  [ -f "$1" ] || return 0
  t=$(git log --diff-filter=A --format=%ct -1 -- "$1" 2>/dev/null)
  [ -n "$t" ] || t=$(mtime "$1")
  [ "$t" != 0 ] && echo "$t"
}

# Someone resuming a finished worker's transcript later (claude --resume) runs a
# new process with the worker's session. One that started more than 60 s after
# the run ended is never the run's worker.
after_end() { # $1 = a start time from lstart_of, $2 = when the run ended (epoch; empty = it hasn't)
  local t
  case "$2" in ""|*[!0-9]*) return 1 ;; esac
  t=$(start_epoch "$1")
  [ -n "$t" ] && [ "$t" -gt $(($2 + 60)) ]
}

# The Claude processes of a run, as claude_here lines. A session is the run's when
# the prompt hook saw it in the run's terminal, or, when no terminal's record names
# it, when its transcript opens with the spawn prompt for the run's brief (and, if
# the brief was spawned more than once, the run is the last one spawned before the
# process started). Never this command or anything above it, nor a process that
# started after the run ended (after_end).
agent_procs() { # $1 = run
  local run=$1 brief n=0 anc end pid ps sid st own
  brief=$(run_get "$run" brief)
  end=$(run_get "$run" ended)
  [ -n "$brief" ] && n=$(runs_of "$brief" | wc -l | tr -d ' ')
  anc=" $(ancestors)"
  claude_here | while read -r pid ps sid st; do
    case "$anc" in *" $pid "*) continue ;; esac
    after_end "$ps" "$end" && continue
    own=$(grep -lxF "$sid" "$STATE"/sessions/* 2>/dev/null)
    if [ -n "$own" ]; then
      printf '%s\n' "$own" | grep -qxF "$STATE/sessions/$run" || continue
    else
      [ -n "$brief" ] && [ "$(brief_of_session "$sid")" = "$brief" ] || continue
      [ "$n" -le 1 ] || [ "$(run_by_start "$brief" "$ps")" = "$run" ] || continue
    fi
    echo "$pid $ps $sid $st"
  done
}

alive_of() { # $1 = agent_procs lines: those whose PID is still the same process
  printf '%s\n' "$1" | while read -r pid ps rest; do
    [ -n "$pid" ] && same_proc "$pid" "$ps" && echo "$pid $ps $rest"
  done
}

has_pid() { printf '%s\n' "$2" | awk -v p="$1" '$1 == p {f = 1} END {exit !f}'; } # $1 pid, $2 lines

term_listed() { host list 2>/dev/null | grep -qxF "$1"; } # unknown (host can't be asked) = not listed

audit() { # $1 action, $2 run, $3 brief, $4 target (terminal=… | pid=… procstart=…), $5 result
  mkdir -p "$STATE" && printf '%s %s run=%s brief=%s %s result=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "${3:--}" "$4" "$5" >> "$STATE/audit.log"
}

signal_procs() { # $1 = TERM | KILL, $2 = agent_procs lines, $3 run, $4 brief; each re-checked first
  local pid ps r
  printf '%s\n' "$2" | while read -r pid ps _; do
    [ -n "$pid" ] || continue
    if ! same_proc "$pid" "$ps"; then r="skipped: no longer that process"
    elif kill "-$1" "$pid" 2>/dev/null; then r="$1 sent"
    else r="$1 failed"; fi
    audit signal "$3" "$4" "pid=$pid procstart=$ps" "$r"
  done
}

# Stop agent processes that should have gone (alive_of lines): TERM, up to 10 s, then
# KILL, each re-checked just before its signal. Prints "<pid> <what happened>" for each.
reap_left() { # $1 = alive_of lines, $2 run, $3 brief
  local hard i=0 pid
  signal_procs TERM "$1" "$2" "$3"
  while [ $i -lt 10 ] && [ -n "$(alive_of "$1")" ]; do sleep 1; i=$((i + 1)); done
  hard=$(alive_of "$1")
  [ -n "$hard" ] && signal_procs KILL "$hard" "$2" "$3" && sleep 1
  for pid in $(printf '%s\n' "$1" | awk '{print $1}'); do
    if has_pid "$pid" "$(alive_of "$hard")"; then echo "$pid still running after KILL"
    elif has_pid "$pid" "$hard"; then echo "$pid stopped (KILL)"
    else echo "$pid stopped (TERM)"; fi
  done
}

# Close a run's terminal and make sure its agent went: note the run's Claude
# processes first, close (its error kept), then wait up to JARVIS_STOP_GRACE s for
# the terminal to leave the host's list and each process to exit. One still there
# is stopped, TERM then KILL after 10 s (JARVIS_REAP=1), or named (0). Prints what
# happened as one fragment of the caller's line; fails when the close did.
stop_run() { # $1 = run, $2 = merged | closed, $3 = why
  local run=$1 brief procs err out ok=0 i=0 left pid r
  brief=$(run_get "$run" brief)
  procs=$(agent_procs "$run")
  if err=$(host close "$run" 2>&1 >/dev/null); then
    ok=1; out="closed $(short "$run")"
    audit close "$run" "$brief" "terminal=$run" ok
  else
    err=$(printf '%s\n' "$err" | sed -e 's/^jarvis: //' | grep -v '^[[:space:]]*$' | head -n 1)
    out="close FAILED for $(short "$run"): ${err:-the host gave no reason}"
    audit close "$run" "$brief" "terminal=$run" "FAILED: ${err:-no reason given}"
  fi
  if [ $ok = 1 ]; then
    while [ $i -lt "$JARVIS_STOP_GRACE" ] && { term_listed "$run" || [ -n "$(alive_of "$procs")" ]; }; do
      sleep 1; i=$((i + 1))
    done
    term_listed "$run" && out="$out · terminal $(short "$run") still listed after $JARVIS_STOP_GRACE s"
  fi
  left=$(alive_of "$procs")
  if [ -n "$left" ] && [ "$JARVIS_REAP" = 1 ]; then
    while read -r pid r; do
      [ -n "$pid" ] && out="$out · worker pid $pid didn't exit on close: $r"
    done <<EOF
$(reap_left "$left" "$run" "$brief")
EOF
  elif [ -n "$left" ]; then
    for pid in $(printf '%s\n' "$left" | awk '{print $1}'); do
      out="$out · worker pid $pid didn't exit on close: still running (JARVIS_REAP=0; stop it: kill $pid)"
      audit list "$run" "$brief" "pid=$pid procstart=$(lstart_of "$pid")" "left running (JARVIS_REAP=0)"
    done
  fi
  run_set "$run" state "$2" ended "$(now)" reason "$3" outcome "$out"
  echo "$out"
  [ $ok = 1 ]
}

# Every worker terminal of a brief that may still be open: its running runs, then,
# for briefs spawned before the registry, the started: terminal and the Running
# workers line (read before merge drops it), unless the registry says it has ended.
brief_runs() { # $1 = brief
  { runs_of "$1" running
    brief_terminal "$1"
    running_lines | awk -v b="$1" '{n = split($0, f, " · "); for (i = 1; i <= n; i++) if (f[i] == b) print}' \
      | sed -n 's/.*· term \([^ ]*\) ·.*/\1/p'
  } | awk 'NF && !seen[$0]++' | while read -r r; do
    case "$(run_get "$r" state)" in ""|running) echo "$r" ;; esac
  done
}

# ---------------------------------------------------------------- merge

listed_files() { # the paths under "## Files" in a handoff
  awk '/^## /{on = ($0 ~ /^## Files/); next} on && /^[[:space:]]*[-*] /' "$1" \
    | sed -E -e 's/^[[:space:]]*[-*][[:space:]]+//' -e 's/`//g' \
             -e 's/[[:space:]]+(—|–|--|-|\().*$//' -e 's/[[:space:]]+$//' \
    | grep -v '^path/relative' | grep -v '^$'
}

changed_paths() { # every changed/untracked path, renames as their new path
  git status --porcelain -uall 2>/dev/null | cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//'
}

cmd_merge() {
  local ho="" check=0 msg="" outcome="" push="$JARVIS_PUSH" keep=0 force=0
  local status brief agent files f bad=0 other title dest trailer sha runs r frag note old_tracked=0 closed line
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      -m) msg="${2:-}"; shift 2 ;;
      --outcome) outcome="${2:-}"; shift 2 ;;
      --no-push) push=0; shift ;;
      --keep-open) keep=1; shift ;;
      --force) force=1; shift ;;
      *) ho="$1"; shift ;;
    esac
  done
  [ -f "$ho" ] || die "usage: jarvis merge <handoffs/file.md> [--check] [-m msg] [--outcome clean|corrected|escalated|respawned] [--no-push] [--keep-open]"
  status=$(field status "$ho" | awk '{print $1}')
  brief=$(field brief "$ho" | awk '{print $1}')
  agent=$(field agent "$ho")
  files=$(listed_files "$ho")
  [ -n "$files" ] || die "$ho lists no files under ## Files"

  echo "$ho · status: $status · brief: ${brief:-none}"
  for f in $files; do
    if changed_paths | grep -qxF "$f"; then :; else
      echo "  ✗ listed but not changed: $f"; bad=1
    fi
  done
  other=$(changed_paths | grep -v "^$H/" | grep -vxF "$files")
  if [ -n "$other" ]; then
    echo "  other changes in the checkout (another worker's, or missing from this list):"
    printf '%s\n' "$other" | head -n 12 | sed 's/^/    /'
  fi
  git diff --stat -- $files 2>/dev/null | sed 's/^/  /'
  for f in $files; do
    git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || [ ! -f "$f" ] || echo "   new: $f ($(wc -l < "$f" | tr -d ' ') lines)"
  done
  [ $check = 1 ] && exit $bad

  [ "$status" = blocked ] && die "status is blocked — answer its questions first"
  [ $bad = 1 ] && [ $force = 0 ] && die "file list doesn't match git status — send it back, or --force"

  mkdir -p "$H/merged"
  dest="$H/merged/$(basename "$ho")"
  runs=""; [ -n "$brief" ] && runs=$(brief_runs "$brief")
  [ -n "$brief" ] && open_drop "$brief"
  open_drop "$(basename "$ho")"
  git ls-files --error-unmatch -- "$ho" >/dev/null 2>&1 && old_tracked=1
  mv "$ho" "$dest"
  # a handoff that lists itself would be staged at the path it just left
  set -- $(printf '%s\n' $files | grep -vxF "$ho") "$dest"
  [ $old_tracked = 1 ] && set -- "$@" "$ho"
  [ -n "$brief" ] && [ -f "$brief" ] && set -- "$@" "$brief"
  [ -f "$OPEN" ] && set -- "$@" "$OPEN"
  git add -A -- "$@" || die "git add failed"

  title=$(sed -n '1s/^#[[:space:]]*//p' "$dest")
  [ -n "$msg" ] || msg="$title"
  trailer=""
  case "$agent" in
    claude*) trailer="Co-Authored-By: Claude Code <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    codex*) trailer="Co-Authored-By: Codex <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
    opencode*) trailer="Co-Authored-By: OpenCode <$(printf '%s' "$agent" | awk '{print $2}')> worker" ;;
  esac
  if [ -n "$trailer" ]; then
    git commit -q -m "$msg" -m "$trailer" -- "$@" || die "commit failed"
  else
    git commit -q -m "$msg" -- "$@" || die "commit failed"
  fi
  sha=$(git rev-parse --short HEAD)
  line="merged $sha · $(printf '%s\n' $files | wc -l | tr -d ' ') files"

  if [ "$push" = 1 ]; then
    if git push -q 2>/dev/null; then line="$line · pushed"; else line="$line · push FAILED (run git push)"; fi
  else
    line="$line · not pushed"
  fi
  closed=0; note=""
  if [ -z "$runs" ]; then
    note="no worker terminal recorded for ${brief:-this handoff (it names no brief)}: nothing closed. If one is open: handoffs/bin/jarvis close <terminal>"
  elif [ $keep = 1 ]; then
    note="--keep-open: nothing closed; still open: $(printf "%s\n" "$runs" | tr "\n" " "). Later: handoffs/bin/jarvis close <terminal>"
  elif [ -z "$HOST" ]; then
    note="no host here, so nothing closed: $(printf "%s\n" "$runs" | tr "\n" " ")"
  else
    closed=1
    for r in $runs; do
      # a terminal from before the registry gets a record, so the close is verified and kept
      [ -f "$RUNS/$r" ] || run_set "$r" run "$r" brief "$brief" host "$HOST" state running
      frag=$(stop_run "$r" merged "merged $sha") || closed=0
      line="$line · $frag"
    done
  fi
  if [ -n "$outcome" ] && [ -x "$BIN/jev.sh" ] && [ -n "$brief" ]; then
    "$BIN/jev.sh" outcome "$brief" "$outcome" >/dev/null 2>&1
  fi
  echo "$line · OPEN.md updated in the same commit"
  [ -n "$note" ] && echo "$note"
  [ -n "$brief" ] && [ -f "$brief" ] && merge_leftovers "$brief" "$dest" "$closed"
  return 0
}

# ---------------------------------------------------------------- read / send / close

cmd_read() {
  [ -n "${1:-}" ] || die "usage: jarvis read <terminal> [<lines>]"
  host read "$1" "${2:-80}"
}

cmd_send() {
  [ $# -ge 2 ] || die "usage: jarvis send <terminal> <text> | jarvis send <terminal> --keys <k,k>"
  if [ "$2" = --keys ]; then host send "$1" --keys "${3:-}"; else host send "$1" "$2"; fi
}

cmd_close() { # a worker given up on; a merged one is closed by merge
  local run=${1:-} brief="" b out
  [ -n "$run" ] || die "usage: jarvis close <terminal>"
  need_host
  [ "$run" = "$(jarvis_terminal)" ] && die "$run is Jarvis's own terminal"
  if [ ! -f "$RUNS/$run" ]; then
    # a terminal from before the registry: its brief from Running workers or a started: line
    brief=$(running_lines | grep -F "· term $run ·" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    if [ -z "$brief" ]; then
      for b in "$H"/briefs/*.md; do [ "$(brief_terminal "$b")" = "$run" ] && { brief=$b; break; }; done
    fi
    run_set "$run" run "$run" brief "$brief" host "$HOST" state running
  fi
  if out=$(stop_run "$run" closed "jarvis close"); then
    open_drop "term $run "
    echo "$out · dropped it from Running workers"
  else
    echo "$out"; exit 1
  fi
}

# ---------------------------------------------------------------- doctor

# What is alive in this checkout and why it is still there, from Claude Code's
# session records (claude_here: one ps), one host list and the run registry.
# Read-only. --apply acts only on what Jarvis positively owns and has finished: a
# merged/closed run's open terminal (stop_run), a finished worker's verified agent
# whose terminal is gone (TERM, then KILL), a running run whose terminal is gone and
# that has no agent (marked lost). A busy agent, a session that isn't a worker's and
# a terminal nobody recorded are reported, never touched. Each action is printed and
# audited. `status` (and so `start`) prints the --quiet line: the reconciliation
# after Jarvis crashes or restarts.

doc_merged() { # $1 = brief: its handoff in handoffs/merged/, if any
  grep -l "^brief:[[:space:]]*$1[[:space:]]*\$" "$H"/merged/*.md 2>/dev/null | head -n 1
}

doc_up() { # $1 = a start time from lstart_of: how long ago, e.g. 3d04h, 2h05m, 7m
  local e s
  e=$(start_epoch "$1")
  [ -n "$e" ] || { echo "?"; return; }
  s=$(( $(now) - e ))
  if [ $s -ge 86400 ]; then printf '%dd%02dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ $s -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else printf '%dm' $((s / 60)); fi
}

# "<pid> <procstart> <session> <status> <class> <run> <brief> <terminal>" for each
# claude_here line, "-" for an empty field; class is jarvis | running | finished |
# resumed | other. The run is the registry's. A worker from before the registry has
# none: its brief comes from its transcript, its terminal from its prompt hook or
# brief. Jarvis is the session its prompt hook recorded or, when this runs in
# Jarvis's terminal, the Claude process above this command. A worker's session in a
# process that started after its run ended (the registry's ended, or when the
# handoff went into merged/) is resumed: someone reopened the transcript later.
doc_procs() { # $1 = Jarvis's terminal
  local jt=$1 jsid="" anc="" pid ps sid st t b r n class term e
  have jq && jsid=$(jq -r '.session_id // empty' "$STATE/session.json" 2>/dev/null)
  [ -n "$jt" ] && [ -n "$HOST" ] && [ "$("${HOST}_self" 2>/dev/null)" = "$jt" ] && anc=" $(ancestors)"
  claude_here | while read -r pid ps sid st; do
    t=$(grep -lxF "$sid" "$STATE"/sessions/* 2>/dev/null | head -n 1); t=${t##*/}
    r=""; b=""; class=other; term=""
    if [ "$sid" = "$jsid" ] || { [ -n "$jt" ] && [ "$t" = "$jt" ]; } || case "$anc" in *" $pid "*) true ;; *) false ;; esac
    then class=jarvis; term=$jt
    elif [ -n "$t" ] && run_ok "$t" && [ -f "$RUNS/$t" ]; then r=$t
    elif b=$(brief_of_session "$sid"); then
      n=$(runs_of "$b" | wc -l | tr -d ' ')
      if [ "$n" = 1 ]; then r=$(runs_of "$b"); elif [ "$n" -gt 1 ]; then r=$(run_by_start "$b" "$ps"); fi
      [ -n "$r" ] || term=${t:-$(brief_terminal "$b")}
    fi
    if [ -n "$r" ]; then
      term=$r; b=$(run_get "$r" brief)
      case "$(run_get "$r" state)" in merged|closed) class=finished ;; *) class=running ;; esac
    elif [ -n "$b" ]; then
      if [ -n "$(doc_merged "$b")" ]; then class=finished; else class=running; fi
    fi
    e=""
    if [ -n "$r" ]; then e=$(run_get "$r" ended)
    elif [ "$class" = finished ]; then e=$(merged_at "$(doc_merged "$b")"); fi
    after_end "$ps" "$e" && class=resumed
    echo "$pid $ps $sid $st $class ${r:--} ${b:--} ${term:--}"
  done
}

# "<terminal> <class> <run> <brief>" for each terminal the host lists; class is
# jarvis | running | finished | unknown (cmd_doctor makes a finished one resumed
# when it is a resumed session's terminal or of its brief). With no run record, a terminal is a
# worker's when a brief's started: line or a Running workers line names it.
doc_terms() { # $1 = host list, $2 = Jarvis's terminal
  local id b legacy
  legacy=$(grep -H '^started:.*terminal:' "$H"/briefs/*.md 2>/dev/null \
    | sed -n 's/^\([^:]*\):started:.*terminal:[[:space:]]*\([^ ]*\).*/\2 \1/p')
  printf '%s\n' "$1" | while read -r id; do
    [ -n "$id" ] || continue
    if [ "$id" = "$2" ]; then echo "$id jarvis - -"; continue; fi
    if run_ok "$id" && [ -f "$RUNS/$id" ]; then
      b=$(run_get "$id" brief)
      case "$(run_get "$id" state)" in
        merged|closed) echo "$id finished $id ${b:--}" ;;
        running) echo "$id running $id ${b:--}" ;;
        *) echo "$id unknown $id ${b:--}" ;; # a lost run's terminal back in the list: look, don't touch
      esac
      continue
    fi
    b=$(printf '%s\n' "$legacy" | awk -v t="$id" '$1 == t {print $2}' | tail -n 1)
    [ -n "$b" ] || b=$(running_lines | grep -F "· term $id ·" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
    if [ -z "$b" ]; then echo "$id unknown - -"
    elif [ -n "$(doc_merged "$b")" ]; then echo "$id finished - $b"
    else echo "$id running - $b"; fi
  done
}

doc_lost() { # $1 = host list, $2 = doc_procs lines: "<run> <brief>" for each running run with neither
  local f r
  for f in "$RUNS"/*; do
    [ -f "$f" ] || continue
    r=${f##*/}
    [ "$(run_get "$r" state)" = running ] || continue
    printf '%s\n' "$1" | grep -qxF "$r" && continue
    printf '%s\n' "$2" | awk -v r="$r" '$6 == r {f = 1} END {exit !f}' && continue
    echo "$r $(run_get "$r" brief)"
  done
}

doc_locks() { # the held and queued leases of this checkout's classes and the machine's
  have perl || return 0
  (cmd_resources) 2>/dev/null | J_ROOT="$ROOT" J_PHYS=$(pwd -P) awk '
    /^[^ ]/ { i = index($0, " · "); w = (i ? substr($0, i + length(" · ")) : "")
              on = (w == "machine" || w == ENVIRON["J_ROOT"] || w == ENVIRON["J_PHYS"]); head = $0; shown = 0; next }
    on && ($0 ~ /^  slot [0-9]+  held/ || $0 ~ /^  queue [1-9]/) { if (!shown) print "  " head; shown = 1; print "  " $0 }'
}

doc_brief() { if [ "$1" = - ]; then echo "?"; else basename "$1" .md; fi; } # $1 = brief path or -

cmd_doctor() {
  local apply=0 quiet=0 jt open="" listed=0 procs terms="" lost="" titles="" anc n1 n2 n3 out
  local pid ps sid st class run brief term id r s
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) apply=1 ;;
      --quiet) quiet=1 ;;
      *) die "usage: jarvis doctor [--apply | --quiet]" ;;
    esac
    shift
  done
  jt=$(jarvis_terminal)
  [ -n "$HOST" ] && open=$(host list 2>/dev/null) && listed=1
  procs=$(doc_procs "$jt")
  if [ $listed = 1 ]; then terms=$(doc_terms "$open" "$jt"); lost=$(doc_lost "$open" "$procs"); fi
  # a finished terminal of a brief whose session was resumed may be where it runs now: resumed, left open
  terms=$(printf '%s\n' "$terms" | J_RT="$(printf '%s\n' "$procs" | awk '$5 == "resumed" {print $8; print "brief " $7}')" awk '
    BEGIN { n = split(ENVIRON["J_RT"], r, "\n"); for (i = 1; i <= n; i++) if (r[i] != "-" && r[i] != "brief -") rt[r[i]] = 1 }
    NF { if ($2 == "finished" && (($1 in rt) || (("brief " $4) in rt))) $2 = "resumed"; print }')
  n1=$(printf '%s\n' "$procs" | awk '$5 == "finished"' | wc -l | tr -d ' ')
  n2=$(printf '%s\n' "$terms" | awk '$2 == "finished"' | wc -l | tr -d ' ')
  n3=$(printf '%s\n' "$lost" | awk 'NF' | wc -l | tr -d ' ')

  if [ $quiet = 1 ]; then
    [ $((n1 + n2 + n3)) -gt 0 ] || return 0
    out=""
    [ "$n1" -gt 0 ] && out="$out · $n1 finished worker$([ "$n1" = 1 ] || echo s) still running"
    [ "$n2" -gt 0 ] && out="$out · $n2 finished terminal$([ "$n2" = 1 ] || echo s) open"
    [ "$n3" -gt 0 ] && out="$out · $n3 lost run$([ "$n3" = 1 ] || echo s)"
    echo "doctor: ${out# · } — handoffs/bin/jarvis doctor"
    return 0
  fi

  echo "agent processes (Claude, in this checkout):"
  [ -n "$procs" ] || echo "  none"
  printf '%s\n' "$procs" | while read -r pid ps sid st class run brief term; do
    [ -n "$pid" ] || continue
    printf '  pid %s · up %s · %s · session %s · ' "$pid" "$(doc_up "$ps")" "${st#-}" "$(short "$sid")"
    case "$class" in
      jarvis) echo "Jarvis" ;;
      other) echo "not a worker (left alone)" ;;
      resumed) echo "resumed after its brief finished (left alone) · $(doc_brief "$brief")" ;;
      running|finished)
        [ "$class" = finished ] && printf 'worker, FINISHED' || printf 'worker, running'
        printf ' · %s · ' "$(doc_brief "$brief")"
        if [ "$run" != - ]; then printf 'run %s (%s)' "$(short "$run")" "$(run_get "$run" state)"
        else printf 'no run record%s' "$([ "$class" = finished ] && echo ', handoff merged')"; fi
        case "$st" in busy|shell) [ "$class" = finished ] && printf ' · %s: left alone' "$st" ;; esac
        echo ;;
    esac
  done

  echo "terminals${HOST:+ on $HOST}:"
  if [ $listed = 0 ]; then
    echo "  the host can't be asked${HOST:- (no host)}: terminals and lost runs not checked"
  else
    [ -n "$terms" ] || echo "  none"
    printf '%s\n' "$terms" | awk '$2 == "unknown"' | grep -q . && type "${HOST}_titles" >/dev/null 2>&1 \
      && titles=$(host titles 2>/dev/null)
    printf '%s\n' "$terms" | while read -r id class run brief; do
      [ -n "$id" ] || continue
      printf '  %s · ' "$(short "$id")"
      case "$class" in
        jarvis) echo "Jarvis" ;;
        running) echo "worker, running · $(doc_brief "$brief")$([ "$run" = - ] && echo ' · no run record')" ;;
        finished|resumed)
          printf 'FINISHED but open · %s · %s' "$(doc_brief "$brief")" "$(if [ "$run" = - ]; then echo 'no run record, handoff merged'; else run_get "$run" state; fi)"
          [ "$class" = resumed ] && printf ' · a session resumed there after the brief finished (left alone)'
          echo ;;
        *) printf 'unknown (left alone)%s' "$([ "$run" != - ] && echo " · run $(run_get "$run" state) · $(doc_brief "$brief")")"
           s=$(printf '%s\n' "$titles" | awk -F '\t' -v t="$id" '$1 == t {print $2; exit}')
           [ -n "$s" ] && printf ' · "%s"' "$s"
           echo ;;
      esac
    done
  fi

  echo "registry:"
  if [ -n "$lost" ]; then
    printf '%s\n' "$lost" | while read -r r brief; do
      [ -n "$r" ] && echo "  run $(short "$r") · lost: running, but its terminal is gone and no agent of it is alive · $(doc_brief "${brief:--}")"
    done
  elif [ $listed = 1 ]; then echo "  no lost runs"
  else echo "  not checked (no host list)"; fi

  out=$(cmd_leftovers --quiet)
  echo "leftovers:"; if [ -n "$out" ]; then printf '%s\n' "$out" | sed 's/^/  /'; else echo "  none"; fi
  out=$(doc_locks)
  echo "locks:"; if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "  none held or queued here or machine-wide"; fi
  fable_status | grep -v 'blocked (backstop on)'

  if [ $apply = 0 ]; then
    [ $((n1 + n2 + n3)) -gt 0 ] && echo "act on the FINISHED and lost ones (nothing else is touched): handoffs/bin/jarvis doctor --apply"
    return 0
  fi

  # 1. a finished run's terminal still open: close it; stop_run stops its agent if it survives
  anc=" $(ancestors)"
  printf '%s\n' "$terms" | while read -r id class run brief; do
    [ "$class" = resumed ] && { echo "doctor: skipped $(short "$id"): a session resumed there after the brief finished"; continue; }
    [ "$class" = finished ] || continue
    s=$(printf '%s\n' "$procs" | awk -v t="$id" '$8 == t && ($4 == "busy" || $4 == "shell") {print $1}' | tr '\n' ' ')
    if [ -n "$s" ]; then echo "doctor: left $(short "$id") open: its agent is busy (pid ${s% })"; continue; fi
    if [ "$run" = - ]; then # ended, so stop_run's agent_procs leaves a resumed session alone
      run_set "$id" run "$id" brief "$brief" host "$HOST" state running ended "$(merged_at "$(doc_merged "$brief")")"
      s=merged
    else s=$(run_get "$id" state); fi
    echo "doctor: $(stop_run "$id" "$s" "jarvis doctor --apply" </dev/null) ($(doc_brief "$brief"), finished)"
  done
  # 2. a finished worker's agent whose terminal is gone: TERM, then KILL
  printf '%s\n' "$procs" | while read -r pid ps sid st class run brief term; do
    [ "$class" = finished ] || continue
    case "$anc" in *" $pid "*) continue ;; esac
    if [ $listed = 0 ]; then echo "doctor: left finished worker pid $pid: the host can't say whether its terminal is open"; continue; fi
    [ "$term" != - ] && printf '%s\n' "$open" | grep -qxF "$term" && continue # step 1 had it
    case "$st" in busy|shell) echo "doctor: left finished worker pid $pid running: it is $st"; continue ;; esac
    r=$run; [ "$r" != - ] || r=$term
    reap_left "$pid $ps $sid $st" "$r" "$brief" </dev/null | while read -r pid s; do
      echo "doctor: finished worker pid $pid ($(doc_brief "$brief"), terminal gone): $s"
    done
  done
  # 3. a running run with no terminal and no agent: lost, if that is still so
  printf '%s\n' "$lost" | while read -r r brief; do
    [ -n "$r" ] || continue
    if term_listed "$r" || [ -n "$(agent_procs "$r")" ]; then echo "doctor: left run $(short "$r"): it came back"; continue; fi
    run_set "$r" state lost ended "$(now)" reason "jarvis doctor --apply: terminal gone, no agent alive"
    audit lost "$r" "${brief:--}" "terminal=$r" "marked lost"
    echo "doctor: marked run $(short "$r") lost ($(doc_brief "${brief:--}")): its terminal is gone and no agent of it is alive"
  done
}

# ---------------------------------------------------------------- budgets

# Each worker gets a budget: working minutes (the watcher's ticks in which its screen
# changed, so time spent waiting for the user's answers costs nothing), and for a
# Claude worker its transcripts' API-equivalent estimate (subagents included), its
# last turn's context and its failed test runs; a brief gets JARVIS_BUDGET_ATTEMPTS
# runs. Past one, the watcher asks the worker once for a partial handoff. Still working
# with no handoff JARVIS_BUDGET_GRACE_MIN later, it presses Escape, which interrupts
# the turn (nothing is closed or signalled), and wakes Jarvis. A brief whose run blew
# its budget, or that has used its attempts, needs `spawn --after <handoff>`, or
# --force (logged). A brief's "budget: min=120 usd=25 ctx=350k tests=8 attempts=3"
# header line overrides the defaults; `jarvis budget <run> usd=30` overrides those for
# one run and re-arms its ask and pause.
# $STATE/budget/<run> holds what the watcher counted (key: value lines, as a run);
# <run>.json the transcripts' byte offsets and running totals, kept by
# cc_usage_audit.py --budget, so each read takes only what was appended.
BUD="$STATE/budget"

bud_get() { RUNS=$BUD run_get "$@"; } # $1 run, $2 key
bud_set() { RUNS=$BUD run_set "$@"; } # $1 run, then <key> <value> pairs

budget_kv() { # $1 = key=value → BK, BV (ctx may end in k); fails on anything else
  case "$1" in *=*) ;; *) return 1 ;; esac
  BK=${1%%=*}; BV=${1#*=}
  case "$BK$BV" in ctx*[kK]) BV="${BV%?}000" ;; esac
  case "$BK" in
    usd) printf '%s' "$BV" | grep -Eq '^[0-9]+(\.[0-9]+)?$' ;;
    min|ctx|tests|attempts) case "$BV" in ""|*[!0-9]*) return 1 ;; esac ;;
    *) return 1 ;;
  esac
}

# shellcheck disable=SC2034 # BL_* and U_* are read through eval, in budget_hit and budget_fmt
budget_limits() { # $1 = brief, $2 = run (optional): sets BL_min BL_usd BL_ctx BL_tests BL_attempts
  local kv
  BL_min=$JARVIS_BUDGET_MIN BL_usd=$JARVIS_BUDGET_USD BL_ctx=$JARVIS_BUDGET_CTX
  BL_tests=$JARVIS_BUDGET_TESTS BL_attempts=$JARVIS_BUDGET_ATTEMPTS
  set -f
  for kv in $(awk '/^## /{exit} /^budget:/ {sub(/^budget:[[:space:]]*/, ""); if (!/^</) print; exit}' "$1" 2>/dev/null) \
            $(run_get "${2:-}" limits); do
    budget_kv "$kv" && eval "BL_$BK=\$BV"
  done
  set +f
}

budget_find() { # $1 = run: its session when the prompt hook recorded none, from Claude Code's session records
  local sp brief d st sid cwd
  sp=$(run_get "$1" spawned); brief=$(run_get "$1" brief)
  case "$sp" in ""|*[!0-9]*) return 0 ;; esac
  have jq || return 0
  for d in "$CLAUDE_DIR/sessions" "$HOME/.claude/sessions"; do
    set -- "$d"/*.json
    [ -f "$1" ] || continue
    jq -r --argjson t $(( (sp - 5) * 1000 )) \
      'select(type == "object" and (.startedAt // 0) >= $t and .sessionId != null) | "\(.startedAt) \(.sessionId) \(.cwd // "")"' "$@" 2>/dev/null
  done | sort -n | while read -r st sid cwd; do
    [ "$(cd "$cwd" 2>/dev/null && proj_root "$(pwd -P)")" = "$ROOTP" ] || continue
    [ "$(brief_of_session "$sid")" = "$brief" ] && { echo "$sid"; break; }
  done
}

budget_files() { # $1 = run: its transcripts, each session's subagents' included, one per line
  local r=$1 sids sid d f
  sids=$(cat "$STATE/sessions/$r" 2>/dev/null)
  [ -n "$sids" ] || sids=$(bud_get "$r" sid)
  if [ -z "$sids" ]; then sids=$(budget_find "$r"); [ -n "$sids" ] && bud_set "$r" sid "$sids"; fi
  for sid in $sids; do
    for d in "$CLAUDE_DIR/projects/$PROJ" "$HOME/.claude/projects/$PROJ"; do
      [ -f "$d/$sid.jsonl" ] || continue
      printf '%s\n' "$d/$sid.jsonl"
      for f in "$d/$sid"/subagents/*.jsonl; do [ -f "$f" ] && printf '%s\n' "$f"; done
      break
    done
  done
}

budget_measure() { # $1 = run, $2 = now: read its transcripts now, else at most every JARVIS_BUDGET_SEC
  local r=$1 last f d out
  [ "$(run_get "$r" agent)" = claude ] && have python3 || return 0
  last=$(bud_get "$r" measured)
  case "$last" in ""|*[!0-9]*) last=0 ;; esac
  [ "${2:-}" = now ] || [ $(( $(now) - last )) -ge "$JARVIS_BUDGET_SEC" ] || return 0
  d=$(dirname "$0")
  case "$d" in /*) ;; *) d="$JARVIS_CALLER_PWD/$d" ;; esac
  set --
  while IFS= read -r f; do [ -n "$f" ] && set -- "$@" "$f"; done <<EOF
$(budget_files "$r")
EOF
  if [ $# = 0 ]; then bud_set "$r" measured "$(now)"; return 0; fi
  mkdir -p "$BUD" && out=$(python3 "$d/cc_usage_audit.py" --budget "$BUD/$r.json" "$@" 2>/dev/null) || return 0
  set -- $out
  [ $# = 3 ] && bud_set "$r" measured "$(now)" usd "$1" ctx "$2" tests "$3"
}

budget_screen() { # $1 = run, $2 = its screen's checksum: a tick in which the screen changed is working time
  local r=$1 t seen work
  t=$(now); seen=$(bud_get "$r" seen); work=$(bud_get "$r" work)
  case "$seen" in ""|*[!0-9]*) seen="" ;; esac
  case "$work" in ""|*[!0-9]*) work=0 ;; esac
  if [ "$(bud_get "$r" screen)" != "$2" ]; then
    # at most two ticks' worth: a watcher that was stopped didn't see it working
    [ -n "$seen" ] && work=$(( work + (t - seen < 2 * JARVIS_WATCH_SEC ? t - seen : 2 * JARVIS_WATCH_SEC) ))
    bud_set "$r" screen "$2" seen "$t" work "$work" changed "$t"
  else
    bud_set "$r" seen "$t"
  fi
}

# shellcheck disable=SC2034
budget_use() { # $1 = run: U_min U_usd U_ctx U_tests (U_usd empty: no transcript read yet) and its limits
  local r=$1 w
  budget_limits "$(run_get "$r" brief)" "$r"
  w=$(bud_get "$r" work)
  case "$w" in ""|*[!0-9]*) w=0 ;; esac
  U_min=$((w / 60)) U_usd="" U_ctx="" U_tests=""
  [ "$(run_get "$r" agent)" = claude ] || return 0
  U_usd=$(bud_get "$r" usd) U_ctx=$(bud_get "$r" ctx) U_tests=$(bud_get "$r" tests)
}

budget_hit() { # $1 = min | usd | ctx | tests, after budget_use: reached?
  local u l
  eval "u=\${U_$1:-}; l=\$BL_$1"
  [ -n "$u" ] && awk -v u="$u" -v l="$l" 'BEGIN { exit !(u + 0 >= l + 0) }'
}

budget_fmt() { # $1 = key, after budget_use: "<used>/<limit>" as shown
  local u l
  eval "u=\${U_$1:-0}; l=\$BL_$1"
  case "$1" in
    min) printf '%sm/%sm' "$u" "$l" ;;
    usd) awk -v u="$u" -v l="$l" 'BEGIN { printf "$%.1f/$%s", u, l }' ;;
    ctx) awk -v u="$u" -v l="$l" 'BEGIN { printf "%dk/%dk", u / 1000 + 0.5, l / 1000 + 0.5 }' ;;
    *) printf '%s/%s' "$u" "$l" ;;
  esac
}

budget_reached() { # after budget_use: "<which>: <used>/<limit>" for the first budget reached
  local k
  for k in min usd ctx tests; do budget_hit $k && { printf '%s: %s' $k "$(budget_fmt $k)"; return 0; }; done
  return 1
}

hm() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M; } # $1 = epoch

budget_line() { # $1 = run: "42m/90m working (1h50m since spawn) · $6.1/$15 · ctx 180k/300k · tests 1/6"
  local r=$1 sp k s x
  budget_measure "$r" now
  budget_use "$r"
  sp=$(run_get "$r" spawned)
  case "$sp" in ""|*[!0-9]*) sp=$(now) ;; esac
  s="$(budget_fmt min) working ($(dur $(( $(now) - sp ))) since spawn)"
  budget_hit min && s="$s (over)"
  if [ "$(run_get "$r" agent)" = claude ]; then
    if [ -n "$U_usd" ]; then
      for k in usd ctx tests; do
        case $k in ctx) x="ctx $(budget_fmt ctx)" ;; tests) x="tests $(budget_fmt tests)" ;; *) x=$(budget_fmt usd) ;; esac
        budget_hit $k && x="$x (over)"
        s="$s · $x"
      done
    else
      s="$s · no transcript found yet"
    fi
  fi
  x=$(run_get "$r" budget_asked); [ -n "$x" ] && s="$s · asked for a partial handoff $(hm "$x")"
  x=$(run_get "$r" paused); [ -n "$x" ] && s="$s · paused $(hm "$x")"
  printf '%s\n' "$s"
}

budget_handoff() { # $1 = brief, $2 = epoch, $3 = 0: skip blocked ones: a handoff for the brief written since $2
  local ho
  for ho in $(grep -l "^brief:[[:space:]]*$1" "$H"/*.md "$H"/merged/*.md 2>/dev/null); do
    [ "$(mtime "$ho")" -ge "$2" ] || continue
    [ "${3:-1}" = 0 ] && [ "$(field status "$ho")" = blocked ] && continue
    echo "$ho"; return 0
  done
  return 1
}

# The watcher, each tick, per running worker: $1 = run, $2 = the bottom of its screen.
# Counts working time, then asks once, then pauses once. Prints events for Jarvis.
budget_tick() {
  local r=$1 brief asked over t ch sp
  run_ok "$r" && [ -f "$RUNS/$r" ] && [ "$(run_get "$r" state)" = running ] || return 0
  [ -n "$2" ] && budget_screen "$r" "$(printf '%s' "$2" | cksum | cut -d' ' -f1)"
  t=$(now); brief=$(run_get "$r" brief)
  sp=$(run_get "$r" spawned); case "$sp" in ""|*[!0-9]*) sp=0 ;; esac
  asked=$(run_get "$r" budget_asked)
  if [ -z "$asked" ]; then
    # one that has handed off (done or partial) since it was spawned is finished
    budget_handoff "$brief" "$sp" 0 >/dev/null && return 0
    budget_measure "$r"
    budget_use "$r"
    over=$(budget_reached) || return 0
    run_set "$r" budget "${over%%:*} ${over#*: } $t" budget_asked "$t"
    if host send "$r" "[jarvis] Budget reached ($over). Stop the current approach now. Write your handoff with status: partial — what's done, what's left, what you tried that failed and why — then stop." >/dev/null 2>&1; then
      printf ' worker %s hit its %s budget — asked for a partial handoff;' "$(short "$r")" "${over%%:*}"
    else
      printf " worker %s hit its %s budget, and the ask couldn't be typed into its terminal — read it;" "$(short "$r")" "${over%%:*}"
    fi
    return 0
  fi
  [ -z "$(run_get "$r" paused)$(run_get "$r" pause_failed)" ] || return 0
  [ $(( t - asked )) -ge $(( JARVIS_BUDGET_GRACE_MIN * 60 )) ] || return 0
  budget_handoff "$brief" "$asked" >/dev/null && return 0
  # still working: its screen changed within the last two ticks
  ch=$(bud_get "$r" changed); case "$ch" in ""|*[!0-9]*) ch=0 ;; esac
  [ $(( t - ch )) -le $(( 2 * JARVIS_WATCH_SEC )) ] || return 0
  if host send "$r" --keys esc >/dev/null 2>&1; then
    run_set "$r" paused "$t"
    printf ' worker %s paused over budget, no handoff — read its terminal;' "$(short "$r")"
  else
    run_set "$r" pause_failed "$t"
    printf " worker %s is over budget with no handoff, and its terminal took no Escape — read it;" "$(short "$r")"
  fi
}

# spawn: a brief whose run blew its budget, or that has used its attempts, is respawned
# only --after a handoff for it written since its latest run started, or with --force
budget_gate() { # $1 = brief, $2 = --after's handoff or empty, $3 = force (0|1)
  local brief=$1 after=$2 runs r n=0 blown="" last=0 sp why ho
  runs=$(runs_of "$brief")
  for r in $runs; do
    n=$((n + 1))
    [ -n "$(run_get "$r" budget)" ] && blown="$blown${blown:+, }$r ($(run_get "$r" budget | awk '{print $1 " " $2}'))"
    sp=$(run_get "$r" spawned)
    case "$sp" in ""|*[!0-9]*) ;; *) [ "$sp" -gt "$last" ] && last=$sp ;; esac
  done
  budget_limits "$brief"
  if [ -n "$blown" ]; then why="a run of it reached its budget: $blown"
  elif [ "$n" -ge "$BL_attempts" ]; then why="it has used its $BL_attempts attempts ($(echo $runs | sed 's/ /, /g'))"
  else return 0; fi
  if [ -n "$after" ]; then
    [ "$(field brief "$after" | sed 's#^\./##')" = "${brief#./}" ] \
      || die "$brief can't be respawned yet: $why. --after $after isn't a handoff for it (its brief: is '$(field brief "$after")')"
    [ "$(mtime "$after")" -ge "$last" ] \
      || die "$brief can't be respawned yet: $why. --after $after was written before its latest run started: ask that worker for its handoff, or --force"
    return 0
  fi
  if [ "$3" = 1 ]; then
    audit budget-force - "$brief" "runs=$n attempts=$BL_attempts budget=$([ -n "$blown" ] && echo reached || echo -)" passed
    echo "jarvis: --force: past the respawn gate ($why); logged in $STATE/audit.log" >&2
    return 0
  fi
  ho=$(handoff_of "$brief")
  die "$brief can't be respawned yet: $why. Read its partial handoff${ho:+ ($ho)}, sharpen or split the brief, then respawn with --after <that handoff>. --force passes this (logged)."
}

cmd_budget() { # jarvis budget <run> [min=N] [usd=N] [ctx=N[k]] [tests=N]
  local r=${1:-} kv old="" set="" limits b
  [ -n "$r" ] || die "usage: jarvis budget <terminal> [min=N] [usd=N] [ctx=N[k]] [tests=N]"
  run_ok "$r" && [ -f "$RUNS/$r" ] || die "no run $r in $RUNS"
  shift
  [ $# -gt 0 ] || { budget_line "$r"; return 0; }
  for kv; do
    budget_kv "$kv" && [ "$BK" != attempts ] \
      || die "$kv: give min=, usd=, ctx= or tests= a number (attempts is per brief: its budget: line)"
    set="$set $BK=$BV"
  done
  # the new values replace the run's earlier ones, key by key
  for kv in $(run_get "$r" limits); do
    case " $set " in *" ${kv%%=*}="*) ;; *) old="$old $kv" ;; esac
  done
  limits=$(echo $old $set)
  b=$(run_get "$r" budget)
  [ -n "$b" ] && run_set "$r" budget_was "$b"
  run_set "$r" limits "$limits" budget "" budget_asked "" paused "" pause_failed ""
  audit budget-raise "$r" "$(run_get "$r" brief)" "limits=$(printf '%s' "$limits" | tr ' ' ,)" set
  echo "run $(short "$r"): limits $limits; its ask and pause are re-armed"
  budget_line "$r"
}

# ---------------------------------------------------------------- watch

jarvis_idle_min() { # minutes since the Jarvis transcript last changed; empty if unknown
  local tp
  have jq || return
  tp=$(jq -r '.transcript_path // empty' "$STATE/session.json" 2>/dev/null)
  [ -n "$tp" ] && [ -f "$tp" ] || return
  echo $(( ($(now) - $(mtime "$tp")) / 60 ))
}

send_jarvis() { # $1 = text
  host send "$(jarvis_terminal)" "$1" >/dev/null 2>&1
}

watch_running() { # a `jarvis watch` loop for this checkout is alive
  local p
  p=$(cat "$STATE/watch.pid" 2>/dev/null) && [ -n "$p" ] \
    && ps -p "$p" -o command= 2>/dev/null | grep -q "jarvis watch"
}

watch_tick() {
  local seen="$STATE/watch.seen" events="" ho key id tail_ idle term line brief sum scr stale
  touch "$seen"
  for ho in "$H"/*.md; do
    [ -f "$ho" ] || continue
    case "$(basename "$ho")" in OPEN.md|TEMPLATE.md|JARVIS.md) continue ;; esac
    key="$ho $(mtime "$ho") $(field status "$ho")"
    grep -qxF "$key" "$seen" && continue
    echo "$key" >> "$seen"
    events="$events handoff $ho ($(field status "$ho"));"
  done
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | sed -n 's/.*term \([^ ]*\).*/\1/p')
    [ -n "$id" ] || continue
    tail_=$(host read "$id" 15 2>/dev/null | sed -e 's/[[:space:]]*$//')
    events="$events$(budget_tick "$id" "$tail_" </dev/null)"
    [ -n "$tail_" ] || continue
    sum=$(printf '%s' "$tail_" | cksum | cut -d' ' -f1)
    if printf '%s' "$tail_" | grep -Eiq "$LIMIT_RE"; then
      key="limit $id $(date +%Y%m%d%H)"
      grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events usage limit in worker $(short "$id");"; }
    elif printf '%s' "$tail_" | grep -Eiq "$PROMPT_RE"; then
      key="prompt $id $sum"
      grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events worker $(short "$id") is waiting at a prompt — read its terminal;"; }
    else
      # a working agent's screen keeps changing (spinner, timer, output); a frozen one
      # with no handoff is stuck at something the patterns above don't know
      scr="$STATE/screen-$id"
      if [ "$(cat "$scr" 2>/dev/null)" != "$sum" ]; then
        echo "$sum" > "$scr"
      else
        stale=$(( ($(now) - $(mtime "$scr")) / 60 ))
        brief=$(printf '%s' "$line" | grep -o "$H/briefs/[^ ]*\.md" | head -n 1)
        if [ "$stale" -ge "$JARVIS_STALL_MIN" ] && ! grep -lq "^brief:[[:space:]]*${brief:-@@none@@}" "$H"/*.md 2>/dev/null; then
          key="stall $id $sum"
          grep -qxF "$key" "$seen" || { echo "$key" >> "$seen"; events="$events worker $(short "$id")'s screen hasn't changed in ${stale} min and it has no handoff — read its terminal;"; }
        fi
      fi
    fi
  done <<EOF
$(running_lines)
EOF
  [ -n "$events" ] || return 0

  term=$(jarvis_terminal)
  [ -n "$term" ] || { echo "$(date +%H:%M) events but no Jarvis session in $OPEN:$events"; return 0; }
  idle=$(jarvis_idle_min)
  if [ -n "$idle" ] && [ "$idle" -ge "$JARVIS_IDLE_MIN" ]; then
    if type "${HOST}_clear" >/dev/null 2>&1; then host clear "$term" && sleep 5
    else send_jarvis "/clear"; sleep 3
    fi
    send_jarvis "[jarvis watch] Fresh session: Jarvis was idle ${idle} min, so its cache had expired. You are Jarvis — use the jarvis:run skill, read handoffs/JARVIS.md and handoffs/OPEN.md, run handoffs/bin/jarvis status, then handle:$events"
    echo "$(date +%H:%M) cleared Jarvis (idle ${idle} min) and woke it:$events"
  else
    send_jarvis "[jarvis watch]$events"
    echo "$(date +%H:%M) woke Jarvis:$events"
  fi
}

cmd_watch() {
  need_host
  mkdir -p "$STATE"
  if [ "${1:-}" = --once ]; then watch_tick; return; fi
  if [ "${1:-}" = --start ]; then
    watch_running && { echo "jarvis watch is already running (pid $(cat "$STATE/watch.pid"))"; return 0; }
    host run jarvis-watch "handoffs/bin/jarvis watch" && echo "started jarvis watch in its own terminal on $HOST"
    return
  fi
  watch_running && die "jarvis watch is already running (pid $(cat "$STATE/watch.pid"))"
  echo $$ > "$STATE/watch.pid"
  # first pass only learns what's already there
  for ho in "$H"/*.md; do
    [ -f "$ho" ] && echo "$ho $(mtime "$ho") $(field status "$ho")" >> "$STATE/watch.seen"
  done
  echo "jarvis watch: every ${JARVIS_WATCH_SEC}s (handoffs, limits, prompts, workers frozen ${JARVIS_STALL_MIN}+ min); clears Jarvis first after ${JARVIS_IDLE_MIN} min idle. Ctrl-C to stop."
  while :; do sleep "$JARVIS_WATCH_SEC"; watch_tick; done
}

# ---------------------------------------------------------------- fable

# No worker starts on Fable unless the user authorized that exact brief, once, at a
# real terminal: a Claude worker, or any other whose model names fable (an agent of
# jarvis.conf or a Superset agent config may wrap claude). `jarvis fable allow <brief>` reads the brief's slug from /dev/tty,
# which an agent's Bash tool doesn't have, and refuses when an agent CLI is among its
# parent processes or has left its variables in the environment. That is a speed bump,
# not a lock: an agent set on it can still open a pty of its own, detach from its
# parent, or write a record by hand. The layers left then are the audit log, the
# PreToolUse hook (no Fable subagent, no Fable put into a settings allowlist) and the
# backstop: a user-level availableModels without Fable, which Claude Code enforces by
# running the default model instead, Agent-tool overrides included. The backstop alone
# holds against a Bash command editing a settings file and an agent definition's
# model: fable; nothing here checks those.
#
# An authorization is a record in $FABLE_DIR/pending/: the brief's physical path, the
# sha256 of the brief without its started: lines (spawn rewrites those), this
# checkout's root and when it was allowed. Spawn moves it into used/, the run's name
# appended, right before the launch, and host() checks that it did. Anything missing,
# unreadable, edited, from another checkout or older than JARVIS_FABLE_TTL_MIN refuses;
# so does a red band, --force or not. Every allow, deny, consume and revoke is one line
# of $FABLE_DIR/audit.log. Allowlists merge across settings files (an entry in any
# scope lets a model in), so a project or local settings file listing fable undoes the
# backstop: spawn refuses while one exists here, and status and doctor name it.

FABLE_DIR="${JARVIS_HOME:-$HOME/.jarvis}/fable"
FABLE_ALLOWED='["opus","sonnet","haiku"]'   # the backstop's availableModels: aliases cover the full ids
FABLE_SETTINGS='{"availableModels":["opus","sonnet","haiku","fable"]}'   # added to one authorized launch
FABLE_SUPERSET_MSG="Superset can't pass --settings to a single launch, so under the backstop an authorized fable worker would run on Opus. Set JARVIS_FABLE_SUPERSET_AGENT in $H/jarvis.conf (see the comment there), run Jarvis on tmux or Ultron, or use worker: codex, model: gpt-6-astra"
FABLE_REMAP_VARS="ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_SMALL_FAST_MODEL CLAUDE_CODE_SUBAGENT_MODEL"
FABLE_WHY=""
FABLE_REC=""
FABLE_LIFT=0

# $1 agent, $2 model: fable for any agent whose model names it ([…] suffix aside: an
# agent of jarvis.conf, or a Superset agent config, may wrap claude); for claude also
# opus | sonnet | haiku, failing when it can't tell; other for any other agent's model
model_canon() {
  local m
  m=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  case "${m%%\[*}" in *fable*) echo fable; return 0 ;; esac
  [ "$1" = claude ] || { echo other; return 0; }
  printf '%s' "$m" | grep -Eq '^[a-z0-9._:-]+(\[[a-z0-9._:-]*\])?$' || return 1
  case "$m" in *fable*) echo fable; return 0 ;; esac
  m=${m%%\[*}
  case "$m" in
    opus|claude-opus-*) echo opus ;;
    sonnet|claude-sonnet-*) echo sonnet ;;
    haiku|claude-haiku-*) echo haiku ;;
    *) return 1 ;; # best, default, opusplan, empty, unknown: any of them might resolve to Fable
  esac
}

model_refusal() {
  echo "model '$1' isn't one jarvis can resolve for a Claude worker, and an alias it can't resolve might be Fable: use model: claude-opus-5-5, sonnet or haiku"
}

fable_needs() { # $1 = brief
  echo "fable needs your authorization for this brief: run handoffs/bin/jarvis fable allow $1 in your own terminal — or use worker: codex, model: gpt-6-astra"
}

fable_log() { # $1 event, $2 brief, $3 hash, $4 run, $5 reason: one line of the audit log; fails when it can't write
  ( umask 077; mkdir -p "$FABLE_DIR" \
    && printf '%s %s root=%s brief=%s hash=%s run=%s reason=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$ROOT" \
      "${2:--}" "${3:--}" "${4:--}" "$(printf '%s' "${5:--}" | tr '\n' ' ')" >> "$FABLE_DIR/audit.log" ) 2>/dev/null
}

fable_refuse() { # $1 brief, $2 run, $3 reason for the log, $4 message: log a deny, then stop
  fable_log deny "$1" - "$2" "$3"
  die "$4"
}

phys_path() { (cd "$(dirname "$1")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")"); }

brief_hash() { # $1 = brief: sha256 of it without its started: lines
  local h
  [ -r "$1" ] || return 1
  if have shasum; then h=$(grep -v '^started:' "$1" | shasum -a 256)
  elif have sha256sum; then h=$(grep -v '^started:' "$1" | sha256sum)
  else return 1; fi
  h=${h%% *}
  [ ${#h} = 64 ] && echo "$h"
}

rec_get() { awk -v k="$2" 'index($0, k ": ") == 1 {print substr($0, length(k) + 3); exit}' "$1" 2>/dev/null; } # $1 record, $2 key

# The usable pending record for brief $1, in FABLE_REC; else FABLE_WHY says what's wrong.
fable_find() {
  local p h root f t ttl
  FABLE_REC=""
  FABLE_WHY="no authorization for this brief"
  p=$(phys_path "$1") && h=$(brief_hash "$1") || { FABLE_WHY="can't read or hash the brief"; return 1; }
  root=$(cd "$ROOT" && pwd -P)
  ttl=$JARVIS_FABLE_TTL_MIN
  case "$ttl" in ""|*[!0-9]*) ttl=0 ;; esac
  for f in "$FABLE_DIR"/pending/*; do
    [ -f "$f" ] || continue
    [ -r "$f" ] && [ -O "$f" ] || { FABLE_WHY="an authorization record is unreadable or not yours"; continue; }
    [ "$(rec_get "$f" brief)" = "$p" ] && [ "$(rec_get "$f" root)" = "$root" ] || continue
    [ "$(rec_get "$f" hash)" = "$h" ] || { FABLE_WHY="the brief changed after it was authorized"; continue; }
    t=$(rec_get "$f" allowed)
    case "$t" in ""|*[!0-9]*) FABLE_WHY="an authorization record is malformed"; continue ;; esac
    [ $(( $(now) - t )) -lt $((ttl * 60)) ] || { FABLE_WHY="the authorization expired (they last $ttl min)"; continue; }
    FABLE_REC=$f
    return 0
  done
  return 1
}

fable_consume() { # $1 brief, $2 run: use the authorization up, or refuse
  local h u
  fable_find "$1" || fable_refuse "$1" "$2" "consume: $FABLE_WHY" "$(fable_needs "$1") [$FABLE_WHY]"
  h=$(rec_get "$FABLE_REC" hash)
  u="$FABLE_DIR/used/$(basename "$FABLE_REC").$2"
  ( umask 077; mkdir -p "$FABLE_DIR/used" ) 2>/dev/null
  # rename(2): of two spawns racing for one record, one gets it
  mv "$FABLE_REC" "$u" 2>/dev/null && [ ! -e "$FABLE_REC" ] \
    || fable_refuse "$1" "$2" "consume: can't move the record into used/" "$(fable_needs "$1") [its authorization couldn't be used up: is $FABLE_DIR writable?]"
  printf 'consumed: %s\nrun: %s\n' "$(now)" "$2" >> "$u" 2>/dev/null \
    || fable_refuse "$1" "$2" "consume: can't write the used record" "$(fable_needs "$1") [can't write $u]"
  fable_log consume "$1" "$h" "$2" "spawn" \
    || die "$(fable_needs "$1") [can't write the audit log $FABLE_DIR/audit.log]"
}

# Refuse any launch while an alias variable, in this environment or a settings file's
# env, points at Fable, or while this checkout's own settings let Fable in. An agent
# other than `claude` may itself wrap Claude, so the environment is what matters here.
fable_preflight() { # $1 brief, $2 run
  local v val f
  for v in $FABLE_REMAP_VARS; do
    eval "val=\${$v:-}"
    case "$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]')" in
      *fable*) fable_refuse "$1" "$2" "preflight: $v names fable" "$v=$val points a model alias at Fable: unset it before spawning a worker" ;;
    esac
  done
  have jq || fable_refuse "$1" "$2" "preflight: no jq" "jq is needed to check the settings files for Fable"
  # every settings file a worker here reads: user-level (Superset's default account
  # too), project, local. An alias variable in env, or modelOverrides, naming fable.
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    v=$(jq -r --arg vars " $FABLE_REMAP_VARS " '((.env // {}) | if type == "object" then to_entries[] else empty end
        | .key as $k | select(($vars | index(" " + $k + " ")) and (.value | tostring | ascii_downcase | test("fable"))) | $k),
      (if (.modelOverrides // {}) | tostring | ascii_downcase | test("fable") then "modelOverrides" else empty end)' "$f" 2>/dev/null | head -n 1)
    case "$v" in
      "") ;;
      modelOverrides) fable_refuse "$1" "$2" "preflight: $f modelOverrides names fable" "$f has a modelOverrides entry naming Fable: take it out before spawning a Claude worker" ;;
      *) fable_refuse "$1" "$2" "preflight: $f env $v names fable" "$f sets $v to Fable in its env: take it out before spawning a Claude worker" ;;
    esac
  done <<EOF
$(backstop_files)
$ROOT/.claude/settings.json
$ROOT/.claude/settings.local.json
EOF
  f=$(fable_holes | head -n 1)
  [ -z "$f" ] || fable_refuse "$1" "$2" "preflight: $f lists fable" "$f lists fable in availableModels, and allowlists merge across settings files, so it re-opens Fable for every session in this checkout, backstop or not: take it out"
}

fable_holes() { # this checkout's settings files whose availableModels lets Fable in (unparseable + mentions fable counts)
  local f
  for f in .claude/settings.json .claude/settings.local.json; do
    [ -f "$ROOT/$f" ] || continue
    if have jq && jq empty "$ROOT/$f" 2>/dev/null; then
      jq -e '(.availableModels // []) | if type == "array" then map(tostring | ascii_downcase | test("fable")) | any
             else tostring | ascii_downcase | test("fable") end' "$ROOT/$f" >/dev/null 2>&1 && echo "$f"
    else
      grep -qi fable "$ROOT/$f" && echo "$f"
    fi
  done
}

# The final check, from host() before any spawn (cmd_spawn's, a custom host's, a future
# caller's): the model resolves, nothing remaps it, and a Fable run has an authorization
# that spawn used up for this very run in the last two minutes, not yet launched.
# $@ = the spawn arguments: agent model effort prompt name.
fable_final() {
  local canon f u="" c root
  FABLE_LIFT=0
  canon=$(model_canon "$1" "$2") || fable_refuse - "$5" "final check: model '$2' can't be resolved" "$(model_refusal "$2")"
  fable_preflight - "$5"
  [ "$canon" = fable ] || return 0
  root=$(cd "$ROOT" && pwd -P)
  for f in "$FABLE_DIR"/used/*."$5"; do
    [ -f "$f" ] && [ -O "$f" ] && [ "$(rec_get "$f" run)" = "$5" ] && [ "$(rec_get "$f" root)" = "$root" ] || continue
    grep -q '^launched:' "$f" && continue
    c=$(rec_get "$f" consumed)
    case "$c" in ""|*[!0-9]*) continue ;; esac
    [ $(( $(now) - c )) -le 120 ] || continue
    u=$f
    break
  done
  [ -n "$u" ] || fable_refuse - "$5" "final check: no authorization used up for this run" \
    "fable needs your authorization: no authorization was used up for run '$5'. Spawn it with handoffs/bin/jarvis spawn after the user runs handoffs/bin/jarvis fable allow <brief> — or use worker: codex, model: gpt-6-astra"
  printf 'launched: %s\n' "$(now)" >> "$u" 2>/dev/null || fable_refuse - "$5" "final check: can't mark the record launched" "can't write $u"
  FABLE_LIFT=1
}

under_agent() { # prints why, when an agent CLI runs this: its variables, or one among the parent processes
  local v c p
  for v in CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_ENTRYPOINT CLAUDE_PID OPENCODE; do
    eval "c=\${$v:-}"
    [ -z "$c" ] || { echo "$v is set, so this runs inside an agent"; return 0; }
  done
  # CODEX_HOME is the user's own setting; Codex sets other CODEX_ variables for what it runs
  v=$(env | sed -n 's/^\(CODEX_[A-Z0-9_]*\)=.*/\1/p' | grep -vx CODEX_HOME | head -n 1)
  [ -z "$v" ] || { echo "$v is set, so this runs inside an agent"; return 0; }
  for p in $(ancestors); do
    c=$(ps -ww -o command= -p "$p" 2>/dev/null)
    printf '%s\n' "$c" | awk '{ a = $1; sub(/.*\//, "", a); sub(/\.(js|mjs|cjs|exe)$/, "", a)
        if (a ~ /^(claude|codex|opencode)$/ || $1 ~ /\/claude\/versions\// \
            || (a ~ /^(node|bun|deno)$/ && $2 ~ /(claude|codex|opencode)/)) f = 1 }
      END { exit !f }' && { echo "an agent is among this command's parent processes (pid $p: $(printf '%s' "$c" | cut -c1-60))"; return 0; }
  done
  return 1
}

cmd_fable() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    allow) fable_allow "$@" ;;
    list) fable_list ;;
    revoke) fable_revoke "$@" ;;
    backstop) fable_backstop "$@" ;;
    *) die "usage: jarvis fable allow <brief.md> | list | revoke <brief.md> | backstop [--apply]" ;;
  esac
}

fable_allow() {
  local brief="${1:-}" slug title typed p h root rec tmp why
  [ -f "$brief" ] || die "usage: jarvis fable allow <handoffs/briefs/file.md>"
  [ "$(model_canon "$(field worker "$brief" | awk '{print $1}')" "$(field model "$brief" | awk '{print $1}')" 2>/dev/null)" = fable ] \
    || die "$brief isn't a Fable brief (its model: doesn't name fable): nothing to authorize"
  if why=$(under_agent); then
    fable_log deny "$brief" - - "allow: $why"
    die "refused: $why. Only the user authorizes Fable: in your own terminal, run handoffs/bin/jarvis fable allow $brief"
  fi
  { : </dev/tty; } 2>/dev/null || {
    fable_log deny "$brief" - - "allow: no terminal"
    die "refused: there's no terminal to confirm on (/dev/tty won't open). Run it yourself, in your own terminal"
  }
  p=$(phys_path "$brief") && h=$(brief_hash "$brief") || die "can't read or hash $brief"
  root=$(cd "$ROOT" && pwd -P)
  slug=$(basename "$brief" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-//')
  title=$(sed -n '1s/^#[[:space:]]*//p' "$brief")
  printf 'Authorize ONE Fable run of this brief:\n  %s\n  %s\n  in %s\nUsable once, for %s min. Type its slug to confirm: %s\n> ' \
    "$title" "$brief" "$root" "$JARVIS_FABLE_TTL_MIN" "$slug" >/dev/tty
  IFS= read -r typed </dev/tty || typed=""
  if [ "$typed" != "$slug" ]; then
    fable_log deny "$brief" "$h" - "allow: the slug typed didn't match"
    die "not authorized: that isn't the slug"
  fi
  ( umask 077; mkdir -p "$FABLE_DIR/pending" ) 2>/dev/null && chmod 700 "$FABLE_DIR" "$FABLE_DIR/pending" 2>/dev/null \
    && tmp=$(umask 077; mktemp "$FABLE_DIR/pending/.tmp.XXXXXX" 2>/dev/null) || die "can't write $FABLE_DIR/pending: not authorized"
  rec="$FABLE_DIR/pending/$slug.$(now).$$"
  { printf 'brief: %s\nhash: %s\nroot: %s\nallowed: %s\n' "$p" "$h" "$root" "$(now)" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$rec"; } 2>/dev/null \
    || { rm -f "$tmp"; die "can't write $rec: not authorized"; }
  fable_log allow "$brief" "$h" - "typed at $(tty </dev/tty 2>/dev/null || echo a terminal)" \
    || { rm -f "$rec"; die "can't write the audit log $FABLE_DIR/audit.log: not authorized"; }
  echo "authorized: the next spawn of $brief may run on Fable, once, within $JARVIS_FABLE_TTL_MIN min"
}

fable_revoke() {
  local brief="${1:-}" p f n=0
  [ -f "$brief" ] || die "usage: jarvis fable revoke <handoffs/briefs/file.md>"
  p=$(phys_path "$brief")
  for f in "$FABLE_DIR"/pending/*; do
    [ -f "$f" ] && [ "$(rec_get "$f" brief)" = "$p" ] || continue
    rm -f "$f" && n=$((n + 1)) && fable_log revoke "$brief" "$(rec_get "$f" hash)" - "jarvis fable revoke"
  done
  echo "revoked $n pending authorization(s) for $brief"
}

fable_list() {
  local f t ttl=$JARVIS_FABLE_TTL_MIN left any=0
  case "$ttl" in ""|*[!0-9]*) ttl=0 ;; esac
  echo "pending (in $FABLE_DIR):"
  for f in "$FABLE_DIR"/pending/*; do
    [ -f "$f" ] || continue
    any=1
    t=$(rec_get "$f" allowed)
    case "$t" in ""|*[!0-9]*) t=0 ;; esac
    left=$(( (t + ttl * 60 - $(now)) / 60 ))
    printf '  %s · %s · %s\n' "$(rec_get "$f" brief)" "$(rec_get "$f" root)" \
      "$(if [ "$left" -gt 0 ]; then echo "usable for $left more min"; else echo EXPIRED; fi)"
  done
  [ $any = 1 ] || echo "  none"
  echo "used (latest 10):"
  # shellcheck disable=SC2012
  ls -t "$FABLE_DIR"/used/ 2>/dev/null | head -n 10 | while read -r f; do
    f="$FABLE_DIR/used/$f"
    printf '  %s · run %s · %s\n' "$(rec_get "$f" brief)" "$(rec_get "$f" run)" \
      "$(if grep -q '^launched:' "$f"; then echo launched; else echo "used up, not launched"; fi)"
  done
  echo "log (latest 10):"
  tail -n 10 "$FABLE_DIR/audit.log" 2>/dev/null | sed 's/^/  /' || true
}

backstop_files() { # the user-level settings Claude Code reads for workers: the config dir's, and Superset's default account's when it sets one
  local d
  echo "$CLAUDE_DIR/settings.json"
  d=$(cat "${SUPERSET_HOME_DIR:-$HOME/.superset}/state/default-claude-config-dir" 2>/dev/null)
  [ -n "$d" ] && [ "$d/settings.json" != "$CLAUDE_DIR/settings.json" ] && echo "$d/settings.json"
  return 0
}

backstop_on() { # $1 = settings file: its availableModels is a non-empty list without Fable
  have jq && [ -f "$1" ] && jq -e '(.availableModels | type == "array" and length > 0)
    and ((.availableModels | map(tostring | ascii_downcase | test("fable")) | any) | not)' "$1" >/dev/null 2>&1
}

fable_status() { # `jarvis status`: one line, plus one per settings file here that re-opens Fable
  local f off=0
  if have jq; then
    while IFS= read -r f; do [ -n "$f" ] && { backstop_on "$f" || off=1; }; done <<EOF
$(backstop_files)
EOF
    if [ $off = 0 ]; then echo "fable: blocked (backstop on)"; else echo "fable: backstop off — handoffs/bin/jarvis fable backstop --apply"; fi
  else
    echo "fable: backstop not checked (no jq); spawn refuses Fable without your authorization anyway"
  fi
  fable_holes | while read -r f; do echo "fable: $f lists fable in availableModels, which re-opens it in this checkout — take it out"; done
}

fable_backstop() {
  local apply=0 f tmp bak mode
  case "${1:-}" in "") ;; --apply) apply=1 ;; *) die "usage: jarvis fable backstop [--apply]" ;; esac
  have jq || die "jq is needed to read and write settings.json"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if backstop_on "$f"; then echo "on: $f has availableModels $(jq -c .availableModels "$f") — Fable is blocked"; continue; fi
    if [ $apply = 0 ]; then
      if [ -f "$f" ]; then echo "off: $f has availableModels $(jq -c '.availableModels // "(none)"' "$f" 2>/dev/null || echo '(unreadable)')"
      else echo "off: $f doesn't exist"; fi
      echo "  apply: handoffs/bin/jarvis fable backstop --apply (it lists $FABLE_ALLOWED; Claude Code then runs the default model instead of Fable)"
      continue
    fi
    if [ -f "$f" ]; then
      jq empty "$f" 2>/dev/null || die "$f isn't valid JSON: left as it is"
      bak="$f.bak-jarvis-$(date +%Y%m%d%H%M%S)"
      cp -p "$f" "$bak" || die "can't back $f up to $bak: left as it is"
    else
      mkdir -p "$(dirname "$f")" || die "can't create $(dirname "$f")"
      bak=""
    fi
    tmp=$(mktemp "$f.jarvis.XXXXXX") || die "can't write beside $f"
    # keep a list the user already narrowed, minus Fable; else the default list
    { if [ -f "$f" ]; then cat "$f"; else echo '{}'; fi; } | jq --argjson a "$FABLE_ALLOWED" '
      ((.availableModels // []) | if type == "array" then map(select(tostring | ascii_downcase | test("fable") | not)) else [] end) as $k
      | .availableModels = (if ($k | length) > 0 then $k else $a end)' > "$tmp" || { rm -f "$tmp"; die "jq failed: $f left as it is"; }
    if [ -f "$f" ]; then mode=$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null); [ -n "$mode" ] && chmod "$mode" "$tmp"; fi
    mv "$tmp" "$f" || { rm -f "$tmp"; die "can't replace $f"; }
    fable_log backstop - - - "applied to $f"
    echo "applied: $f availableModels $(jq -c .availableModels "$f")${bak:+ (backup: $bak)}"
  done <<EOF
$(backstop_files)
EOF
  fable_holes | while read -r f; do echo "but: $f lists fable in availableModels, which re-opens it in this checkout — take it out"; done
}

# ---------------------------------------------------------------- hooks

# UserPromptSubmit, Jarvis's terminal only: after a long idle the prompt cache has
# expired, and the next turn would write the whole context again. Stop the prompt
# once and suggest /clear; sending it again goes through.
hook_prompt() {
  local in sid tp prompt me last gap ctx model price usd marker
  have jq || exit 0
  in=$(cat)
  me=""
  [ -n "$HOST" ] && type "${HOST}_self" >/dev/null 2>&1 && me=$("${HOST}_self")
  sid=$(printf '%s' "$in" | jq -r '.session_id // empty')
  # every terminal: which Claude sessions ran in it, so `jarvis leftovers` can
  # tell what a worker started even after it ran /clear (tmux pane ids are %N)
  case "$me$sid" in
    *[!A-Za-z0-9_%-]*) ;;
    *) if [ -n "$me" ] && [ -n "$sid" ] && ! grep -qxF "$sid" "$STATE/sessions/$me" 2>/dev/null; then
         mkdir -p "$STATE/sessions" && echo "$sid" >> "$STATE/sessions/$me"
       fi ;;
  esac
  [ -n "$me" ] && [ "$me" = "$(jarvis_terminal)" ] || exit 0
  tp=$(printf '%s' "$in" | jq -r '.transcript_path // empty')
  prompt=$(printf '%s' "$in" | jq -r '.prompt // empty')
  [ -n "$sid" ] && [ -f "$tp" ] || exit 0
  mkdir -p "$STATE"
  # the watcher reads this to tell how long Jarvis has been idle
  jq -n --arg t "$me" --arg s "$sid" --arg p "$tp" --argjson ts "$(now)" \
    '{terminal: $t, session_id: $s, transcript_path: $p, ts: $ts}' > "$STATE/session.json"
  case "$prompt" in /*) exit 0 ;; esac

  last=$(tail -n 400 "$tp" | jq -c 'select(.type == "assistant" and .message.usage) |
      {t: .timestamp, m: .message.model, u: .message.usage}' 2>/dev/null | tail -n 1)
  [ -n "$last" ] || exit 0
  gap=$(printf '%s' "$last" | jq -r --argjson now "$(now)" \
    '(.t | sub("\\.[0-9]+"; "") | fromdateiso8601) as $t | (($now - $t) / 60 | floor)' 2>/dev/null) || exit 0
  ctx=$(printf '%s' "$last" | jq -r '.u | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)')
  model=$(printf '%s' "$last" | jq -r '.m // ""')
  [ "$gap" -ge "$JARVIS_IDLE_MIN" ] && [ "$ctx" -ge "$JARVIS_GUARD_TOKENS" ] || exit 0

  marker="$STATE/guard-$sid"
  if [ -f "$marker" ] && [ $(( $(now) - $(mtime "$marker") )) -lt 900 ]; then rm -f "$marker"; exit 0; fi
  touch "$marker"
  case "$model" in
    *fable*) price=20 ;; *opus-5-5*) price=8 ;; *opus*) price=10 ;; *sonnet*) price=4 ;; *haiku*) price=2 ;; *) price=10 ;;
  esac
  usd=$(awk -v t="$ctx" -v p="$price" 'BEGIN{printf "%.2f", t * p / 1000000}')
  jq -n --arg r "Jarvis has been idle ${gap} min, so its prompt cache has expired: this message would write all $((ctx / 1000))k tokens of context again (about \$${usd} at API prices). Cheaper: /clear, then \"resume\" — Jarvis reloads from handoffs/OPEN.md. To go ahead anyway, send your message again." \
    '{decision: "block", reason: $r}'
}

# PreToolUse, every session in the checkout: deny an Agent/Task call whose model is
# Fable, and an Edit/Write/MultiEdit after which a settings file lets Fable in: in
# availableModels (that re-opens it: allowlists merge), modelOverrides, or an alias
# variable in env. A settings file is rebuilt as the edit would leave it and parsed by
# jq, which decodes \u escapes, so neither escapes nor a word split across edits get
# past. The top of this script has already left unless the input names fable or a
# settings*.json file. No jq, or input that doesn't parse: allow, and the backstop
# covers it. Not covered (documented limits; the backstop is what holds there): a Bash
# command writing the file, or an agent definition's model: fable.
hook_pretool() {
  local in tool m f lf d why="" cwd p parent base resolved guarded gd gdl target hops leaf_unresolved
  in=${JARVIS_HOOK_IN:-}
  have jq || exit 0
  tool=$(printf '%s' "$in" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
  case "$tool" in
    Agent|Task)
      m=$(printf '%s' "$in" | jq -r '.tool_input.model // empty' 2>/dev/null)
      case "$(printf '%s' "$m" | tr '[:upper:]' '[:lower:]')" in
        *fable*) why="Fable is off for subagents here: use model: \"sonnet\" (or leave model out; subagents default to Sonnet)" ;;
      esac ;;
    Edit|Write|MultiEdit)
      f=$(printf '%s' "$in" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
      cwd=$(printf '%s' "$in" | jq -r '.cwd // empty' 2>/dev/null)
      [ -n "$cwd" ] || cwd=$JARVIS_CALLER_PWD
      case "$f" in /*) p=$f ;; *) p=$cwd/$f ;; esac
      # First collapse repeated slashes and dot segments lexically. Then, when the
      # parent exists, resolve it physically so a symlinked directory cannot hide a
      # guarded settings file. Resolve an existing symlink leaf too; its own name may
      # be harmless while its target is settings.json. The leaf need not exist yet
      # (Write commonly creates it).
      p=$(printf '%s\n' "$p" | awk -F/ '{
        n = 0
        for (i = 1; i <= NF; i++) {
          if ($i == "" || $i == ".") continue
          if ($i == "..") { if (n > 0) n--; continue }
          a[++n] = $i
        }
        out = "/"
        for (i = 1; i <= n; i++) out = out (i > 1 ? "/" : "") a[i]
        print out
      }')
      parent=$(dirname "$p"); base=$(basename "$p"); resolved=0
      if [ -d "$parent" ]; then
        p=$(cd "$parent" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$base") && resolved=1
      fi
      leaf_unresolved=0
      if [ -L "$p" ]; then
        hops=0
        while [ -L "$p" ] && [ "$hops" -lt 10 ]; do
          target=$(readlink "$p" 2>/dev/null) || { leaf_unresolved=1; break; }
          case "$target" in /*) p=$target ;; *) p=$(dirname "$p")/$target ;; esac
          p=$(printf '%s\n' "$p" | awk -F/ '{
            n = 0
            for (i = 1; i <= NF; i++) {
              if ($i == "" || $i == ".") continue
              if ($i == "..") { if (n > 0) n--; continue }
              a[++n] = $i
            }
            out = "/"
            for (i = 1; i <= n; i++) out = out (i > 1 ? "/" : "") a[i]
            print out
          }')
          parent=$(dirname "$p"); base=$(basename "$p")
          if [ -d "$parent" ]; then
            p=$(cd "$parent" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$base") || { leaf_unresolved=1; break; }
          else
            leaf_unresolved=1; break
          fi
          hops=$((hops + 1))
        done
        [ $leaf_unresolved = 1 ] || { [ ! -L "$p" ] && [ -e "$p" ]; } || leaf_unresolved=1
        [ $leaf_unresolved = 0 ] || resolved=0
      fi
      lf=$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')
      base=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
      case "$base" in settings*.json) ;; *) [ $leaf_unresolved = 1 ] || exit 0 ;; esac

      # Compare canonical directories case-blind (macOS paths are case-insensitive).
      # These are any .claude directory, plus the checkout and user-level settings
      # dirs explicitly (the latter need not themselves be named .claude).
      guarded=0; d=$(dirname "$lf")
      [ "$(basename "$d")" = .claude ] && guarded=1
      while IFS= read -r gd; do
        [ -n "$gd" ] || continue
        if [ -d "$gd" ]; then gd=$(cd "$gd" 2>/dev/null && pwd -P) || continue
        else
          gd=$(printf '%s\n' "$gd" | awk -F/ '{
            n = 0
            for (i = 1; i <= NF; i++) {
              if ($i == "" || $i == ".") continue
              if ($i == "..") { if (n > 0) n--; continue }
              a[++n] = $i
            }
            out = "/"
            for (i = 1; i <= n; i++) out = out (i > 1 ? "/" : "") a[i]
            print out
          }')
        fi
        gdl=$(printf '%s' "$gd" | tr '[:upper:]' '[:lower:]')
        [ "$d" = "$gdl" ] && { guarded=1; break; }
      done <<EOF
$ROOTP/.claude
$(backstop_files | while IFS= read -r gd; do dirname "$gd"; done)
EOF
      # If the parent cannot be resolved, a settings*.json basename still gets the
      # full content check. Failing open here would recreate the path differential.
      [ $guarded = 1 ] || [ $resolved = 0 ] || exit 0
      # the file as it would be after the edit; text that isn't JSON counts if it names fable
      m=$(printf '%s' "$in" | jq -r --arg cur "$(cat "$p" 2>/dev/null)" --arg vars " $FABLE_REMAP_VARS " '
        def rep($s; $o; $n; $all): ($s | split($o)) as $p
          | if ($p | length) < 2 then $s elif $all then $p | join($n) else $p[0] + $n + ($p[1:] | join($o)) end;
        .tool_input as $t
        | (if .tool_name == "Write" then ($t.content // "")
           elif .tool_name == "Edit" then rep($cur; $t.old_string // ""; $t.new_string // ""; $t.replace_all // false)
           else reduce ($t.edits // [])[] as $e ($cur; rep(.; $e.old_string // ""; $e.new_string // ""; $e.replace_all // false)) end) as $new
        | ($new | try fromjson catch null) as $j
        | def fab: tostring | ascii_downcase | test("fable");
          if ($j | type) == "object" then
            (($j.availableModels // []) | if type == "array" then map(fab) | any else fab end)
            or (($j.modelOverrides // {}) | fab)
            or (($j.env // {}) | if type == "object" then to_entries | map(select(.key as $k | $vars | index(" " + $k + " ")) | .value | fab) | any else false end)
          else ($new | ascii_downcase | test("fable")) end' 2>/dev/null)
      [ "$m" = true ] && why="After this edit $f lets Fable in (availableModels, modelOverrides or a model alias in env). Allowlists merge across settings files, so that re-opens Fable for every session that reads it. Leave it out: only the user authorizes Fable, one brief at a time (handoffs/bin/jarvis fable allow)."
      m=$f ;;
    *) exit 0 ;;
  esac
  [ -n "$why" ] || exit 0
  fable_log deny - - "$(printf '%s' "$in" | jq -r '.session_id // "-"' 2>/dev/null)" "hook: $tool ${m:--}"
  jq -n --arg r "$why" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
}

# Statusline tap: Claude Code hands the statusline its rate-limit numbers. Save
# them for `jarvis band`, then run the user's own statusline unchanged.
cmd_statusline() {
  local in cmd line
  in=$(cat)
  if have jq; then
    line=$(printf '%s' "$in" | jq -c --argjson ts "$(now)" 'select(.rate_limits.five_hour) | .rate_limits + {ts: $ts}' 2>/dev/null)
    if [ -n "$line" ]; then
      # the machine-wide reading `band` uses, its history, and this repo's own copy (`jarvis usage`)
      (umask 077; mkdir -p "$JHOME") 2>/dev/null && usage_save "$JHOME" "$line" && usage_hist "$line"
      mkdir -p "$STATE" 2>/dev/null && usage_save "$STATE" "$line"
    fi
    cmd="${JARVIS_STATUSLINE_CMD:-$(jq -r '.statusLine.command // empty' "$HOME/.claude/settings.json" 2>/dev/null)}"
  else
    cmd="${JARVIS_STATUSLINE_CMD:-}"
  fi
  case "$cmd" in *"jarvis statusline"*) cmd="" ;; esac
  if [ -n "$cmd" ]; then printf '%s' "$in" | sh -c "$cmd"
  elif have jq; then printf '%s' "$in" | jq -r '"\(.model.display_name // "") · 5h \(.rate_limits.five_hour.used_percentage // "?" | tostring | .[0:4])%"'
  fi
}

usage_save() { # $1 = dir, $2 = the reading: written to a temp file beside usage.json, then moved
  local tmp="$1/usage.json.$$"
  printf '%s\n' "$2" > "$tmp" 2>/dev/null && mv "$tmp" "$1/usage.json" || { rm -f "$tmp"; return 1; }
}

# One "<ts> <five_hour %> <seven_day %> <five_hour resets_at>" line per minute at most,
# the last 500 kept: the burn rate `band` reads.
usage_hist() { # $1 = the reading
  local h="$JHOME/usage.hist" l t
  l=$(printf '%s' "$1" | jq -r '"\(.ts) \(.five_hour.used_percentage // "-") \(.seven_day.used_percentage // "-") \(.five_hour.resets_at // "-")"' 2>/dev/null) || return 0
  t=$(tail -n 1 "$h" 2>/dev/null | awk '{print $1}')
  case "$t" in ""|*[!0-9]*) t=0 ;; esac
  [ $(( ${l%% *} - t )) -ge 60 ] || return 0
  printf '%s\n' "$l" >> "$h"
  [ "$(wc -l < "$h")" -gt 500 ] && tail -n 500 "$h" > "$h.$$" && mv "$h.$$" "$h"
  return 0
}

# ---------------------------------------------------------------- usage

cmd_usage() {
  local audit since_arg json merged over r
  have python3 || die "python3 is needed for jarvis usage"
  have jq || die "jq is needed for jarvis usage"
  audit="$(cd "$(dirname "$0")" && pwd)/cc_usage_audit.py"
  [ -f "$audit" ] || die "no $audit — re-run jarvis:setup"
  set -- --project="$PROJ" --repo-root="$ROOT" --usage-file="$STATE/usage.json" --top=5 \
    --role worker='^You are a Jarvis worker' \
    --role-tool orchestrator='superset agents create|ultron agent spawn|handoffs/bin/jarvis (start|status|spawn|merge|send|read|close)' \
    --bash-category coordination='terminals (read|send|list|close)|term (read|send|list|close)|chat send|tmux |handoffs/|OPEN\.md|jev\.sh|bin/jarvis' \
    "$@"
  json=$(python3 "$audit" "$@" --json) || exit 1
  since_arg=$(printf '%s' "$json" | jq -r '.period[0]')
  merged=$(git log --since="$since_arg" --diff-filter=A --name-only --format= -- "$H/merged/*.md" 2>/dev/null | grep -c '\.md$')
  # this checkout's runs that reached a budget (spawn epoch, paused or not), from the run registry
  over=$(for r in "$RUNS"/*; do
    [ -f "$r" ] && r=${r##*/} && [ -n "$(run_get "$r" budget)$(run_get "$r" budget_was)" ] || continue
    printf '{"t":%s,"p":%s}\n' "$(run_get "$r" spawned | grep -Ex '[0-9]+' || echo 0)" "$([ -n "$(run_get "$r" paused)" ] && echo true || echo false)"
  done | jq -s -c . 2>/dev/null)
  printf '%s' "$json" | jq -r --argjson merged "$merged" --argjson over "${over:-[]}" '
    def usd: "$" + ((. * 100 | round) / 100 | tostring);
    def age:
      if . < 3600 then ((. / 60 | floor | tostring) + "m")
      else ((. / 3600 | floor | tostring) + "h" + (((. % 3600) / 60 | floor) | tostring) + "m") end;
    def role(r): [.by_role | to_entries[] | select(.key == r or .key == (r + " > subagents")) | .value.usd] | add // 0;
    (role("orchestrator")) as $coord | (role("worker")) as $build
    | (if has("machine_peak_concurrent_sessions_10min") then "all projects" else "this repo" end) as $scope
    | (if $scope == "all projects" then ([.briefs[] | select(.outcome == "merged")] | length) else $merged end) as $merged_count
    | "jarvis usage · \(.period[0][0:16]) → \(.period[1][0:16])",
      "API-equivalent estimate at list prices (not your subscription usage): \(.total_usd | usd) in \($scope)",
      (if .subscription_usage then
         "subscription usage: 5h \(.subscription_usage.five_hour_pct // "?")% · 7d \(.subscription_usage.seven_day_pct // "?")% · reading \(.subscription_usage.age_seconds | age) old"
       else "subscription usage: no reading — check /usage" end),
      "",
      "  coordinating (Jarvis + its subagents): \($coord | usd)",
      "  building (workers + their subagents):  \($build | usd)",
      "  coordinating ÷ building: \(if $build > 0 then ($coord / $build * 100 | round) / 100 else "n/a" end)   (target ≤ 0.3)",
      "  merged handoffs: \($merged_count) · cost per merged handoff: \(if $merged_count > 0 then (($coord + $build) / $merged_count) | usd else "n/a" end)",
      "  worst 5-hour window: \(.peak_window_usd | usd) · most sessions in one 10-min slot: \(.peak_concurrent_sessions_10min)",
      (if has("machine_peak_concurrent_sessions_10min") then "  machine-wide peak across all projects: \(.machine_peak_concurrent_sessions_10min) sessions / 10 min" else empty end),
      "  cache reloads after idle (Jarvis): \([.reloads[] | select(.role == "orchestrator" and .cause == "after idle")] | "\(map(.turns) | add // 0) turns, \(map(.usd) | add // 0 | usd)")",
      "",
      "  Workers (top 5 by API-equivalent cost):",
      (.workers[:5][]? | "    \(.brief) · \(.model) · \(.turns) turns · \(.usd | usd) · context \((.start_ctx / 1000) | round)k→\((.peak_ctx / 1000) | round)k · \((.wall_seconds / 60) | round)m · \(.outcome)"),
      "  Most expensive briefs:",
      (.top_briefs[]? | "    \(.brief) · \(.sessions) attempt\(if .sessions == 1 then "" else "s" end) · \(.usd | usd) · \(.outcome)"),
      "",
      "  Waste signals:",
      "    abandoned: \(.abandoned.sessions) sessions · \(.abandoned.usd | usd)",
      "    repeated attempts: \(.repeated_attempts.briefs) briefs · \(.repeated_attempts.extra_sessions) extra sessions · \(.repeated_attempts.extra_usd | usd) extra",
      ((.period[0] | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601? // 0) as $t0 | [$over[] | select(.t >= $t0)]
        | "    over budget (this repo): \(length) run\(if length == 1 then "" else "s" end) asked for a partial handoff · \([.[] | select(.p)] | length) paused"),
      "    failed test runs (workers with 3+): \(if (.failed_test_runs | length) == 0 then "none" else [.failed_test_runs[] | "\(.brief) \(.count)"] | join(", ") end)",
      "    stale open >8h and idle >1h: \(if (.stale_open_sessions | length) == 0 then "none" else [.stale_open_sessions[].name] | join(", ") end)",
      "    worker cost above 150k context: \((.context_growth.worker_usd_above_150k_share * 100) | round)% · peak p50 \(((.context_growth.peak_ctx_p50 // 0) / 1000) | round)k · p90 \(((.context_growth.peak_ctx_p90 // 0) / 1000) | round)k",
      "",
      "  Jarvis by model (for comparing coordinator configs):",
      ([.by_role_model[]? | select(.role == "orchestrator")] | sort_by(-.usd)[]
        | "    \(.model): \(.turns) turns · \(.usd | usd) · $\((.usd / .turns * 1000 | round) / 1000)/turn · avg ctx \((.ctx / .turns / 1000) | round)k")'
}

# ---------------------------------------------------------------- lock

# Three workers each ran a repo's Docker test suite at once and the Docker VM sat at
# 264% CPU: no worker can know about another's heavy command. A repo wraps its heavy
# scripts instead ("test:docker": "handoffs/bin/jarvis lock docker -- vitest run
# --project docker"), so every caller (any agent, the human, CI) queues for the same
# lease, shared by every process on the machine. A class is JARVIS_LOCK_<class>=
# "<scope> <capacity>", scope host (machine-wide) or checkout (this checkout only).
# The lease is a kernel flock held by the command and everything it starts, so it
# ends exactly when the last of them does; bin/jarvis-lock.pl has the details. No
# flag skips it. Needs only perl (macOS ships it; there is no flock(1) here) and
# works with no OPEN.md, outside any host. Exit 75 when --wait runs out, 2 for a
# usage or class error, else the command's own status (128+signal when signalled).

lock_die() { echo "jarvis lock: $*" >&2; exit 2; }

lock_spec() { # $1 = class: its "<scope> <capacity>" from jarvis.conf, else the built-in
  local v
  eval "v=\${JARVIS_LOCK_$1:-}"
  [ -n "$v" ] || case "$1" in
    docker) v="host 1" ;;    # one Docker suite on the whole machine
    suite) v="checkout 1" ;; # one full test suite per checkout
  esac
  printf '%s' "$v"
}

lock_pl() { # the lease helper beside this script, wherever it was called from
  local d
  d=$(dirname "$0")
  case "$d" in /*) ;; *) d="$JARVIS_CALLER_PWD/$d" ;; esac
  [ -f "$d/jarvis-lock.pl" ] || lock_die "no $d/jarvis-lock.pl — re-run jarvis:setup (the command was not run)"
  printf '%s/jarvis-lock.pl' "$d"
}

cmd_lock() {
  local class="${1:-}" wait="${JARVIS_LOCK_WAIT:-3600}" reuse=0 spec scope cap extra pl
  local usage="usage: jarvis lock <class> [--wait <sec>] [--reuse] -- <command…>"
  case "$class" in ""|-*) lock_die "$usage" ;; esac
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait) [ $# -ge 2 ] || lock_die "--wait needs seconds. $usage"; wait=$2; shift 2 ;;
      --reuse) reuse=1; shift ;;
      --) shift; break ;;
      -*) lock_die "unknown option $1. $usage" ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || lock_die "no command to run. $usage"
  case "$wait" in ""|*[!0-9]*) lock_die "--wait takes whole seconds, not '$wait'" ;; esac
  case "$class" in *[!a-z0-9_]*) lock_die "class names are a-z, 0-9 and _, not '$class'" ;; esac
  spec=$(lock_spec "$class")
  [ -n "$spec" ] || lock_die "no lock class '$class'. Add one to $H/jarvis.conf, e.g. JARVIS_LOCK_$class=\"host 1\" (host = machine-wide, checkout = this checkout only; then how many at once)"
  read -r scope cap extra <<< "$spec"
  case "$scope $cap $extra" in
    "host "[1-9]*" "|"checkout "[1-9]*" ") case "$cap" in *[!0-9]*) scope="" ;; esac ;;
    *) scope="" ;;
  esac
  [ -n "$scope" ] || lock_die "JARVIS_LOCK_$class=\"$spec\" in $H/jarvis.conf isn't \"<host|checkout> <capacity>\", e.g. JARVIS_LOCK_$class=\"host 1\""
  if ! have perl; then
    # a CI runner has no other agents to queue behind, and minimal images have no perl
    case "${CI:-}" in ""|0|false) ;; *)
      echo "jarvis lock $class: no perl on this CI runner (CI=$CI), so running without the lease" >&2
      cd "$JARVIS_CALLER_PWD" && exec "$@" ;;
    esac
    lock_die "needs perl for the kernel lock, and there's none on PATH; install perl (the command was not run)"
  fi
  pl=$(lock_pl) || exit 2
  JARVIS_CALLER_PWD="$JARVIS_CALLER_PWD" JARVIS_LOCK_DIR="${JARVIS_LOCK_DIR:-$HOME/.jarvis/locks}" \
    JARVIS_LOCK_POLL="${JARVIS_LOCK_POLL:-1}" JARVIS_REUSE_MAX_AGE="${JARVIS_REUSE_MAX_AGE:-7200}" \
    JARVIS_REUSE_ENV="${JARVIS_REUSE_ENV:-}" \
    exec perl "$pl" run "$class" "$scope" "$cap" "$ROOT" "$wait" "$reuse" "$@"
}

cmd_resources() {
  local pl
  case "${1:-}" in ""|--json) ;; *) lock_die "usage: jarvis resources [--json]" ;; esac
  have perl || lock_die "needs perl"
  pl=$(lock_pl) || exit 2
  JARVIS_LOCK_DIR="${JARVIS_LOCK_DIR:-$HOME/.jarvis/locks}" JARVIS_REUSE_MAX_AGE="${JARVIS_REUSE_MAX_AGE:-7200}" \
    exec perl "$pl" resources "$@"
}

# ---------------------------------------------------------------- main

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start) cmd_start "$@" ;;
  status) cmd_status ;;
  sessions) cmd_sessions ;;
  _claim) cap_claim "$@" ;; # spawn's cap check, run by jarvis-lock.pl under the spawn lease
  band) cmd_band ;;
  spawn) cmd_spawn "$@" ;;
  read) cmd_read "$@" ;;
  send) cmd_send "$@" ;;
  close) cmd_close "$@" ;;
  budget) cmd_budget "$@" ;;
  merge) cmd_merge "$@" ;;
  leftovers) cmd_leftovers "$@" ;;
  lock) cmd_lock "$@" ;;
  resources) cmd_resources "$@" ;;
  doctor) cmd_doctor "$@" ;;
  watch) cmd_watch "$@" ;;
  usage) cmd_usage "$@" ;;
  statusline) cmd_statusline ;;
  fable) cmd_fable "$@" ;;
  hook)
    case "${1:-}" in
      prompt) hook_prompt ;;
      pretool) hook_pretool ;;
      *) exit 0 ;;
    esac ;;
  *) awk 'NR > 1 && !/^#/ {exit} NR > 1 {sub(/^# ?/, ""); print}' "$0"; exit 2 ;;
esac
